sub fatal {
    # Reset $! and $? so that die's exit code is always 255,
    # not a leftover errno from the last syscall.
    $! = 0;
    $? = 0;
    die "nacre: @_\n";
}

# Parse human-readable byte sizes: 50M, 1G, 1024, -1
# Returns integer bytes, or -1 for "unlimited".
sub parse_size {
    my ($s) = @_;
    return undef unless defined $s;
    $s =~ s/^\s+|\s+$//g;
    return -1 if $s eq '-1';
    if ($s =~ /^(-?\d+)$/i) {
        return int($1);
    } elsif ($s =~ /^(\d+(?:\.\d+)?)\s*([kmgtpe])b?$/i) {
        my ($n, $u) = ($1, lc $2);
        my %mult = (k => 1024, m => 1024**2, g => 1024**3,
                     t => 1024**4, p => 1024**5, e => 1024**6);
        return int($n * ($mult{$u} // 1));
    }
    fatal("invalid size: '$s'");
}

sub write_file {
    my ($path, $content) = @_;
    open my $fh, '>', $path or fatal("write $path: $!");
    print $fh $content;
    close $fh;
}

sub read_file {
    my ($path) = @_;
    open my $fh, '<', $path or return undef;
    local $/;
    my $data = <$fh>;
    close $fh;
    return $data;
}

sub read_file_or_die {
    my ($path) = @_;
    my $data = read_file($path);
    fatal("cannot read $path: $!") unless defined $data;
    return $data;
}

sub write_file_atomic {
    my ($path, $content) = @_;
    my $tmp = "$path.tmp.$$";
    write_file($tmp, $content);
    rename($tmp, $path) or do { unlink $tmp; fatal("rename $tmp -> $path: $!"); };
}

sub ensure_dir {
    my ($path) = @_;
    return if -d $path;
    # Walk up to find the deepest existing ancestor, then mkdir down.
    # This handles setgid bit inheritance: if a parent has the setgid
    # bit set, newly created children inherit it (kernel behavior) and
    # we apply the default mode 0755 | inherited setgid.
    my @todo;
    my $p = $path;
    while ($p ne '' && $p ne '/' && !-d $p) {
        push @todo, $p;
        $p = dirname($p);
    }
    for my $d (reverse @todo) {
        my $parent = dirname($d);
        my @pst = stat($parent);
        my $mode = 0755;
        # Inherit setgid bit from parent (like mkdir(2))
        if (@pst && ($pst[2] & S_ISGID)) {
            $mode |= S_ISGID;
        }
        unless (mkdir $d, $mode) {
            # Retry only if the directory now exists (race or mount appeared)
            next if -d $d;
            log_debug("ensure_dir: mkdir $d failed: $!");
        }
    }
}

sub iso8601_now {
    my @t = gmtime(time);
    return sprintf('%04d-%02d-%02dT%02d:%02d:%02dZ',
        $t[5]+1900, $t[4]+1, $t[3], $t[2], $t[1], $t[0]);
}

# Safe wrapper around syscall() that retries on EINTR.
# CRITICAL: Perl's syscall() inspects SV flags to decide integer-vs-
# pointer — and treats ARRAY elements as strings even when they have IOK.
# Only individually-named scalars on the call stack are treated as integers.
# We must unpack @_ into named lexicals and call syscall() with them
# directly, NOT via an array.  This is a documented Perl quirk (perlfunc):
# "if you want to pass a string pointer, use a named scalar variable".
sub do_syscall {
    my ($a0,$a1,$a2,$a3,$a4,$a5) = map { $_ + 0 } @_;
    my $n = scalar @_;
    my $ret;
    do {
        if    ($n <= 1) { $ret = syscall($a0); }
        elsif ($n == 2) { $ret = syscall($a0,$a1); }
        elsif ($n == 3) { $ret = syscall($a0,$a1,$a2); }
        elsif ($n == 4) { $ret = syscall($a0,$a1,$a2,$a3); }
        elsif ($n == 5) { $ret = syscall($a0,$a1,$a2,$a3,$a4); }
        else            { $ret = syscall($a0,$a1,$a2,$a3,$a4,$a5); }
    } while ($ret == -1 && $! == EINTR);
    return $ret;
}


