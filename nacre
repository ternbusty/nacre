sub _dispatch_events ($root, @) {
    my ($interval, $stats);
    GetOptions('interval|i=s' => \$interval, 'stats' => \$stats);
    my $id = shift @ARGV // fatal("container id required");
    cmd_events(id => $id, root => $root, interval => $interval, stats => $stats);
    return;
}

sub _dispatch_ps ($root, @) {
    my $format;
    GetOptions('format|f=s' => \$format);
    my $id = shift @ARGV // fatal("container id required");
    cmd_ps(id => $id, root => $root, format => $format, ps_args => \@ARGV);
    return;
}

sub _dispatch_spec ($, @) {
    my ($bundle, $force);
    GetOptions('bundle|b=s' => \$bundle, 'force' => \$force);
    cmd_spec(bundle => $bundle, force => $force);
    return;
}

sub main {
    my $root = $DEFAULT_ROOT;
    my $root_explicit = 0;
    my $log_level = 'warn';
    my $log_format = 'text';
    my $debug = 0;
    my $systemd_cgroup = 0;

    # Parse global options (before command)
    Getopt::Long::Configure('pass_through', 'no_auto_abbrev');
    GetOptions(
        'root=s' => sub {$root = $_[1]; $root_explicit = 1;},
        'log=s' => \my $log_file,
        'log-format=s' => \$log_format,
        'debug' => \$debug,
        'systemd-cgroup' => \$systemd_cgroup,
    );

    # Initialize logging subsystem
    setup_logging(
        debug => $debug,
        log_file => $log_file,
        format => $log_format,
    );

    my $command = shift @ARGV // usage();

    log_debug("nacre starting, command=$command root=$root");

    my %known_cmds = map {$_ => 1} qw(version checkpoint restore);
    my %dispatch = (
        create => \&_dispatch_create,
        start => sub {cmd_start(id => (shift @ARGV // fatal("container id required")), root => $root)},
        state => sub {cmd_state(id => (shift @ARGV // fatal("container id required")), root => $root)},
        kill => \&_dispatch_kill,
        delete => \&_dispatch_delete,
        run => \&_dispatch_run,
        list => \&_dispatch_list,
        pause => sub {cmd_pause(id => (shift @ARGV // fatal("container id required")), root => $root)},
        resume => sub {cmd_resume(id => (shift @ARGV // fatal("container id required")), root => $root)},
        exec => \&_dispatch_exec,
        update => \&_dispatch_update,
        events => \&_dispatch_events,
        ps => \&_dispatch_ps,
        spec => \&_dispatch_spec,
        features => \&cmd_features,
    );

    if (   $command !~ /^-/
        && $command ne 'help'
        && grep {$_ eq '-h' || $_ eq '--help'} @ARGV) {
        if ($dispatch{$command} || $known_cmds{$command}) {
            my $n = _binary_name();
            print "NAME:\n   $n $command\n\nUSAGE:\n   $n $command [options]\n";
            exit(0);
        } else {
            print STDERR "No help topic for '$command'\n";
            exit(1);
        }
    }

    if ($command eq '--help' || $command eq '-h' || $command eq 'help') {
        usage();
    } elsif ($command eq '--version' || $command eq '-v' || $command eq 'version') {
        require Config;
        my $n = _binary_name();
        print "$n version 0.2.0\n";    # x-release-please-version
        print "commit: nacre-0.2.0\n";    # x-release-please-version
        print "spec: 1.2.0\n";
        print "go: n/a (perl $Config::Config{archname})\n";    ## no critic (ProhibitPackageVars)
    } elsif (my $handler = $dispatch{$command}) {
        $handler->($root, $root_explicit);
    } else {
        if (@ARGV && ($ARGV[0] eq '-h' || $ARGV[0] eq '--help')) {
            print STDERR "No help topic for '$command'\n";
            exit(1);
        }
        fatal("unknown command: $command");
    }
    return;
}

sub _binary_name {return $ENV{_NACRE_BINARY_NAME} // 'nacre'}

sub usage {
    my $n = _binary_name();
    print <<"USAGE";
NAME:
   $n - Open Container Initiative runtime

USAGE:
   $n [global options] command [command options] [arguments...]

COMMANDS:
     checkpoint  checkpoint a running container (not supported)
     create      create a container
     delete      delete any resources held by the container
     events      display container events such as OOM notifications, cpu, memory, and IO usage statistics
     exec        execute new process inside the container
     kill        kill sends the specified signal to the container's init process
     list        lists containers started by $n with the given root
     pause       pause suspends all processes inside the container
     ps          ps displays the processes running inside a container
     restore     restore a container from a previous checkpoint (not supported)
     resume      resumes all processes that have been previously paused
     run         create and run a container
     spec        create a new specification file
     start       executes the user defined process in a created container
     state       output the state of a container
     update      update container resource constraints
     features    show the enabled features

GLOBAL OPTIONS:
   --debug             enable debug output for logging
   --log value         set the log file path where internal debug information is written
   --log-format value  set the format used by logs ('text' (default), or 'json') (default: "text")
   --root value        root directory for storage of container state (default: "/run/nacre")
   --help, -h          show help
   --version, -v       print the version
USAGE
    exit(0);
}

# Run
try {main()}
catch ($e) {
    my $msg = "$e";
    chomp $msg;

    # Print error to stderr (fatal() already formatted it)
    print STDERR "$msg\n" unless $msg eq '';
    exit 1;
}
