}

sub _dispatch_exec ($root, @) {
    my (
        $exec_cwd, @exec_env, $exec_user, $detach, $pid_file,
        $console_socket, $pidfd_socket, $tty, $process_file, $ignore_paused,
        $preserve_fds, @additional_gids, @cap_add, $exec_cgroup
    );

    my @before;
    my @exec_cmd;
    my $found_sep = 0;
    for my $arg (@ARGV) {
        if ($arg eq '--' && !$found_sep) {
            $found_sep = 1;
            next;
        }
        if ($found_sep) {push @exec_cmd, $arg;}
        else {push @before, $arg;}
    }
    @ARGV = @before;

    Getopt::Long::Configure('require_order');
    GetOptions(
        'cwd=s' => \$exec_cwd,
        'env|e=s' => \@exec_env,
        'user|u=s' => \$exec_user,
        'detach|d' => \$detach,
        'pid-file=s' => \$pid_file,
        'console-socket=s' => \$console_socket,
        'pidfd-socket=s' => \$pidfd_socket,
        'tty|t' => \$tty,
        'process|p=s' => \$process_file,
        'ignore-paused' => \$ignore_paused,
        'preserve-fds=i' => \$preserve_fds,
        'additional-gids=i' => \@additional_gids,
        'cap=s' => \@cap_add,
        'cgroup=s' => \$exec_cgroup,
    );
    Getopt::Long::Configure('permute');
    my $id = shift @ARGV // fatal("container id required");
    @exec_cmd = @ARGV unless @exec_cmd;
    cmd_exec(
        id => $id,
        root => $root,
        command => \@exec_cmd,
        cwd => $exec_cwd,
        env => (@exec_env ? \@exec_env : undef),
        user => $exec_user,
        pid_file => $pid_file,
        preserve_fds => ($preserve_fds // 0),
        additional_gids => (@additional_gids ? \@additional_gids : undef),
        ignore_paused => $ignore_paused,
        process_file => $process_file,
        tty => $tty,
        detach => $detach,
        console_socket => $console_socket,
        pidfd_socket => $pidfd_socket,
        exec_cgroup => $exec_cgroup,
        cap => (@cap_add ? \@cap_add : undef),
    );
    return;
}

