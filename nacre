sub fatal {
    # Reset $! and $? so that die's exit code is always 255,
    # not a leftover errno from the last syscall.
    $! = 0;
    $? = 0;
    die "nacre: @_\n";
}

sub write_file {
    my ($path, $content) = @_;
    open my $fh, '>', $path or fatal("write $path: $!");
    print $fh $content;
    close $fh;
}

sub read_file {
    my ($path) = @_;
    open my $fh, '<', $path or return undef;
    local $/;
    my $data = <$fh>;
    close $fh;
    return $data;
}

sub read_file_or_die {
    my ($path) = @_;
    my $data = read_file($path);
    fatal("cannot read $path: $!") unless defined $data;
    return $data;
}

sub write_file_atomic {
    my ($path, $content) = @_;
    my $tmp = "$path.tmp.$$";
    write_file($tmp, $content);
    rename($tmp, $path) or do { unlink $tmp; fatal("rename $tmp -> $path: $!"); };
}

sub ensure_dir {
    my ($path) = @_;
    return if -d $path;
    # make_path uses stat() internally, which can fail with EOVERFLOW in
    # user namespaces when the parent directory's owner UID is not mapped.
    # Fall back to simple recursive mkdir on failure.
    eval { make_path($path, { mode => 0o755 }) };
    return if -d $path;
    # Fallback: walk up to find an existing ancestor, then mkdir down
    my @todo;
    my $p = $path;
    while ($p ne '' && $p ne '/' && !-d $p) {
        push @todo, $p;
        $p = dirname($p);
    }
    for my $d (reverse @todo) {
        mkdir $d, 0755;
    }
}

sub iso8601_now {
    my @t = gmtime(time);
    return sprintf('%04d-%02d-%02dT%02d:%02d:%02dZ',
        $t[5]+1900, $t[4]+1, $t[3], $t[2], $t[1], $t[0]);
}

# Safe wrapper around syscall() that retries on EINTR
sub do_syscall {
    my $ret;
    do {
        $ret = syscall(@_);
    } while ($ret == -1 && $! == EINTR);
    return $ret;
}


