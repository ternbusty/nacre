# Container: features
# ═══════════════════════════════════════════════════════════════════════

sub cmd_features {
    my $features = {
        ociVersionMin => '1.0.0',
        ociVersionMax => '1.2.0',
        hooks => [qw(prestart createRuntime createContainer startContainer poststart poststop)],
        mountOptions => [sort (keys %MOUNT_FLAGS, 'idmap', 'ridmap')],
        linux => {
            namespaces => [sort keys %NS_MAP],
            capabilities => [@CAP_NAMES],
            cgroup => {
                v2 => JSON::PP::true,
            },
            seccomp => {
                enabled => JSON::PP::true,
                actions => [
                    qw(SCMP_ACT_KILL SCMP_ACT_KILL_PROCESS SCMP_ACT_TRAP
                        SCMP_ACT_ERRNO SCMP_ACT_NOTIFY SCMP_ACT_LOG SCMP_ACT_ALLOW)
                ],
                operators => [
                    qw(SCMP_CMP_NE SCMP_CMP_LT SCMP_CMP_LE
                        SCMP_CMP_EQ SCMP_CMP_GE SCMP_CMP_GT
                        SCMP_CMP_MASKED_EQ)
                ],
                supportedFlags => [
                    qw(SECCOMP_FILTER_FLAG_TSYNC
                        SECCOMP_FILTER_FLAG_LOG
                        SECCOMP_FILTER_FLAG_SPEC_ALLOW)
                ],
            },
            apparmor => {enabled => JSON::PP::false},
            selinux => {enabled => JSON::PP::false},
        },
        annotations => {
            'org.opencontainers.runtime.nacre' => 'Perl OCI runtime',
        },
    };
    print $JSON->encode($features);
    return;
}

