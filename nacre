sub validate_capabilities {
    # runc-compatible: ignore unknown capabilities silently.
    # (The OCI spec says MUST error, but runc doesn't, and bats tests
    # expect runc behavior.)
    my ($spec) = @_;
    return unless $spec->{process};  # avoid auto-vivifying {process}
    my $caps = $spec->{process}{capabilities} // return;
    for my $set (qw(bounding effective permitted inheritable ambient)) {
        my @known = grep { exists $CAP_NUM{$_} } @{$caps->{$set} // []};
        $caps->{$set} = \@known;
    }
}

sub apply_capabilities_bounding {
    # Phase 1: Drop bounding caps and set KEEPCAPS.
    # Must be called BEFORE setuid/setgid so that KEEPCAPS preserves the
    # permitted set across the UID transition.
    my ($spec) = @_;
    my $caps = $spec->{process}{capabilities} // return;

    # Drop bounding set
    if (my $bounding = $caps->{bounding}) {
        my %keep = map { $_ => 1 } @$bounding;
        for my $name (@CAP_NAMES) {
            next if $keep{$name};
            my $num = $CAP_NUM{$name} // next;
            do_syscall(SYS_prctl, PR_CAPBSET_DROP, $num, 0, 0, 0);
        }
    }

    # Keep caps across setuid (cleared in phase 2)
    do_syscall(SYS_prctl, PR_SET_KEEPCAPS, 1, 0, 0, 0);
}

sub apply_capabilities_final {
    # Phase 2: Set effective/permitted/inheritable/ambient caps.
    # Must be called AFTER setuid/setgid — the kernel cleared the effective
    # set during setuid but preserved permitted (KEEPCAPS was on).
    my ($spec) = @_;
    my $caps = $spec->{process}{capabilities} // return;

    my ($eff_lo, $eff_hi) = (0, 0);
    my ($prm_lo, $prm_hi) = (0, 0);
    my ($inh_lo, $inh_hi) = (0, 0);

    for my $name (@{$caps->{effective} // []}) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $eff_lo |= (1 << $n); } else { $eff_hi |= (1 << ($n - 32)); }
    }
    for my $name (@{$caps->{permitted} // []}) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $prm_lo |= (1 << $n); } else { $prm_hi |= (1 << ($n - 32)); }
    }
    for my $name (@{$caps->{inheritable} // []}) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $inh_lo |= (1 << $n); } else { $inh_hi |= (1 << ($n - 32)); }
    }
    # Do NOT merge ambient caps into inheritable — runc doesn't.
    # Ambient caps that are not in the spec's inheritable set will
    # fail to raise (EPERM) and produce a warning, matching runc.

    # capset: header (version, pid) + data[2] (effective, permitted, inheritable)
    my $hdr = pack('Ii', _LINUX_CAPABILITY_VERSION_3, 0);
    my $data = pack('III III',
        $eff_lo, $prm_lo, $inh_lo,
        $eff_hi, $prm_hi, $inh_hi);
    my $nr_capset = SYS_capset + 0;
    syscall($nr_capset, $hdr, $data);

    # Clear keepcaps
    do_syscall(SYS_prctl, PR_SET_KEEPCAPS, 0, 0, 0, 0);

    # Raise ambient capabilities
    for my $name (@{$caps->{ambient} // []}) {
        my $n = $CAP_NUM{$name} // next;
        my $ret = do_syscall(SYS_prctl, PR_CAP_AMBIENT, PR_CAP_AMBIENT_RAISE, $n, 0, 0);
        if ($ret == -1) {
            warn "nacre: can't raise ambient capability $name: $!\n";
        }
    }
}

# ═══════════════════════════════════════════════════════════════════════
# IPC Channel (socketpair-based)
# ═══════════════════════════════════════════════════════════════════════

sub create_channel {
    socketpair(my $a, my $b, PF_UNIX, SOCK_SEQPACKET, 0)
        or fatal("socketpair: $!");
    return (fileno($a), fileno($b), $a, $b);
}

sub channel_send {
    my ($fd, $msg) = @_;
    my $data = $JSON_COMPACT->encode($msg);
    my $ret = POSIX::write($fd, $data, length($data));
    fatal("channel_send: $!") unless defined $ret && $ret > 0;
}

sub channel_recv {
    my ($fd) = @_;
    my $buf;
    my $ret = POSIX::read($fd, $buf, 65536);
    return undef unless defined $ret && $ret > 0;
    return $JSON_COMPACT->decode($buf);
}

# ═══════════════════════════════════════════════════════════════════════
# Notify Socket (for start command)
# ═══════════════════════════════════════════════════════════════════════

sub create_notify_listener {
    my ($sock_path) = @_;
    unlink $sock_path;
    socket(my $srv, AF_UNIX, SOCK_STREAM, 0) or fatal("socket: $!");
    bind($srv, pack_sockaddr_un($sock_path))  or fatal("bind $sock_path: $!");
    listen($srv, 1)                           or fatal("listen: $!");
    return $srv;
}

sub wait_for_start {
    my ($srv_fh) = @_;
    accept(my $cli, $srv_fh) or fatal("accept on notify socket: $!");
    # Read "start container" message
    my $buf;
    sysread($cli, $buf, 4096);
    close $cli;
    return 1;
}

sub notify_container_start {
    my ($sock_path) = @_;
    socket(my $s, AF_UNIX, SOCK_STREAM, 0) or fatal("socket: $!");
    connect($s, pack_sockaddr_un($sock_path)) or fatal("connect $sock_path: $!");
    syswrite($s, "start container");
    close $s;
}

# ═══════════════════════════════════════════════════════════════════════
# PTY / Console Socket
# ═══════════════════════════════════════════════════════════════════════

# Send a file descriptor over a Unix domain socket using SCM_RIGHTS.
# Optional $payload is sent as the data (instead of a single NUL byte);
# this is used for seccomp notify listener metadata.
sub send_fd_via_socket {
    my ($socket_path, $fd, $payload) = @_;

    socket(my $sock, AF_UNIX, SOCK_STREAM, 0) or fatal("socket: $!");
    connect($sock, pack_sockaddr_un($socket_path))
        or fatal("connect to console socket '$socket_path': $!");

    my $sock_fd = fileno($sock) + 0;

    # iovec: data payload (required for SCM_RIGHTS; at least one byte)
    my $data = (defined $payload && length($payload)) ? $payload : "\x00";
    my $iov = pack('P L!', $data, length($data));

    # cmsg: SOL_SOCKET / SCM_RIGHTS / fd
    my $cmsg_data = pack('i', $fd);
    my $cmsg_len  = 8 + 4 + 4 + length($cmsg_data);   # cmsghdr + data
    my $cmsg = pack('L! i i', $cmsg_len, SOL_SOCKET, SCM_RIGHTS)
             . $cmsg_data;
    my $pad = (8 - (length($cmsg) % 8)) % 8;
    $cmsg .= "\0" x $pad;

    # msghdr (x86_64 / aarch64 LP64 layout — both are 56 bytes)
    my $msghdr = pack('Q',    0)              # msg_name      (NULL)
               . pack('I x4', 0)              # msg_namelen   (0 + pad)
               . pack('P',    $iov)           # msg_iov
               . pack('Q',    1)              # msg_iovlen
               . pack('P',    $cmsg)          # msg_control
               . pack('Q',    length($cmsg))  # msg_controllen
               . pack('I x4', 0);             # msg_flags     (0 + pad)

    my $nr  = SYS_sendmsg + 0;
    my $ret = syscall($nr, $sock_fd, $msghdr, 0);
    $ret >= 0 or fatal("sendmsg (console socket): $!");

    close($sock);
}

# Send a file descriptor over an already-connected socket fd (not a path).
sub send_fd_over_fd {
    my ($sock_fd, $fd) = @_;
    $sock_fd = $sock_fd + 0;
    my $data = "\x00";
    my $iov  = pack('P L!', $data, 1);
    my $cmsg_data = pack('i', $fd);
    my $cmsg_len  = 8 + 4 + 4 + length($cmsg_data);
    my $cmsg = pack('L! i i', $cmsg_len, SOL_SOCKET, SCM_RIGHTS)
             . $cmsg_data;
    my $pad = (8 - (length($cmsg) % 8)) % 8;
    $cmsg .= "\0" x $pad;
    my $msghdr = pack('Q',    0)
               . pack('I x4', 0)
               . pack('P',    $iov)
               . pack('Q',    1)
               . pack('P',    $cmsg)
               . pack('Q',    length($cmsg))
               . pack('I x4', 0);
    my $nr  = SYS_sendmsg + 0;
    my $ret = syscall($nr, $sock_fd, $msghdr, 0);
    return $ret >= 0;
}

# Receive a file descriptor over a socket fd.
sub recv_fd_over_fd {
    my ($sock_fd) = @_;
    $sock_fd = $sock_fd + 0;
    my $data = "\0";
    my $iov  = pack('P L!', $data, 1);
    # Space for one fd in cmsg
    my $cmsg_space = 8 + 4 + 4 + 4;  # cmsghdr + one int
    my $pad = (8 - ($cmsg_space % 8)) % 8;
    $cmsg_space += $pad;
    my $cmsg_buf = "\0" x $cmsg_space;
    my $msghdr = pack('Q',    0)
               . pack('I x4', 0)
               . pack('P',    $iov)
               . pack('Q',    1)
               . pack('P',    $cmsg_buf)
               . pack('Q',    $cmsg_space)
               . pack('I x4', 0);
    my $nr  = SYS_recvmsg + 0;
    my $ret = syscall($nr, $sock_fd, $msghdr, 0);
    return -1 if $ret < 0;
    # Extract fd from cmsg (offset: L! + i + i = 8+4+4 = 16 on LP64)
    my $fd = unpack('i', substr($cmsg_buf, 16, 4));
    return $fd;
}

# Create a PTY pair, send the master to the console socket, return the
# slave file descriptor (as an integer fd number).  Must be called before
# pivot_root so that both /dev/ptmx and the console-socket path are
# reachable on the host filesystem.
sub setup_pty_console {
    my ($console_socket_path) = @_;

    # Open PTY master
    sysopen(my $ptm, '/dev/ptmx', O_RDWR | O_NOCTTY | O_CLOEXEC)
        or fatal("open /dev/ptmx: $!");

    # Get slave number
    my $ptn_buf = pack('i', 0);
    ioctl($ptm, TIOCGPTN, $ptn_buf) or fatal("TIOCGPTN: $!");
    my $ptn = unpack('i', $ptn_buf);

    # Unlock slave
    my $unlock = pack('i', 0);
    ioctl($ptm, TIOCSPTLCK, $unlock) or fatal("TIOCSPTLCK: $!");

    # Open slave (keep it open across pivot_root; we dup2 it to 0/1/2 later)
    my $pts_path = "/dev/pts/$ptn";
    sysopen(my $pts, $pts_path, O_RDWR | O_NOCTTY)
        or fatal("open PTY slave $pts_path: $!");

    # Deliver master to whoever is listening on the console socket
    send_fd_via_socket($console_socket_path, fileno($ptm));

    # Master stays open in the receiver; close our copy
    close($ptm);

    # Dup the slave fd so it survives the $pts filehandle going out of scope.
    # POSIX::dup returns a raw fd number not tied to any Perl handle, so it
    # won't be auto-closed when this sub returns.
    my $dup_fd = POSIX::dup(fileno($pts));
    fatal("dup PTY slave: $!") unless defined $dup_fd && $dup_fd >= 0;
    close($pts);

    return $dup_fd;
}

# Set a PTY fd to raw mode (cfmakeraw equivalent).
# Disables OPOST/ONLCR so \n is not converted to \r\n, ECHO so input
# is not reflected, and line-editing (ICANON) so reads return immediately.
sub pty_set_raw {
    my ($fd) = @_;
    # TCGETS = 0x5401, TCSETS = 0x5402 on Linux x86_64/aarch64
    use constant TCGETS_C => 0x5401;
    use constant TCSETS_C => 0x5402;
    # struct termios: 4 x u32 (c_iflag, c_oflag, c_cflag, c_lflag) + u8 c_line + 19 x u8 c_cc + pad
    # total = 16 + 1 + 19 + pad = 60 bytes on Linux
    my $termios = "\0" x 60;
    if (open my $fh, '+<&', $fd) {
        ioctl($fh, TCGETS_C, $termios) or do { close $fh; return; };
        my ($iflag, $oflag, $cflag, $lflag) = unpack('LLLL', $termios);
        # Clear input flags: IGNBRK, BRKINT, PARMRK, ISTRIP, INLCR, IGNCR, ICRNL, IXON
        $iflag &= ~(0x001 | 0x002 | 0x008 | 0x020 | 0x040 | 0x080 | 0x100 | 0x400);
        # Clear output flags: OPOST
        $oflag &= ~0x001;
        # Clear local flags: ECHO, ECHONL, ICANON, ISIG, IEXTEN
        $lflag &= ~(0x008 | 0x040 | 0x002 | 0x001 | 0x8000);
        # Clear char size, set CS8
        $cflag &= ~0x030;   # ~CSIZE
        $cflag |=  0x030;   # CS8
        # VMIN=1, VTIME=0
        substr($termios, 0, 16, pack('LLLL', $iflag, $oflag, $cflag, $lflag));
        my $cc_offset = 16 + 1;  # after c_line byte
        substr($termios, $cc_offset + 6, 1, pack('C', 1));  # VMIN
        substr($termios, $cc_offset + 5, 1, pack('C', 0));  # VTIME
        ioctl($fh, TCSETS_C, $termios);
        close $fh;
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Process Security
# ═══════════════════════════════════════════════════════════════════════

sub apply_process_security {
    my ($spec) = @_;
    my $proc = $spec->{process} // {};

    # 1. OOM score adj
    if (defined $proc->{oomScoreAdj}) {
        eval { write_file('/proc/self/oom_score_adj', $proc->{oomScoreAdj}); };
    }

    # 2. Umask
    if (defined $proc->{user}{umask}) {
        umask($proc->{user}{umask});
    }

    # 3. No new privileges
    if ($proc->{noNewPrivileges}) {
        do_syscall(SYS_prctl, PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
    }

    # 3b. Rlimits — must be applied BEFORE dropping caps, because
    #     raising hard limits beyond the current value requires
    #     CAP_SYS_RESOURCE (which may not be in the target cap sets).
    apply_rlimits($spec);

    # 3c. Scheduler — must be applied BEFORE dropping caps, because
    #     SCHED_DEADLINE and SCHED_FIFO require CAP_SYS_NICE.
    apply_scheduler($spec);

    # 4. Seccomp (must be applied before dropping caps)
    my $seccomp_notify_fd = apply_seccomp_raw($spec);

    # 5. Capabilities phase 1: drop bounding set + set KEEPCAPS.
    #    KEEPCAPS must be on BEFORE setuid so the kernel preserves the
    #    permitted set across the uid-0 → uid-N transition.
    apply_capabilities_bounding($spec);

    # 6. Set supplementary groups, then gid, then uid.
    #    Must happen AFTER KEEPCAPS is set and BEFORE the final capset.
    if (my $groups = $proc->{user}{additionalGids}) {
        my $nr = SYS_setgroups + 0;
        my $n  = scalar(@$groups) + 0;
        my $pk = pack('L*', @$groups);
        syscall($nr, $n, $pk);
    } else {
        my $nr = SYS_setgroups + 0;
        my $pk = '';
        syscall($nr, 0, $pk);
    }

    my $gid = $proc->{user}{gid} // 0;
    my $uid = $proc->{user}{uid} // 0;
    POSIX::setgid($gid + 0);
    POSIX::setuid($uid + 0);

    # 7. Capabilities phase 2: capset + clear KEEPCAPS + ambient caps.
    #    Now running as the target uid/gid, restore the desired capability
    #    sets.  The kernel cleared effective on setuid but kept permitted
    #    (KEEPCAPS was on); capset re-establishes the spec's desired sets.
    apply_capabilities_final($spec);

    return $seccomp_notify_fd;
}

# ═══════════════════════════════════════════════════════════════════════
# rlimits
# ═══════════════════════════════════════════════════════════════════════

my %RLIMIT_MAP = (
    RLIMIT_AS         => 9,
    RLIMIT_CORE       => 4,
    RLIMIT_CPU        => 0,
    RLIMIT_DATA       => 2,
    RLIMIT_FSIZE      => 1,
    RLIMIT_LOCKS      => 10,
    RLIMIT_MEMLOCK    => 8,
    RLIMIT_MSGQUEUE   => 12,
    RLIMIT_NICE       => 13,
    RLIMIT_NOFILE     => 7,
    RLIMIT_NPROC      => 6,
    RLIMIT_RSS        => 5,
    RLIMIT_RTPRIO     => 14,
    RLIMIT_RTTIME     => 15,
    RLIMIT_SIGPENDING => 11,
    RLIMIT_STACK      => 3,
);

sub validate_rlimits {
    # OCI spec: "The runtime MUST generate an error for any values
    # which cannot be mapped to a relevant kernel interface."
    my ($spec) = @_;
    return unless $spec->{process};  # avoid auto-vivifying {process}
    my $rlimits = $spec->{process}{rlimits} // return;
    for my $rl (@$rlimits) {
        exists $RLIMIT_MAP{$rl->{type}}
            or fatal("unknown rlimit type '$rl->{type}'");
    }
}

sub apply_rlimits {
    my ($spec) = @_;
    my $rlimits = $spec->{process}{rlimits} // return;
    for my $rl (@$rlimits) {
        my $type = $RLIMIT_MAP{$rl->{type}} // next;
        my $soft = $rl->{soft} // 0;
        my $hard = $rl->{hard} // 0;
        # prlimit64(pid=0, resource, new_rlim, old_rlim=NULL)
        my $nr = SYS_prlimit64 + 0;
        my $t  = $type + 0;
        my $new_rlim = pack('QQ', $soft, $hard);
        syscall($nr, 0, $t, $new_rlim, 0);
    }
}

# ═══════════════════════════════════════════════════════════════════════
# IO Priority
# ═══════════════════════════════════════════════════════════════════════

my %IOPRIO_CLASS_MAP = (
    IOPRIO_CLASS_RT   => 1,
    IOPRIO_CLASS_BE   => 2,
    IOPRIO_CLASS_IDLE => 3,
);

sub apply_iopriority {
    my ($spec) = @_;
    my $iop = $spec->{process}{ioPriority} // return;
    my $class = $IOPRIO_CLASS_MAP{$iop->{class} // ''} // return;
    my $prio  = $iop->{priority} // 0;
    # ioprio_set(IOPRIO_WHO_PROCESS=1, pid=0, ioprio)
    # ioprio = (class << 13) | prio
    my $ioprio = ($class << 13) | ($prio & 0x1fff);
    my $nr = SYS_ioprio_set + 0;
    my $who  = 1 + 0;  # IOPRIO_WHO_PROCESS
    my $pid  = 0 + 0;  # self
    my $val  = $ioprio + 0;
    syscall($nr, $who, $pid, $val);
}

# ═══════════════════════════════════════════════════════════════════════
# Scheduler
# ═══════════════════════════════════════════════════════════════════════

my %SCHED_POLICY_MAP = (
    SCHED_OTHER    => 0,
    SCHED_FIFO     => 1,
    SCHED_RR       => 2,
    SCHED_BATCH    => 3,
    SCHED_IDLE     => 5,
    SCHED_DEADLINE => 6,
);

my %SCHED_FLAG_MAP = (
    SCHED_FLAG_RESET_ON_FORK  => 0x01,
    SCHED_FLAG_RECLAIM        => 0x02,
    SCHED_FLAG_DL_OVERRUN     => 0x04,
    SCHED_FLAG_KEEP_POLICY    => 0x08,
    SCHED_FLAG_KEEP_PARAMS    => 0x10,
    SCHED_FLAG_UTIL_CLAMP_MIN => 0x20,
    SCHED_FLAG_UTIL_CLAMP_MAX => 0x40,
);

sub apply_scheduler {
    my ($spec) = @_;
    my $sched = $spec->{process}{scheduler} // return;

    # If CPU affinity is set AND scheduler is DEADLINE, conflict
    my $cpus = $spec->{linux}{resources}{cpu}{cpus} // '';
    if ($cpus ne '' && ($sched->{policy} // '') eq 'SCHED_DEADLINE') {
        fatal("process scheduler can't be used together with AllowedCPUs");
    }

    my $policy = $SCHED_POLICY_MAP{$sched->{policy} // 'SCHED_OTHER'} // 0;
    my $flags = 0;
    for my $f (@{$sched->{flags} // []}) {
        $flags |= ($SCHED_FLAG_MAP{$f} // 0);
    }
    my $nice      = $sched->{nice}     // 0;
    my $priority  = $sched->{priority} // 0;
    my $runtime   = $sched->{runtime}  // 0;
    my $deadline  = $sched->{deadline} // 0;
    my $period    = $sched->{period}   // 0;

    # struct sched_attr (48 bytes):
    #   u32 size, u32 sched_policy, u64 sched_flags, s32 sched_nice,
    #   u32 sched_priority, u64 sched_runtime, u64 sched_deadline, u64 sched_period
    my $attr = pack('LLQlLQQQ',
        48,        # size
        $policy,
        $flags,
        $nice,
        $priority,
        $runtime,
        $deadline,
        $period,
    );
    my $nr = SYS_sched_setattr + 0;
    my $pid_val = 0 + 0;  # self
    my $fl = 0 + 0;
    my $r = syscall($nr, $pid_val, $attr, $fl);
    if ($r == -1) {
        fatal("sched_setattr: $!");
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Memory Policy (set_mempolicy)
# ═══════════════════════════════════════════════════════════════════════

my %MPOL_MODE_MAP = (
    MPOL_DEFAULT    => 0,
    MPOL_PREFERRED  => 1,
    MPOL_BIND       => 2,
    MPOL_INTERLEAVE => 3,
    MPOL_LOCAL      => 4,
);

my %MPOL_FLAG_MAP = (
    MPOL_F_STATIC_NODES   => (1 << 15),
    MPOL_F_RELATIVE_NODES => (1 << 14),
    MPOL_F_NUMA_BALANCING => (1 << 13),
);

sub parse_node_list {
    my ($nodes_str) = @_;
    my @nodes;
    for my $part (split /,/, $nodes_str) {
        $part =~ s/^\s+|\s+$//g;
        next if $part eq '';
        if ($part =~ /^(\d+)-(\d+)$/) {
            my ($lo, $hi) = ($1 + 0, $2 + 0);
            fatal("invalid memory policy node: $part") if $hi > 1024 * 1024;
            push @nodes, $lo .. $hi;
        } elsif ($part =~ /^(\d+)$/) {
            push @nodes, $1 + 0;
        } else {
            fatal("invalid memory policy node: $part");
        }
    }
    return @nodes;
}

sub validate_memory_policy {
    my ($spec) = @_;
    my $mp = $spec->{linux}{memoryPolicy} // return;

    my $mode_str = $mp->{mode} // '';
    if (!defined $mp->{mode} && !keys %{$mp}) {
        fatal("invalid memory policy");
    }
    if (!defined $mp->{mode} || $mode_str eq '') {
        fatal("invalid memory policy mode: (empty)");
    }
    if (!exists $MPOL_MODE_MAP{$mode_str}) {
        fatal("invalid memory policy mode: $mode_str");
    }
    for my $f (@{$mp->{flags} // []}) {
        fatal("invalid memory policy flag: $f")
            unless exists $MPOL_FLAG_MAP{$f};
    }
    my $nodes_str = $mp->{nodes} // '';
    my @nodes = $nodes_str ne '' ? parse_node_list($nodes_str) : ();
    if ($mode_str eq 'MPOL_DEFAULT' && @nodes > 0) {
        fatal("set_mempolicy: mode requires 0 nodes but got " . scalar(@nodes));
    }
}

sub apply_memory_policy {
    my ($spec) = @_;
    my $mp = $spec->{linux}{memoryPolicy} // return;

    my $mode_str = $mp->{mode} // '';
    if ($mode_str eq '' || !exists $MPOL_MODE_MAP{$mode_str}) {
        return;  # validation already done
    }
    my $mode = $MPOL_MODE_MAP{$mode_str};

    # Parse flags
    my $flags = 0;
    for my $f (@{$mp->{flags} // []}) {
        $flags |= ($MPOL_FLAG_MAP{$f} // 0);
    }
    $mode |= $flags;

    # Parse nodes
    my $nodes_str = $mp->{nodes} // '';
    my @nodes = $nodes_str ne '' ? parse_node_list($nodes_str) : ();

    # Build nodemask bitmask
    my $maxnode = 0;
    my @mask;
    if (@nodes) {
        $maxnode = (sort { $b <=> $a } @nodes)[0] + 1;
        # Round maxnode up to multiple of 64 for kernel alignment
        my $mask_longs = int(($maxnode + 63) / 64);
        @mask = (0) x $mask_longs;
        for my $n (@nodes) {
            my $idx = int($n / 64);
            my $bit = $n % 64;
            $mask[$idx] |= (1 << $bit);
        }
        $maxnode = $mask_longs * 64 + 1;
    }

    my $nodemask = @mask ? pack('Q*', @mask) : 0;  # 0 = NULL pointer
    my $nr = SYS_set_mempolicy + 0;
    my $m  = $mode + 0;
    my $mn = $maxnode + 0;
    my $r = syscall($nr, $m, $nodemask, $mn);
    if ($r == -1) {
        fatal("set_mempolicy: $!");
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Time Namespace Offsets
# ═══════════════════════════════════════════════════════════════════════

sub apply_timens_offsets {
    my ($spec) = @_;
    my $offsets = $spec->{linux}{timeOffsets} // return;
    # Only write if there are actual offsets to set
    return unless ref $offsets eq 'HASH' && %$offsets;

    # Collect the lines first so we don't open the file needlessly
    my @lines;
    for my $clock (qw(monotonic boottime)) {
        my $entry = $offsets->{$clock} // next;
        my $secs  = $entry->{secs}     // 0;
        my $nsecs = $entry->{nanosecs} // 0;
        push @lines, "$clock $secs $nsecs\n";
    }
    return unless @lines;

    my $path = '/proc/self/timens_offsets';
    if (open(my $fh, '>', $path)) {
        print $fh @lines;
        close $fh;
    } else {
        warn "nacre: open $path: $! (ignoring)\n";
    }
}

# ═══════════════════════════════════════════════════════════════════════
# CPU Affinity
# ═══════════════════════════════════════════════════════════════════════

sub parse_cpu_list {
    # Parse a CPU list string like "0", "0-3", "0,2,4-7" into a list of
    # individual CPU numbers.
    my ($str) = @_;
    my @cpus;
    for my $part (split /,/, $str) {
        if ($part =~ /^(\d+)-(\d+)$/) {
            push @cpus, $1 .. $2;
        } elsif ($part =~ /^(\d+)$/) {
            push @cpus, $1;
        }
    }
    return @cpus;
}

sub cpu_list_to_mask {
    # Convert a list of CPU numbers to a bitmask for sched_setaffinity.
    # Returns ($mask_bytes, $mask_len).  The mask is a packed byte string
    # suitable for the syscall.
    my @cpus = @_;
    return ('', 0) unless @cpus;
    my $max = 0;
    for my $c (@cpus) { $max = $c if $c > $max; }
    # Kernel expects mask size in bytes, aligned to sizeof(unsigned long)=8
    my $longs = int(($max + 64) / 64);
    my @mask = (0) x $longs;
    for my $c (@cpus) {
        my $idx = int($c / 64);
        $mask[$idx] |= (1 << ($c % 64));
    }
    return (pack('Q*', @mask), $longs * 8);
}

sub get_available_cpus {
    # Read the set of online CPUs from /sys/devices/system/cpu/online.
    my $online = '';
    if (open my $fh, '<', '/sys/devices/system/cpu/online') {
        $online = <$fh>;
        chomp $online;
        close $fh;
    }
    return parse_cpu_list($online);
}

sub apply_cpu_affinity_reset {
    # Reset CPU affinity to the full available set (cgroup cpuset or system).
    # This undoes any taskset/affinity constraint inherited from the parent.
    my ($spec) = @_;

    # Determine cpuset from cgroup config or fall back to system online CPUs
    my $cpus_str = '';
    if (my $cpu = $spec->{linux}{resources}{cpu}) {
        $cpus_str = $cpu->{cpus} // '';
    }

    my @cpus;
    if ($cpus_str ne '') {
        @cpus = parse_cpu_list($cpus_str);
    } else {
        @cpus = get_available_cpus();
    }
    return unless @cpus;

    my ($mask, $len) = cpu_list_to_mask(@cpus);
    my $nr  = SYS_sched_setaffinity + 0;
    my $pid = 0 + 0;  # 0 = current process
    my $l   = $len + 0;
    syscall($nr, $pid, $l, $mask);
}

sub apply_exec_cpu_affinity {
    # Apply execCPUAffinity from config/process for exec.
    # Sets initial affinity before exec and returns final affinity to set
    # right before exec (or undef if no final).
    my ($affinity, $dbg) = @_;
    return unless $affinity;

    # Use 'defined' because Perl treats the string "0" (CPU 0 only) as falsy.
    if (defined(my $initial = $affinity->{initial})) {
        my @cpus = parse_cpu_list($initial);
        if (@cpus) {
            my ($mask, $len) = cpu_list_to_mask(@cpus);
            my $nr  = SYS_sched_setaffinity + 0;
            my $pid = 0 + 0;
            my $l   = $len + 0;
            syscall($nr, $pid, $l, $mask);
            # Log in nsexec-compatible format for bats tests.
            # Print directly to stderr (like runc's nsexec.c does),
            # not through the debug logger, so the pattern matches.
            my $hex_mask = 0;
            for my $c (@cpus) { $hex_mask |= (1 << $c); }
            printf STDERR "nsexec: affinity: 0x%x\n", $hex_mask;
        }
    }

    # Return final affinity info for post-setns application
    if (defined(my $final = $affinity->{final})) {
        return $final;
    }
    return;
}

sub apply_final_cpu_affinity {
    my ($final_str) = @_;
    return unless $final_str;
    my @cpus = parse_cpu_list($final_str);
    return unless @cpus;
    my ($mask, $len) = cpu_list_to_mask(@cpus);
    my $nr  = SYS_sched_setaffinity + 0;
    my $pid = 0 + 0;
    my $l   = $len + 0;
    syscall($nr, $pid, $l, $mask);
}

# ═══════════════════════════════════════════════════════════════════════
# Exec Capabilities (--cap flag)
# ═══════════════════════════════════════════════════════════════════════

sub apply_exec_caps {
    # Apply capabilities for exec'd processes.
    # Always applies the container's capability config from the spec.
    # If $cap_list has entries (from --cap), those are added to
    # bounding+permitted+effective (runc semantics).
    my ($cap_list, $spec) = @_;

    my $spec_caps = $spec->{process}{capabilities};
    # If no capabilities in spec and no --cap additions, nothing to do
    return unless $spec_caps || ($cap_list && @$cap_list);
    $spec_caps //= {};

    my $has_inheritable = $spec_caps->{inheritable} && @{$spec_caps->{inheritable}};

    # Build the full capability sets from spec + additions
    my %bnd_caps  = map { $_ => 1 } @{$spec_caps->{bounding}   // []};
    my %prm_caps  = map { $_ => 1 } @{$spec_caps->{permitted}  // []};
    my %eff_caps  = map { $_ => 1 } @{$spec_caps->{effective}  // []};
    my %inh_caps  = map { $_ => 1 } @{$spec_caps->{inheritable}// []};
    my %amb_caps  = map { $_ => 1 } @{$spec_caps->{ambient}    // []};

    for my $cap (@{$cap_list // []}) {
        my $name = $cap;
        $name = "CAP_$name" unless $name =~ /^CAP_/;
        $name = uc($name);
        fatal("unknown capability: $name") unless exists $CAP_NUM{$name};
        $bnd_caps{$name} = 1;
        $prm_caps{$name} = 1;
        $eff_caps{$name} = 1;
        if ($has_inheritable) {
            $amb_caps{$name} = 1;
        }
    }

    # Drop bounding set caps not in the desired set
    for my $name (@CAP_NAMES) {
        next if $bnd_caps{$name};
        my $num = $CAP_NUM{$name} // next;
        do_syscall(SYS_prctl, PR_CAPBSET_DROP, $num, 0, 0, 0);
    }

    # Set KEEPCAPS across setuid
    do_syscall(SYS_prctl, PR_SET_KEEPCAPS, 1, 0, 0, 0);

    # Build capset data
    my ($eff_lo, $eff_hi) = (0, 0);
    my ($prm_lo, $prm_hi) = (0, 0);
    my ($inh_lo, $inh_hi) = (0, 0);

    for my $name (keys %eff_caps) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $eff_lo |= (1 << $n); } else { $eff_hi |= (1 << ($n - 32)); }
    }
    for my $name (keys %prm_caps) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $prm_lo |= (1 << $n); } else { $prm_hi |= (1 << ($n - 32)); }
    }
    for my $name (keys %inh_caps) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $inh_lo |= (1 << $n); } else { $inh_hi |= (1 << ($n - 32)); }
    }
    # Ambient caps require the cap in BOTH permitted AND inheritable sets.
    # Merge ambient into inheritable (same as runc's ApplyCaps).
    for my $name (keys %amb_caps) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $inh_lo |= (1 << $n); } else { $inh_hi |= (1 << ($n - 32)); }
    }

    my $hdr = pack('Ii', _LINUX_CAPABILITY_VERSION_3, 0);
    my $data = pack('III III',
        $eff_lo, $prm_lo, $inh_lo,
        $eff_hi, $prm_hi, $inh_hi);
    my $nr_capset = SYS_capset + 0;
    syscall($nr_capset, $hdr, $data);

    # Clear keepcaps
    do_syscall(SYS_prctl, PR_SET_KEEPCAPS, 0, 0, 0, 0);

    # Raise ambient capabilities
    for my $name (keys %amb_caps) {
        my $n = $CAP_NUM{$name} // next;
        do_syscall(SYS_prctl, PR_CAP_AMBIENT, PR_CAP_AMBIENT_RAISE, $n, 0, 0);
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Sysctls
# ═══════════════════════════════════════════════════════════════════════

my %SYSCTL_ALLOWED_PREFIXES = map { $_ => 1 } qw(
    net. fs.mqueue.
    kernel.msgmax kernel.msgmnb kernel.msgmni
    kernel.sem kernel.shmall kernel.shmmax kernel.shmmni
    kernel.domainname
);

sub validate_sysctl {
    my ($key) = @_;
    for my $prefix (keys %SYSCTL_ALLOWED_PREFIXES) {
        return 1 if index($key, $prefix) == 0;
    }
    return 0;
}

sub apply_sysctls {
    my ($spec) = @_;
    my $sysctls = $spec->{linux}{sysctl} // return;
    for my $key (keys %$sysctls) {
        fatal("sysctl '$key' not allowed") unless validate_sysctl($key);
        my $path = '/proc/sys/' . ($key =~ s/\./\//gr);
        eval { write_file($path, $sysctls->{$key}); };
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Hooks
# ═══════════════════════════════════════════════════════════════════════

sub run_hooks {
    my ($hooks, $state, %opts) = @_;
    return unless $hooks;
    my $must_succeed = $opts{must_succeed} // 0;
    my $hook_type    = $opts{type} // '';
    my $hook_idx     = 0;  # runc uses 0-based indexing
    for my $hook (@$hooks) {
        # Prepare state JSON and pipe BEFORE forking so the child inherits
        # a real file descriptor that survives exec().
        my $state_json = $JSON_COMPACT->encode(oci_state_json($state));
        pipe(my $rd, my $wr) or fatal("pipe for hook stdin: $!");

        my $pid = fork();
        fatal("fork for hook: $!") unless defined $pid;
        if ($pid == 0) {
            close $wr;  # Child doesn't write
            # Set env
            if ($hook->{env}) {
                for my $e (@{$hook->{env}}) {
                    my ($k, $v) = split /=/, $e, 2;
                    $ENV{$k} = $v;
                }
            }
            # Redirect the pipe read-end to STDIN (real fd survives exec)
            open STDIN, '<&', $rd or _exit(1);
            close $rd;
            my @args = @{$hook->{args} // [$hook->{path}]};
            { exec { $hook->{path} } @args };
            _exit(1);
        }
        # Parent: write state JSON into the pipe, then close
        close $rd;
        print $wr $state_json;
        close $wr;

        my $timeout = $hook->{timeout} // 30;
        my $elapsed = 0;
        while ($elapsed < $timeout) {
            my $w = waitpid($pid, WNOHANG);
            last if $w > 0;
            select(undef, undef, undef, 0.1);
            $elapsed += 0.1;
        }
        my $hook_label = $hook_type ? "$hook_type hook #$hook_idx" : "hook $hook->{path}";
        if ($elapsed >= $timeout) {
            kill 9, $pid;
            waitpid($pid, 0);
            if ($must_succeed) {
                fatal("error running $hook_label: hook timed out after ${timeout}s");
            }
            warn "nacre: $hook_label timed out\n";
        } elsif ($?) {
            # Hook exited non-zero or was killed by signal
            my $sig = $? & 127;
            my $exit_code = $? >> 8;
            if ($sig) {
                my %sig_names = (4 => 'illegal instruction', 6 => 'aborted',
                    8 => 'floating point exception', 9 => 'killed',
                    11 => 'segmentation fault', 31 => 'bad system call');
                my $sig_name = $sig_names{$sig} // "signal $sig";
                if ($must_succeed) {
                    fatal("error running $hook_label: $sig_name: $hook->{path}");
                }
                warn "nacre: $hook_label: $sig_name\n";
            } else {
                if ($must_succeed) {
                    fatal("error running $hook_label: hook command exited with error code $exit_code");
                }
                warn "nacre: $hook_label exited with code $exit_code\n";
            }
        }
        $hook_idx++;
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Init Process (runs inside the container)
# ═══════════════════════════════════════════════════════════════════════

sub run_init_process {
    my ($spec, $rootfs, $notify_fd, $main_chan_w, $main_chan_r, $cgpath, $id, $bundle, $console_socket_path, $debug_fd, $no_pivot, $foreground, $pty_sock_fd, $mount_source_fds, $console_socket_prefd) = @_;

    my $dbg = sub {
        return unless defined $debug_fd && $debug_fd >= 0;
        my $msg = join('', @_) . "\n";
        POSIX::write($debug_fd, $msg, length($msg));
    };

    $dbg->("init_process: start, console_socket=" . (defined $console_socket_path ? $console_socket_path : 'undef'));
    log_debug("nsexec container setup");
    log_debug("child process in init()");

    # Rename network devices that were moved into our net namespace
    # by the main process.  This must happen before rootfs setup
    # (before pivot_root changes our filesystem view).
    if (my $netdevs = $spec->{linux}{netDevices}) {
        rename_net_devices($netdevs);
    }

    # Setup rootfs (mounts, devices, symlinks)
    prepare_rootfs($spec, $rootfs, $mount_source_fds, $main_chan_w, $main_chan_r);

    # Allocate PTY from the container's devpts (set up by prepare_rootfs).
    # This must happen BEFORE pivot_root so the console-socket path is still
    # reachable, but AFTER prepare_rootfs so the container's devpts is mounted.
    # Using $rootfs/dev/pts/ptmx ensures readlink shows /dev/pts/N inside
    # the container (not a host devpts path).
    my $pts_fd;
    my $need_pty = defined $console_socket_path || defined $pty_sock_fd;
    if ($need_pty) {
        sysopen(my $ptm, "$rootfs/dev/pts/ptmx", O_RDWR | O_NOCTTY | O_CLOEXEC)
            or fatal("open PTY master ($rootfs/dev/pts/ptmx): $!");
        my $ptn_buf = pack('i', 0);
        ioctl($ptm, TIOCGPTN, $ptn_buf) or fatal("TIOCGPTN: $!");
        my $ptn = unpack('i', $ptn_buf);
        my $unlock = pack('i', 0);
        ioctl($ptm, TIOCSPTLCK, $unlock) or fatal("TIOCSPTLCK: $!");

        my $pts_path = "$rootfs/dev/pts/$ptn";
        sysopen(my $pts, $pts_path, O_RDWR | O_NOCTTY)
            or fatal("open PTY slave $pts_path: $!");

        # Set console size from spec if given
        if ($spec->{process}{consoleSize}) {
            my $h = $spec->{process}{consoleSize}{height} // 0;
            my $w = $spec->{process}{consoleSize}{width}  // 0;
            my $ws = pack('S4', $h + 0, $w + 0, 0, 0);
            ioctl($ptm, TIOCSWINSZ, $ws);
        }

        if (defined $console_socket_path) {
            # Detached mode: send master to console socket.
            # Use the pre-connected fd if available (needed when inside a
            # userns where the socket path is no longer accessible).
            if (defined $console_socket_prefd && $console_socket_prefd >= 0) {
                send_fd_over_fd($console_socket_prefd, fileno($ptm));
                POSIX::close($console_socket_prefd);
                undef $console_socket_prefd;
            } else {
                send_fd_via_socket($console_socket_path, fileno($ptm));
            }
            close($ptm);
        } elsif (defined $pty_sock_fd) {
            # Foreground mode: send master to parent via socketpair
            send_fd_over_fd($pty_sock_fd + 0, fileno($ptm));
            close($ptm);
            POSIX::close($pty_sock_fd);
        }

        # Dup the slave fd so it survives filehandle scope
        $pts_fd = POSIX::dup(fileno($pts));
        fatal("dup PTY slave: $!") unless defined $pts_fd && $pts_fd >= 0;
        close($pts);
        $dbg->("PTY allocated from container devpts: slave fd=$pts_fd, pts=$ptn");
    }

    # pivot_root or chroot
    if ($no_pivot) {
        $dbg->("no-pivot: using MS_MOVE + chroot (masking host procfs/sysfs)");
        # Mask host procfs/sysfs full mounts outside the rootfs to prevent
        # the container from remounting them after chroot (runc compat).
        _mask_host_procfs_sysfs($rootfs);
        # chdir into rootfs BEFORE MS_MOVE so the cwd follows the move
        # and chroot(".") targets the rootfs, matching runc's msMoveRoot.
        chdir($rootfs) or fatal("chdir to rootfs: $!");
        # MS_MOVE the rootfs to "/" then chroot, matching runc's msMoveRoot.
        do_mount($rootfs, '/', '', MS_MOVE, '')
            or fatal("MS_MOVE $rootfs to /: $!");
        chroot('.') or fatal("chroot(.): $!");
        chdir('/') or fatal("chdir /: $!");
    } else {
        apply_pivot_root($rootfs);
    }

    # Apply the spec's rootfs propagation now that we're inside the new root
    apply_rootfs_propagation($spec);

    # Hostname — call syscall() directly (mixed string/integer args)
    if (my $hostname = $spec->{hostname}) {
        my $nr = SYS_sethostname + 0;
        my $h  = $hostname . "\0";
        my $l  = length($hostname) + 0;
        syscall($nr, $h, $l);
    }
    if (my $domainname = $spec->{domainname}) {
        my $nr = SYS_setdomainname + 0;
        my $d  = $domainname . "\0";
        my $l  = length($domainname) + 0;
        syscall($nr, $d, $l);
    }

    # Sysctls (after pivot_root, /proc/sys is the container's)
    apply_sysctls($spec);

    # Masked paths
    apply_masked_paths($spec->{linux}{maskedPaths});

    # Readonly paths
    apply_readonly_paths($spec->{linux}{readonlyPaths});

    # Set rootfs readonly if requested
    set_rootfs_readonly($spec->{root}{readonly});

    # chdir to cwd (OCI spec: MUST fail if cwd doesn't exist)
    my $cwd = $spec->{process}{cwd} // '/';
    chdir($cwd) or fatal("chdir to cwd '$cwd': $!");

    # Redirect stdio AFTER pivot_root so paths resolve correctly.
    # For detached non-terminal containers, point to the container's
    # /dev/null.  For terminal containers, the PTY dup2 below overrides.
    if (!$foreground && !defined $pts_fd) {
        open STDIN,  '<', '/dev/null';
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
    }

    # Set up container stdio from PTY slave BEFORE signaling init_ready.
    # runc does this before the created→started transition so the fd leak
    # test sees clean FDs (only 0,1,2 + exec.fifo).
    if (defined $pts_fd) {
        # chown the PTY to the container's uid with gid 5 (tty group)
        # runc compat: PTY ownership is set before setuid, while still root
        my $uid = $spec->{process}{user}{uid} // 0;
        do_syscall(SYS_fchown, $pts_fd, $uid, 5);

        my $r0 = POSIX::dup2($pts_fd, 0);
        my $r1 = POSIX::dup2($pts_fd, 1);
        my $r2 = POSIX::dup2($pts_fd, 2);
        $dbg->("dup2 pts_fd=$pts_fd → 0=$r0 1=$r1 2=$r2");
        $r0 >= 0 or fatal("dup2 pts→stdin: $!");
        $r1 >= 0 or fatal("dup2 pts→stdout: $!");
        $r2 >= 0 or fatal("dup2 pts→stderr: $!");
        # Set the PTY as the controlling terminal for this session.
        my $tio = ioctl(STDIN, TIOCSCTTY, 0);
        $dbg->("TIOCSCTTY=" . ($tio // 'undef') . " err=$!");
    }

    # Apply process security (NNP, seccomp, caps, setuid/setgid) BEFORE
    # signalling init_ready.  This matches runc: all security is applied
    # during create, not start.  The seccomp notify fd handoff must happen
    # before init_ready because the parent exits the message loop on that.
    $dbg->("apply_process_security");
    my $seccomp_notify_fd = apply_process_security($spec);

    # If seccomp NOTIFY is active, send the notify fd to the parent.
    # The parent will forward it to the listener socket (listenerPath).
    if (defined $seccomp_notify_fd && $seccomp_notify_fd >= 0) {
        $dbg->("seccomp: sending notify fd=$seccomp_notify_fd to parent");
        channel_send($main_chan_w, { type => 'seccomp_notify_fd' });
        send_fd_over_fd($main_chan_w, $seccomp_notify_fd);
        POSIX::close($seccomp_notify_fd);
        # Wait for parent to confirm listener connection
        my $resp = channel_recv($main_chan_r);
        if (!$resp || $resp->{type} eq 'notify_fd_error') {
            my $err = $resp ? ($resp->{error} // 'unknown') : 'no response';
            fatal("failed to connect with seccomp agent: $err");
        }
    }

    # Signal main process: init ready (after security is applied)
    log_debug("init: closing the pipe to signal completion");
    channel_send($main_chan_w, { type => 'init_ready' });

    # Close all fds > 2 except the notify fd (exec.fifo / start barrier).
    # Channel fds are no longer needed — seccomp handoff is complete and
    # init_ready has been sent.
    my $notify_fileno = ref($notify_fd) ? fileno($notify_fd) : $notify_fd;
    for my $fd (3..1023) {
        next if defined $notify_fileno && $fd == $notify_fileno;
        POSIX::close($fd);
    }

    # Install signal handlers before waiting.  As PID 1 in the container's
    # PID namespace, signals without explicit handlers are silently ignored
    # by the kernel.  This ensures the container can be killed while in the
    # "created" state (e.g. via pidfd_send_signal).
    $SIG{TERM} = sub { _exit(0) };
    $SIG{INT}  = sub { _exit(0) };
    $SIG{HUP}  = sub { _exit(0) };

    # Wait for start signal
    wait_for_start($notify_fd);

    # Restore default signal disposition after start
    $SIG{TERM} = 'DEFAULT';
    $SIG{INT}  = 'DEFAULT';
    $SIG{HUP}  = 'DEFAULT';

    # Set environment — must happen before startContainer hooks, which
    # per OCI spec inherit the process environment.
    %ENV = ();
    for my $e (@{$spec->{process}{env} // []}) {
        my ($k, $v) = split /=/, $e, 2;
        $ENV{$k} = $v if defined $k;
    }

    # Default HOME from /etc/passwd if not set or empty (OCI / runc compat).
    # runc overrides HOME="" with the passwd entry (de facto behavior).
    # At this point we are already inside the container rootfs (post pivot_root).
    if (!defined $ENV{HOME} || $ENV{HOME} eq '') {
        my $uid = $spec->{process}{user}{uid} // 0;
        my $home = '/';
        if (open my $pw, '<', '/etc/passwd') {
            while (my $line = <$pw>) {
                chomp $line;
                my @f = split /:/, $line;
                if (@f >= 6 && $f[2] == $uid) {
                    $home = $f[5] if $f[5] ne '';
                    last;
                }
            }
            close $pw;
        }
        $ENV{HOME} = $home;
    }

    # Run startContainer hooks (run inside the container namespace,
    # with seccomp active and process environment set)
    if (my $hooks = $spec->{hooks}) {
        if ($hooks->{startContainer}) {
            my $hook_state = {
                ociVersion => $spec->{ociVersion} // '1.2.0',
                id         => $id // '',
                status     => 'running',
                pid        => $$,
                bundle     => $bundle // '',
                annotations => $spec->{annotations} // {},
            };
            run_hooks($hooks->{startContainer}, $hook_state, must_succeed => 1, type => 'startContainer');
        }
    }

    # (rlimits are applied in apply_process_security, before caps drop)

    # Apply IO priority
    apply_iopriority($spec);

    # (scheduler is applied in apply_process_security, before caps drop)

    # Apply memory policy
    apply_memory_policy($spec);

    # Reset CPU affinity to available set (undoes any taskset constraint)
    apply_cpu_affinity_reset($spec);

    # Close any fds opened during post-start setup (CLOEXEC for exec).
    my $cr_ret = do_syscall(SYS_close_range, 3, ~0, CLOSE_RANGE_CLOEXEC);
    if ($cr_ret == -1) {
        for my $fd (3..1023) {
            POSIX::close($fd);
        }
    }

    # Exec
    my @args = @{$spec->{process}{args} // ['sh']};
    $dbg->("exec: " . join(' ', @args) . " (PATH=$ENV{PATH})");
    # The debug fd is marked CLOEXEC (or closed by fallback); exec closes it.
    { no warnings 'exec'; exec { $args[0] } @args };
    # runc-compatible error format — write directly to stderr and _exit.
    # The channel fd is already closed (fd cleanup loop above), so
    # fatal() → die → eval would lose the message.  runc also writes
    # directly to stderr from the init process on exec failure.
    my $err = lc("$!");
    $dbg->("exec FAILED: $err");
    print STDERR "exec $args[0]: $err\n";
    POSIX::_exit(1);
}

# ═══════════════════════════════════════════════════════════════════════
# Main Process (runs on the host, coordinates init setup)
# ═══════════════════════════════════════════════════════════════════════

sub run_main_process {
    my (%p) = @_;
    my $spec       = $p{spec};
    my $id         = $p{id};
    my $bundle     = $p{bundle};
    my $root       = $p{root};
    my $cgpath     = $p{cgpath};
    my $init_pid   = $p{init_pid};
    my $chan_r_fd   = $p{chan_r};
    my $rootfs = $spec->{root}{path} // 'rootfs';
    $rootfs = "$bundle/$rootfs" unless $rootfs =~ m{^/};

    # Setup cgroup — don't silence "non-empty cgroup" errors
    cgroup_setup($cgpath, $spec) if $cgpath;

    # Add init process to cgroup
    eval { cgroup_add_process($cgpath, $init_pid); };

    # Apply device cgroup (eBPF)
    eval { apply_device_cgroup($cgpath, $spec); };

    # Write UID/GID mappings for user namespace
    write_id_mappings($init_pid, $spec);

    # Wait for init_ready message
    my $msg = channel_recv($chan_r_fd);
    if (!$msg || $msg->{type} ne 'init_ready') {
        fatal("init process failed to become ready");
    }

    # Save state
    my $start_time = get_pid_starttime($init_pid);
    my $state = {
        ociVersion   => $spec->{ociVersion} // '1.2.0',
        id           => $id,
        status       => 'created',
        pid          => $init_pid,
        pidStartTime => $start_time,
        bundle       => $bundle,
        rootfs       => $rootfs,
        annotations  => $spec->{annotations} // {},
        created      => iso8601_now(),
        cgroupPath   => $cgpath,
    };
    save_state($root, $state);

    # Write pid file if requested
    if ($p{pid_file}) {
        write_file($p{pid_file}, "$init_pid\n");
    }

    # Run createRuntime hooks
    if (my $hooks = $spec->{hooks}) {
        run_hooks($hooks->{createRuntime}, $state, type => 'createRuntime');
        run_hooks($hooks->{prestart}, $state, type => 'prestart');
    }

    return $state;
}

# ═══════════════════════════════════════════════════════════════════════
# User namespace UID/GID mapping
# ═══════════════════════════════════════════════════════════════════════

sub write_id_mappings {
    my ($pid, $spec) = @_;
    my $linux = $spec->{linux} // return;

    my $uid_maps = $linux->{uidMappings};
    my $gid_maps = $linux->{gidMappings};
    return unless $uid_maps || $gid_maps;

    # Write "deny" to setgroups before gid_map
    eval { write_file("/proc/$pid/setgroups", "deny"); };

    if ($uid_maps) {
        my $content = join("\n", map {
            "$_->{containerID} $_->{hostID} $_->{size}"
        } @$uid_maps) . "\n";
        write_file("/proc/$pid/uid_map", $content);
    }

    if ($gid_maps) {
        my $content = join("\n", map {
            "$_->{containerID} $_->{hostID} $_->{size}"
        } @$gid_maps) . "\n";
        write_file("/proc/$pid/gid_map", $content);
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: create
# ═══════════════════════════════════════════════════════════════════════

sub cmd_create {
    my (%p) = @_;
    my $id       = $p{id}       // fatal("container id required");
    my $bundle   = $p{bundle}   // getcwd();
    my $root     = $p{root}     // $DEFAULT_ROOT;
    my $no_pivot = $p{no_pivot};

    $bundle = abs_path($bundle);
    log_debug("create container id=$id bundle=$bundle root=$root");

    # Check container doesn't already exist (OCI spec: MUST error if ID not unique)
    if (-d state_dir($root, $id)) {
        my $s = eval { load_state($root, $id) };
        fatal("container '$id' already exists") if $s;
        # Directory exists but no valid state — clean up stale state
        delete_state($root, $id);
    }

    my $spec = load_spec($bundle);

    # Validate early — OCI spec requires errors for values that cannot
    # be mapped to kernel interfaces.
    validate_capabilities($spec);
    validate_rlimits($spec);
    validate_memory_policy($spec);

    # Validate: seccomp SCMP_ACT_NOTIFY requires a non-empty listenerPath
    # and certain syscalls cannot be intercepted via NOTIFY.
    if (my $seccomp = $spec->{linux}{seccomp}) {
        my $has_notify = 0;
        for my $rule (@{$seccomp->{syscalls} // []}) {
            if (($rule->{action} // '') eq 'SCMP_ACT_NOTIFY') {
                $has_notify = 1;
                # write(2) cannot be used with NOTIFY — the fd number is
                # communicated to the parent via write(), creating a deadlock.
                for my $name (@{$rule->{names} // []}) {
                    fatal("SCMP_ACT_NOTIFY cannot be used for the write syscall")
                        if $name eq 'write';
                }
            }
        }
        $has_notify = 1 if ($seccomp->{defaultAction} // '') eq 'SCMP_ACT_NOTIFY';
        if ($has_notify) {
            my $lp = $seccomp->{listenerPath} // '';
            fatal("SCMP_ACT_NOTIFY requires a non-empty listenerPath")
                if $lp eq '';
        }
    }

    # Validate: SCHED_DEADLINE cannot be used with cpuset (AllowedCPUs)
    if (my $sched = $spec->{process}{scheduler}) {
        my $cpus = $spec->{linux}{resources}{cpu}{cpus} // '';
        if ($cpus ne '' && ($sched->{policy} // '') eq 'SCHED_DEADLINE') {
            fatal("process scheduler can't be used together with AllowedCPUs");
        }
    }

    # Validate: timeOffsets require a time namespace
    if (my $to = $spec->{linux}{timeOffsets}) {
        if (ref $to eq 'HASH' && keys %$to) {
            my $has_timens = grep { ($_->{type} // '') eq 'time' }
                             @{$spec->{linux}{namespaces} // []};
            fatal("time offsets require a time namespace")
                unless $has_timens;
        }
    }

    # Snapshot config.json — OCI spec: "Any updates to config.json
    # after this step MUST NOT affect the container."
    cache_spec($root, $id, $spec);

    my $rootfs = $spec->{root}{path} // 'rootfs';
    $rootfs = "$bundle/$rootfs" unless $rootfs =~ m{^/};
    fatal("rootfs '$rootfs' does not exist") unless -d $rootfs;

    my $cgpath = cgroup_path($spec, $id);

    # Determine which namespaces to create vs join
    my $namespaces = $spec->{linux}{namespaces} // [];
    my $clone_flags = 0;
    my @join_ns;
    my $has_userns = 0;
    my $has_pidns = 0;

    for my $ns (@$namespaces) {
        my $info = $NS_MAP{$ns->{type}} // next;
        if ($ns->{path}) {
            push @join_ns, { type => $ns->{type}, path => $ns->{path}, info => $info };
        } else {
            $clone_flags |= $info->{flag};
        }
        $has_userns = 1 if $ns->{type} eq 'user';
        $has_pidns  = 1 if $ns->{type} eq 'pid';
    }
    # NOTE: namespace join ordering is handled below in the three-phase
    # setns loop (non-user first, then user, then retry deferred).

    # Ensure a mount namespace exists — pivot_root and rootfs setup
    # modify the mount tree and would corrupt the caller's filesystem
    # without one.  Only add CLONE_NEWNS if the spec doesn't already
    # configure a mount namespace (either by creation or join-by-path).
    unless (grep { $_->{type} eq 'mount' } @$namespaces) {
        $clone_flags |= CLONE_NEWNS;
    }

    # Create IPC channels
    my ($main_r_fd, $main_w_fd, $main_r_fh, $main_w_fh) = create_channel();
    my ($init_r_fd, $init_w_fd, $init_r_fh, $init_w_fh) = create_channel();

    # For foreground mode with terminal but no console-socket: create a
    # socketpair so the init process can send the PTY master fd to the parent.
    my ($pty_parent_sock, $pty_child_sock);
    if ($p{foreground} && $spec->{process}{terminal} && !$p{console_socket}) {
        socketpair($pty_parent_sock, $pty_child_sock, AF_UNIX, SOCK_STREAM, 0)
            or fatal("socketpair for PTY: $!");
    }

    # Create notify socket directory
    my $notify_dir = state_dir($root, $id);
    ensure_dir($notify_dir);
    my $notify_path = "$notify_dir/notify.sock";

    # Create the notify listener and init debug log BEFORE forking.
    # After entering a user namespace the child process runs as a mapped
    # UID (e.g. host UID 100000) and can no longer create files in the
    # root-owned state directory.  Creating them here (as root on the
    # host) and passing the fds to the child avoids "Permission denied".
    my $notify_srv = create_notify_listener($notify_path);

    my $init_debug_fd_pre;
    eval {
        sysopen(my $dfh, "$notify_dir/init.log",
                O_WRONLY | O_CREAT | O_TRUNC, 0644) or die "open: $!";
        $init_debug_fd_pre = POSIX::dup(fileno($dfh));
        close $dfh;
    };

    # Fork: child will become the init process
    my $child_pid = fork();
    fatal("fork: $!") unless defined $child_pid;

    if ($child_pid == 0) {
        # === Child process (will become container init) ===
        close $main_r_fh;  # Close parent's read end
        close $init_w_fh;  # Close parent's write end
        close $pty_parent_sock if defined $pty_parent_sock;  # Close parent's PTY sock

        # Set death signal
        do_syscall(SYS_prctl, PR_SET_PDEATHSIG, 9, 0, 0, 0);

        # Pre-open bind mount sources that may become inaccessible once
        # we enter a user namespace.  We stash file descriptors keyed by
        # source path; apply_mounts will use /proc/self/fd/$fd instead.
        my %mount_source_fds;
        if ($has_userns) {
            for my $m (@{$spec->{mounts} // []}) {
                my $src = $m->{source} // next;
                next if $src eq '';
                my @opts = @{$m->{options} // []};
                next unless grep { $_ eq 'bind' || $_ eq 'rbind' } @opts;
                # Resolve relative source paths against the bundle
                my $abs_src = $src;
                if ($abs_src !~ m{^/}) {
                    $abs_src = "$p{bundle}/$abs_src" if $p{bundle};
                }
                next unless -e $abs_src;
                my $open_flags = O_RDONLY | O_CLOEXEC;
                $open_flags = O_RDONLY | O_CLOEXEC | O_PATH if -d $abs_src;
                if (sysopen(my $fh, $abs_src, $open_flags)) {
                    $mount_source_fds{$src} = fileno($fh);
                    # Keep $fh alive by stashing in a closure-captured array
                    push @{$mount_source_fds{_fhs}}, $fh;
                }
            }
        }

        # Pre-connect to console socket before entering any user namespace.
        # After joining or creating a userns, the host filesystem paths may
        # become inaccessible (EACCES) because the process runs as an
        # unmapped UID.  The connected socket fd survives the userns switch.
        my $console_socket_preconnected_fd;
        if ($has_userns && $p{console_socket} && $spec->{process}{terminal}) {
            eval {
                socket(my $sock, AF_UNIX, SOCK_STREAM, 0) or die "socket: $!";
                connect($sock, pack_sockaddr_un($p{console_socket}))
                    or die "connect to console socket '$p{console_socket}': $!";
                $console_socket_preconnected_fd = POSIX::dup(fileno($sock));
                close $sock;
            };
            # Non-fatal — if the socket isn't ready yet, fall back to path-based
            # connection later (which works when there's no userns).
        }

        # Join specified namespaces — three-phase approach:
        # Phase 1: non-user namespaces (skip EPERM — may need userns first)
        # Phase 2: join user namespace
        # Phase 3: retry deferred EPERM ones (now that we're in the userns)
        # This handles timens (owned by container userns, EPERM from init
        # userns) and netns owned by a different userns.
        #
        # IMPORTANT: Open ALL namespace fds BEFORE any setns so that we
        # don't need to re-open /proc/PID/ns/* after joining the userns
        # (the UID change from joining userns can block /proc access).
        my $joined_userns = 0;
        my @deferred_ns;

        # Pre-open all namespace fds
        my (@ns_open, $userns_entry);
        for my $ns (@join_ns) {
            my $ns_fd;
            sysopen($ns_fd, $ns->{path}, O_RDONLY) or fatal("open ns $ns->{path}: $!");
            my $entry = { %$ns, fd => $ns_fd, fileno => fileno($ns_fd) };
            if ($ns->{type} eq 'user') {
                $userns_entry = $entry;
            } else {
                push @ns_open, $entry;
            }
        }

        # Phase 1: try non-user namespaces
        for my $e (@ns_open) {
            my $nr  = SYS_setns + 0;
            my $fd  = $e->{fileno} + 0;
            my $flg = $e->{info}{flag} + 0;
            my $r;
            do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
            if ($r != 0) {
                if ($! == EPERM) {
                    push @deferred_ns, $e;
                } else {
                    fatal("setns $e->{type}: $!");
                }
            }
        }
        # Phase 2: join user namespace
        if ($userns_entry) {
            my $nr  = SYS_setns + 0;
            my $fd  = $userns_entry->{fileno} + 0;
            my $flg = $userns_entry->{info}{flag} + 0;
            my $r;
            do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
            $r == 0 or fatal("setns $userns_entry->{type}: $!");
            close $userns_entry->{fd};
            $joined_userns = 1;
        }
        # Phase 3: retry deferred (fd already open from Phase 1)
        for my $e (@deferred_ns) {
            my $nr  = SYS_setns + 0;
            my $fd  = $e->{fileno} + 0;
            my $flg = $e->{info}{flag} + 0;
            my $r;
            do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
            $r == 0 or fatal("setns $e->{type} (deferred): $!");
        }
        # Close all namespace fds
        for my $e (@ns_open) { close $e->{fd}; }
        # After joining an existing user namespace, become root inside it.
        # The host UID 0 is typically not in the target userns mapping, so
        # the process appears as overflow UID 65534.  setuid(0)/setgid(0)
        # transitions to container UID 0 (which may map to a different
        # host UID).  Silently ignore failure: some userns configs may not
        # map UID 0, and the process will continue at whatever UID it has.
        if ($joined_userns) {
            POSIX::setgid(0);
            POSIX::setuid(0);
        }

        # Unshare namespaces (except PID — that's handled by fork below)
        my $unshare_flags = $clone_flags & ~CLONE_NEWPID & ~CLONE_NEWCGROUP;

        # When both NEWTIME and NEWUSER are requested, unshare NEWTIME
        # first and write offsets while still in the initial user namespace.
        # After entering a new userns, the /proc mount belongs to the
        # initial userns and writing /proc/self/timens_offsets would fail
        # with EPERM.  Splitting the unshare so NEWTIME happens before
        # NEWUSER avoids the permission issue (runc handles this in
        # nsexec.c where timens setup precedes userns entry).
        if (($clone_flags & CLONE_NEWTIME) && ($clone_flags & CLONE_NEWUSER)) {
            my $nr  = SYS_unshare + 0;
            my $flg = CLONE_NEWTIME + 0;
            my $r;
            do { $r = syscall($nr, $flg) } while ($r == -1 && $! == EINTR);
            $r == 0 or fatal("unshare NEWTIME: $!");
            $unshare_flags &= ~CLONE_NEWTIME;
            # Write timens offsets now, before entering the userns
            apply_timens_offsets($spec);
        }

        if ($clone_flags & CLONE_NEWUSER) {
            # Creating a new user namespace: unshare first, then let
            # parent write UID/GID mappings before proceeding.
            my $nr  = SYS_unshare + 0;
            my $flg = CLONE_NEWUSER + 0;
            my $r;
            do { $r = syscall($nr, $flg) } while ($r == -1 && $! == EINTR);
            $r == 0 or fatal("unshare NEWUSER: $!");
            $unshare_flags &= ~CLONE_NEWUSER;

            # Signal parent to write UID/GID mappings
            channel_send($main_w_fd, { type => 'write_mapping', pid => $$ });

            # Wait for mapping done
            my $resp = channel_recv($init_r_fd);
            fatal("mapping failed") unless $resp && $resp->{type} eq 'mapping_done';

            # Become root (UID 0 / GID 0) inside the new user namespace.
            # After unshare(CLONE_NEWUSER), the process UID/GID is the
            # overflow value (65534) because the host UID 0 is typically
            # not in the container's UID mapping.  The init process needs
            # UID 0 to mount tmpfs, create devices, etc.
            POSIX::setgid(0);
            POSIX::setuid(0);
        }
        # Note: when joining an existing userns via path (setns above),
        # we do NOT unshare NEWUSER — the setns already placed us in the
        # target userns.  Mappings come from the target userns.

        # Unshare remaining namespaces (not PID, not cgroup).
        # Use inline scalar variables for syscall() args — Perl's syscall()
        # inspects SV type flags; constants and @_ aliases from map can carry
        # stale POK flags that cause the kernel arg to be misinterpreted.
        # Fresh lexical scalars (with $x + 0 coercion) ensure clean IOK SVs.
        if ($unshare_flags) {
            my $nr  = SYS_unshare + 0;
            my $flg = $unshare_flags + 0;
            my $ret;
            do { $ret = syscall($nr, $flg) } while ($ret == -1 && $! == EINTR);
            $ret == 0 or fatal(sprintf("unshare(0x%x): $!", $unshare_flags));
        }

        # Write time namespace offsets (must happen after unshare that
        # includes CLONE_NEWTIME, before fork that creates children in
        # the new time namespace).  Skip if already handled above (the
        # timens+userns early-unshare path).
        if (($clone_flags & CLONE_NEWTIME) && ($unshare_flags & CLONE_NEWTIME)) {
            # NEWTIME was just unshared in the remaining-flags block above
            apply_timens_offsets($spec);
        }

        # Fork again for PID namespace (child becomes PID 1 in new PID ns).
        # Only unshare when creating a NEW PID namespace ($clone_flags has
        # the flag set).  If the spec joins an existing PID namespace via
        # path, setns() already handled it above — calling unshare here
        # would fail with EINVAL.
        if ($clone_flags & CLONE_NEWPID) {
            my $nr  = SYS_unshare + 0;
            my $flg = CLONE_NEWPID + 0;
            my $ret;
            do { $ret = syscall($nr, $flg) } while ($ret == -1 && $! == EINTR);
            $ret == 0 or fatal("unshare NEWPID: $!");
        }

        my $init_pid = fork();
        fatal("fork for PID ns: $!") unless defined $init_pid;

        if ($init_pid > 0) {
            # Intermediate child: report init PID and exit
            channel_send($main_w_fd, { type => 'init_pid', pid => $init_pid });
            _exit(0);
        }

        # === Init process (PID 1 in new PID namespace) ===
        setsid();

        # PTY setup is done inside run_init_process AFTER prepare_rootfs,
        # using the container's devpts so readlink shows /dev/pts/X.
        my $console_socket_path = ($spec->{process}{terminal} && $p{console_socket})
            ? $p{console_socket} : undef;

        # For foreground terminal: pass the PTY socketpair fd so init can
        # send the master fd back to the parent for I/O relay.
        my $pty_sock_fd = (defined $pty_child_sock) ? fileno($pty_child_sock) : undef;

        # Use the pre-opened init debug log fd (created before fork so
        # it works even when a user namespace remaps our UID).
        my $init_debug_fd = $init_debug_fd_pre;

        # For detached containers, /dev/null redirect is handled inside
        # run_init_process after pivot_root, so the fd path resolves to
        # the container's /dev/null (not the host's, which becomes
        # unreachable after pivot_root).

        # Unshare cgroup namespace
        if ($clone_flags & CLONE_NEWCGROUP) {
            # Wait until parent has set up cgroups
            my $msg = channel_recv($init_r_fd);
            # Then unshare
            my $nr  = SYS_unshare + 0;
            my $flg = CLONE_NEWCGROUP + 0;
            my $r;
            do { $r = syscall($nr, $flg) } while ($r == -1 && $! == EINTR);
            log_debug("unshare cgroup: " . ($r == 0 ? "ok" : "failed: $!"))
                if $r != 0;
        }

        # Notify listener was already created before fork (so it works
        # even when a user namespace remaps our UID on the host FS).
        # $notify_srv is inherited from the parent scope.

        # Run the init process (eval captures die from fatal so we can
        # report the actual error to the parent through the channel).
        eval {
            run_init_process($spec, $rootfs, $notify_srv, $main_w_fd, $init_r_fd, $cgpath, $id, $bundle, $console_socket_path, $init_debug_fd, $no_pivot, $p{foreground}, $pty_sock_fd, \%mount_source_fds, $console_socket_preconnected_fd);
        };
        if ($@) {
            my $err = "$@";
            chomp $err;
            # Write error directly to stderr (which is the PTY slave in
            # terminal mode, or the original stderr otherwise).  The die
            # message was caught by eval and never reached stderr, and
            # the channel fd is already closed (fd cleanup after init_ready),
            # so this is the only way to get the message to the parent.
            POSIX::write(2, "$err\n", length($err) + 1);
            # Write error to debug log
            if (defined $init_debug_fd && $init_debug_fd >= 0) {
                my $msg = "init_process FATAL: $err\n";
                POSIX::write($init_debug_fd, $msg, length($msg));
            }
            # Also try the channel (may fail if fd was closed)
            eval { channel_send($main_w_fd, { type => 'init_error', error => $err }); };
        }
        _exit(1);
    }

    # === Parent process ===
    close $main_w_fh;  # Close child's write end
    close $init_r_fh;  # Close child's read end
    close $pty_child_sock if defined $pty_child_sock;  # Close child's PTY sock end
    close $notify_srv;  # Parent doesn't listen; cmd_start connects to the path
    POSIX::close($init_debug_fd_pre) if defined $init_debug_fd_pre;

    # Handle messages from child
    my $init_pid;
    my $init_error;
    my $mapping_written = 0;
    my $init_ready = 0;

    while (1) {
        my $msg = channel_recv($main_r_fd);
        last unless $msg;

        if ($msg->{type} eq 'write_mapping') {
            # Child created user namespace, write mappings
            write_id_mappings($msg->{pid}, $spec);
            $mapping_written = 1;
            channel_send($init_w_fd, { type => 'mapping_done' });
        }
        elsif ($msg->{type} eq 'init_pid') {
            $init_pid = $msg->{pid};
            # Tell init that cgroup is ready (for CLONE_NEWCGROUP)
            if ($clone_flags & CLONE_NEWCGROUP) {
                # cgroup_setup must NOT be silenced — "non-empty cgroup"
                # is a real error that must propagate.
                cgroup_setup($cgpath, $spec) if $cgpath;
                eval { cgroup_add_process($cgpath, $init_pid); };
                if ($@) { log_debug("cgroup_add_process in NEWCGROUP path: $@"); }
                eval { apply_device_cgroup($cgpath, $spec); };
                channel_send($init_w_fd, { type => 'cgroup_done' });
            }
        }
        elsif ($msg->{type} eq 'mount_fd_request') {
            # Init needs us to apply mount_setattr(MOUNT_ATTR_IDMAP) because
            # it's inside a user namespace and can't do it itself.
            my $tree_fd = recv_fd_over_fd($main_r_fd);
            if ($tree_fd >= 0) {
                my $userns_fd;
                my $close_userns = 0;
                if ($msg->{implied}) {
                    # Use init process's own user namespace
                    sysopen(my $ns_fh, "/proc/$init_pid/ns/user", O_RDONLY)
                        or fatal("open init userns: $!");
                    $userns_fd = fileno($ns_fh);
                    my $sf = AT_EMPTY_PATH | ($msg->{ridmap} ? AT_RECURSIVE : 0);
                    do_mount_setattr($tree_fd, "", $sf, MOUNT_ATTR_IDMAP, 0, $userns_fd)
                        or warn "nacre: mount_setattr IDMAP (implied): $!\n";
                    close $ns_fh;
                } else {
                    my $uid_map = $msg->{uid_map} || "0 0 4294967295\n";
                    my $gid_map = $msg->{gid_map} || "0 0 4294967295\n";
                    $userns_fd = _create_userns_from_strings($uid_map, $gid_map);
                    my $sf = AT_EMPTY_PATH | ($msg->{ridmap} ? AT_RECURSIVE : 0);
                    do_mount_setattr($tree_fd, "", $sf, MOUNT_ATTR_IDMAP, 0, $userns_fd)
                        or warn "nacre: mount_setattr IDMAP: $!\n";
                    POSIX::close($userns_fd);
                }
                POSIX::close($tree_fd);
            }
            channel_send($init_w_fd, { type => 'mount_fd_done' });
        }
        elsif ($msg->{type} eq 'bind_source_request') {
            # Init process can't access a bind mount source (inaccessible
            # directory after entering user namespace).  We (the parent)
            # still have root privileges in the init userns.  Join the
            # child's mount namespace, open the source O_PATH fd, and
            # send it back.  The fd will reference a mount owned by the
            # child's mount namespace, so the bind mount succeeds.
            my $source = $msg->{source} // '';
            my $ok = 0;
            eval {
                # Save our mount namespace
                sysopen(my $orig_mnt, "/proc/self/ns/mnt", O_RDONLY)
                    or die "open own mntns: $!";
                # Join init process's mount namespace
                sysopen(my $child_mnt, "/proc/$init_pid/ns/mnt", O_RDONLY)
                    or die "open child mntns: $!";
                {
                    my $nr  = SYS_setns + 0;
                    my $fd  = fileno($child_mnt) + 0;
                    my $flg = CLONE_NEWNS + 0;
                    my $r;
                    do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
                    $r == 0 or die "setns mntns: $!";
                }
                close $child_mnt;

                # Resolve relative source path against bundle
                my $abs_src = $source;
                if ($abs_src !~ m{^/}) {
                    $abs_src = "$bundle/$abs_src" if defined $bundle;
                }

                # Open O_PATH fd (works even for directories)
                my $oflags = O_RDONLY | O_CLOEXEC;
                $oflags = O_RDONLY | O_CLOEXEC | O_PATH if -d $abs_src;
                sysopen(my $src_fh, $abs_src, $oflags)
                    or die "open source '$abs_src': $!";
                my $src_fd = fileno($src_fh);

                # Switch back to our original mount namespace
                {
                    my $nr  = SYS_setns + 0;
                    my $fd  = fileno($orig_mnt) + 0;
                    my $flg = CLONE_NEWNS + 0;
                    my $r;
                    do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
                    # Ignore failure — channel loop doesn't need mntns
                }
                close $orig_mnt;

                # Send response + fd
                channel_send($init_w_fd, { type => 'bind_source_done', ok => 1 });
                send_fd_over_fd($init_w_fd, $src_fd);
                close $src_fh;
                $ok = 1;
            };
            unless ($ok) {
                log_debug("bind_source_request failed: $@");
                channel_send($init_w_fd, { type => 'bind_source_done', ok => 0 });
            }
        }
        elsif ($msg->{type} eq 'seccomp_notify_fd') {
            # Receive the seccomp notify fd from init
            my $notify_fd = recv_fd_over_fd($main_r_fd);
            if ($notify_fd >= 0) {
                # Forward the notify fd to the seccomp listener
                my $listener_path = $spec->{linux}{seccomp}{listenerPath} // '';
                my $listener_meta = $spec->{linux}{seccomp}{listenerMetadata} // '';
                if ($listener_path ne '') {
                    eval {
                        # Build ContainerProcessState JSON per OCI spec.
                        # The seccompagent expects this as the data payload
                        # alongside the fd via SCM_RIGHTS.
                        my $container_state = {
                            ociVersion => $spec->{ociVersion} // '1.2.0',
                            fds        => ['seccompFd'],
                            pid        => $init_pid + 0,
                            metadata   => $listener_meta,
                            state      => {
                                ociVersion  => $spec->{ociVersion} // '1.2.0',
                                id          => $id // '',
                                status      => 'running',
                                pid         => $init_pid + 0,
                                bundle      => $bundle // '',
                                annotations => $spec->{annotations} // {},
                            },
                        };
                        my $payload = encode_json($container_state);
                        send_fd_via_socket($listener_path, $notify_fd, $payload);
                    };
                    if ($@) {
                        my $err = "$@";
                        chomp $err;
                        warn "nacre: failed to connect with seccomp agent at $listener_path: $err\n";
                        POSIX::close($notify_fd);
                        channel_send($init_w_fd, { type => 'notify_fd_error', error => $err });
                        next;
                    }
                }
                POSIX::close($notify_fd);
            }
            # Signal init that listener is connected
            channel_send($init_w_fd, { type => 'notify_fd_done' });
        }
        elsif ($msg->{type} eq 'init_ready') {
            $init_ready = 1;
            last;
        }
        elsif ($msg->{type} eq 'init_error') {
            # Init process reported a fatal error — store it for the
            # error message we'll emit below.
            $init_error = $msg->{error} // 'unknown';
        }
    }

    # Reap intermediate child
    waitpid($child_pid, 0);

    fatal("init process failed to start") unless $init_pid;

    # Check init process is actually alive and init_ready was received
    unless ($init_ready) {
        # Init process died during setup — try to get exit status
        my $w = waitpid($init_pid, WNOHANG);
        my $exit_msg = ($w > 0) ? " (exit status " . ($? >> 8) . ")" : "";
        my $err_detail = $init_error ? ": $init_error" : "";
        fatal("init process died during container setup${exit_msg}${err_detail}");
    }

    # If cgroup wasn't set up yet (no CLONE_NEWCGROUP path)
    unless ($clone_flags & CLONE_NEWCGROUP) {
        # cgroup_setup must NOT be silenced — "non-empty cgroup" is a real
        # error that the test suite checks.  Only silence apply_device_cgroup
        # (it may fail if eBPF isn't available).
        cgroup_setup($cgpath, $spec) if $cgpath;
        eval { cgroup_add_process($cgpath, $init_pid); } if $cgpath;
        eval { apply_device_cgroup($cgpath, $spec); };
    }

    # If no user namespace, write mappings now (for non-userns case they're not needed)
    # (uid/gid mappings are only for user namespaces)

    # Receive PTY master fd from init process (foreground terminal mode)
    my $pty_master_fd;
    if (defined $pty_parent_sock) {
        $pty_master_fd = recv_fd_over_fd(fileno($pty_parent_sock));
        close $pty_parent_sock;
        if ($pty_master_fd < 0) {
            warn "nacre: failed to receive PTY master fd\n";
            $pty_master_fd = undef;
        }
    }

    # Save state
    my $start_time = get_pid_starttime($init_pid);
    my $state = {
        ociVersion   => $spec->{ociVersion} // '1.2.0',
        id           => $id,
        status       => 'created',
        pid          => $init_pid,
        pidStartTime => $start_time,
        bundle       => $bundle,
        rootfs       => $rootfs,
        annotations  => $spec->{annotations} // {},
        created      => iso8601_now(),
        cgroupPath   => $cgpath,
    };
    save_state($root, $state);

    # Write pid file
    if ($p{pid_file}) {
        write_file($p{pid_file}, "$init_pid\n");
    }

    # Send pidfd via socket if requested
    if ($p{pidfd_socket}) {
        my $pidfd_nr = SYS_pidfd_open + 0;
        my $pid_arg  = $init_pid + 0;
        my $pidfd    = syscall($pidfd_nr, $pid_arg, 0);
        fatal("pidfd_open($init_pid): $!") if $pidfd < 0;
        send_fd_via_socket($p{pidfd_socket}, $pidfd);
        POSIX::close($pidfd);
    }

    # Move network devices into the container's network namespace
    if (my $netdevs = $spec->{linux}{netDevices}) {
        move_net_devices($netdevs, $init_pid);
    }

    # Run createRuntime hooks (OCI spec: MUST error if these fail)
    # If a hook fails, clean up state so the container id can be reused.
    if (my $hooks = $spec->{hooks}) {
        eval {
            run_hooks($hooks->{createRuntime}, $state, must_succeed => 1, type => 'createRuntime');
            run_hooks($hooks->{createContainer}, $state, must_succeed => 1, type => 'createContainer');
            run_hooks($hooks->{prestart}, $state, must_succeed => 1, type => 'prestart');
        };
        if ($@) {
            my $err = $@;
            # Kill the init process and clean up state
            kill 9, $init_pid if $init_pid;
            waitpid($init_pid, 0) if $init_pid;
            delete_state($root, $id);
            die $err;
        }
    }

    # Return PTY master fd for foreground relay
    $state->{_pty_master_fd} = $pty_master_fd if defined $pty_master_fd;

    return $state;
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: start
# ═══════════════════════════════════════════════════════════════════════

sub cmd_start {
    my (%p) = @_;
    my $id   = $p{id}   // fatal("container id required");
    my $root = $p{root} // $DEFAULT_ROOT;
    log_debug("start container id=$id");

    my $state = load_state($root, $id);
    fatal("container '$id' is not in 'created' state (is '$state->{status}')")
        unless $state->{status} eq 'created';

    # Load the cached spec snapshot from create time (config.json
    # modifications after create MUST NOT affect the container).
    my $spec = eval { load_cached_spec($root, $id, $state->{bundle}) };
    fatal("cannot load config: $@") unless $spec;

    # process.args may be empty or process may be nil — the OCI spec
    # allows omitting spec.process entirely.  In that case, create/start
    # still succeeds and the init process exits cleanly without exec'ing
    # a user program (matches kontainer-runtime / runc behaviour).

    # Connect to notify socket
    my $notify_path = state_dir($root, $id) . '/notify.sock';
    notify_container_start($notify_path);

    # Update state to running
    $state->{status} = 'running';
    save_state($root, $state);

    # Run poststart hooks ($spec already loaded above).
    # A failed poststart hook kills the container and returns an error
    # (matching runc behaviour — the container HAS started, but the run
    # command reports failure).
    if ($spec->{hooks}) {
        eval {
            run_hooks($spec->{hooks}{poststart}, $state, must_succeed => 1, type => 'poststart');
        };
        if ($@) {
            my $err = $@;
            eval { kill 9, $state->{pid} if $state->{pid}; };
            die $err;
        }
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: state
# ═══════════════════════════════════════════════════════════════════════

sub cmd_state {
    my (%p) = @_;
    my $id   = $p{id}   // fatal("container id required");
    my $root = $p{root} // $DEFAULT_ROOT;

    my $state = load_state($root, $id);
    print $JSON->encode(oci_state_json($state));
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: kill
# ═══════════════════════════════════════════════════════════════════════

sub cmd_kill {
    my (%p) = @_;
    my $id     = $p{id}     // fatal("container id required");
    my $root   = $p{root}   // $DEFAULT_ROOT;
    my $signal = $p{signal} // 'TERM';
    my $all    = $p{all}    // 0;

    my $state = load_state($root, $id);

    # When --all/-a is used, silently succeed even if the container is not
    # running (runc compat: -a is the obsoleted "all processes" flag).
    if ($state->{status} ne 'running' && $state->{status} ne 'created') {
        return if $all;

        # Parse signal early for cgroup-based kill checks below
        my $signum_check;
        if ($signal =~ /^\d+$/) { $signum_check = $signal; }
        else { my $s = $signal; $s =~ s/^SIG//i; $signum_check = $SIG_NUM{uc($s)}; }

        if ($state->{status} eq 'stopped') {
            # In host PID namespace scenarios, the init may be gone but
            # exec'd processes remain alive in the cgroup.  Allow SIGKILL
            # to reach them via cgroup.kill.
            unless ($signum_check && $signum_check == 9 && $state->{cgroupPath}) {
                fatal("container not running");
            }
            my @pids = cgroup_pids($state->{cgroupPath});
            fatal("container not running") unless @pids;
        } else {
            # For other states (paused, etc.): allow SIGKILL via cgroup.kill
            unless ($signum_check && $signum_check == 9 && $state->{cgroupPath}) {
                fatal("container not running");
            }
        }
    }

    # Parse signal
    my $signum;
    if ($signal =~ /^\d+$/) {
        $signum = $signal;
    } else {
        $signal =~ s/^SIG//i;
        $signum = $SIG_NUM{uc($signal)} // fatal("unknown signal: $signal");
    }

    # For SIGKILL: use cgroup.kill (cgroup v2) to atomically kill all
    # processes in the container.  This is essential when the container
    # shares the host PID namespace (no init cascade).
    if ($signum == 9 && $state->{cgroupPath}) {
        # Try cgroup.kill first (kernel 5.14+)
        my $cg_kill_ok = eval { cg_write($state->{cgroupPath}, 'cgroup.kill', '1'); 1 };
        unless ($cg_kill_ok) {
            # Fallback: freeze + signal all + thaw
            eval { cg_write($state->{cgroupPath}, 'cgroup.freeze', '1'); };
            my @pids = cgroup_pids($state->{cgroupPath});
            for my $pid (@pids) {
                kill $signum, $pid;
            }
            eval { cg_write($state->{cgroupPath}, 'cgroup.freeze', '0'); };
        }
    } elsif ($all && $state->{cgroupPath}) {
        # Kill all processes in cgroup (--all flag)
        my @pids = cgroup_pids($state->{cgroupPath});
        for my $pid (@pids) {
            kill $signum, $pid;
        }
    } else {
        kill $signum, $state->{pid} or fatal("kill $state->{pid}: $!");
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: delete
# ═══════════════════════════════════════════════════════════════════════

sub cmd_delete {
    my (%p) = @_;
    my $id    = $p{id}    // fatal("container id required");
    my $root  = $p{root}  // $DEFAULT_ROOT;
    my $force = $p{force} // 0;
    log_debug("delete container id=$id force=$force");

    # runc compat: `delete --force` on a nonexistent container succeeds silently
    my $state_path = state_dir($root, $id) . '/state.json';
    my $state_raw  = read_file($state_path);
    if (!defined $state_raw) {
        return if $force;
        fatal("container '$id' does not exist");
    }
    my $state = $JSON->decode($state_raw);
    refresh_state($state);

    if ($state->{status} eq 'running' || $state->{status} eq 'created'
        || $state->{status} eq 'paused') {
        if ($force) {
            # Unfreeze first for paused containers so SIGKILL can be delivered
            if ($state->{status} eq 'paused' && $state->{cgroupPath}) {
                eval { write_file("$state->{cgroupPath}/cgroup.freeze", "0\n") };
                select(undef, undef, undef, 0.1);
            }
            # Force kill
            if ($state->{pid} > 0) {
                kill 9, $state->{pid};
                # Wait a bit
                select(undef, undef, undef, 0.1);
            }
            if ($state->{cgroupPath}) {
                cgroup_cleanup($state->{cgroupPath});
            }
        } else {
            fatal("container '$id' is not stopped (is '$state->{status}'). Use --force to force delete.");
        }
    }

    # Cleanup cgroup
    if ($state->{cgroupPath} && -d $state->{cgroupPath}) {
        cgroup_cleanup($state->{cgroupPath});
    }

    # Run poststop hooks (use cached spec from create time)
    my $spec = eval { load_cached_spec($root, $id, $state->{bundle}) };
    if ($spec && $spec->{hooks}) {
        run_hooks($spec->{hooks}{poststop}, $state, type => 'poststop');
    }

    # Remove state
    delete_state($root, $id);
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: run (create + start + wait + delete)
# ═══════════════════════════════════════════════════════════════════════

sub cmd_run {
    my (%p) = @_;
    my $id     = $p{id}     // fatal("container id required");
    my $root   = $p{root}   // $DEFAULT_ROOT;
    my $bundle = $p{bundle} // getcwd();
    log_debug("run container id=$id bundle=$bundle detach=" . ($p{detach}//0));
    my $detach = $p{detach};

    if ($detach) {
        # Detached mode: create + start, then return immediately.
        # Equivalent to `runc create` + `runc start`.
        my $state = cmd_create(%p);
        cmd_start(id => $id, root => $root);

        # Write pid file if requested
        if ($p{pid_file} && $state->{pid}) {
            write_file($p{pid_file}, $state->{pid});
        }
        return;
    }

    # Foreground mode: create + start + wait
    # Set as subreaper so we can wait for the init process (grandchild
    # reparented to us when the intermediate child exits).
    my $pr_nr  = SYS_prctl + 0;
    my $pr_opt = PR_SET_CHILD_SUBREAPER + 0;
    my $sr_ret = syscall($pr_nr, $pr_opt, 1, 0, 0, 0);

    # Create (foreground: keep stdio so user sees container output)
    my $state = cmd_create(%p, foreground => 1);

    # Set PTY to raw mode BEFORE sending the start signal.  The slave's
    # default ONLCR converts \n→\r\n; clearing OPOST before start ensures
    # no output goes through the PTY with cooked settings (race between
    # start and pty_set_raw was causing \r to corrupt captured output).
    my $pty_master_fd = $state->{_pty_master_fd};
    if (defined $pty_master_fd) {
        pty_set_raw($pty_master_fd);
    }

    # Start
    cmd_start(id => $id, root => $root);

    # Forward signals to init
    my $init_pid = $state->{pid};
    for my $sig (qw(TERM INT HUP QUIT USR1 USR2)) {
        $SIG{$sig} = sub { kill $SIG_NUM{$sig}, $init_pid; };
    }

    my $exit_code;

    if (defined $pty_master_fd) {
        # Foreground with PTY: relay I/O between master and stdin/stdout
        # Forward SIGWINCH to the container's terminal
        $SIG{WINCH} = sub {
            if (-t STDIN) {
                my $ws = "\0" x 8;
                ioctl(STDIN, TIOCGWINSZ, $ws);
                # Forward winsize to the PTY master via sysopen+ioctl on the fd
                if (open my $mfh, '+<&', $pty_master_fd) {
                    ioctl($mfh, TIOCSWINSZ, $ws);
                }
            }
        };

        # Put master in non-blocking mode
        my $fl = fcntl_getfl($pty_master_fd);
        fcntl_setfl($pty_master_fd, $fl | O_NONBLOCK) if defined $fl;

        # Put stdin in non-blocking mode
        my $stdin_fd = fileno(STDIN);
        my $stdin_fl = fcntl_getfl($stdin_fd);
        fcntl_setfl($stdin_fd, $stdin_fl | O_NONBLOCK) if defined $stdin_fl;

        my $done = 0;
        $exit_code = 0;
        local $SIG{CHLD} = sub {
            local $?;  # Prevent clobbering caller's $?
            while ((my $w = waitpid(-1, WNOHANG)) > 0) {
                if ($w == $init_pid) {
                    if (WIFEXITED($?)) {
                        $exit_code = WEXITSTATUS($?);
                    } elsif (WIFSIGNALED($?)) {
                        $exit_code = 128 + WTERMSIG($?);
                    }
                    $done = 1;
                }
            }
        };

        # Check if child already exited before handler was installed
        {
            my $w = waitpid($init_pid, WNOHANG);
            if ($w > 0) {
                if (WIFEXITED($?)) {
                    $exit_code = WEXITSTATUS($?);
                } elsif (WIFSIGNALED($?)) {
                    $exit_code = 128 + WTERMSIG($?);
                }
                $done = 1;
            }
        }

        while (!$done) {
            my $rin = '';
            vec($rin, $pty_master_fd, 1) = 1;
            vec($rin, $stdin_fd, 1) = 1;

            my $nfound = select($rin, undef, undef, 0.5);
            next if !$nfound || $nfound < 0;

            # Read from PTY master → write to stdout
            if (vec($rin, $pty_master_fd, 1)) {
                my $buf;
                my $n = POSIX::read($pty_master_fd, $buf, 8192);
                if (defined $n && $n > 0) {
                    syswrite(STDOUT, $buf, $n);
                } elsif (!defined $n && $! != EAGAIN && $! != EWOULDBLOCK && $! != EINTR) {
                    $done = 1;
                } elsif (defined $n && $n == 0) {
                    $done = 1;
                }
            }

            # Read from stdin → write to PTY master
            if (vec($rin, $stdin_fd, 1)) {
                my $buf;
                my $n = sysread(STDIN, $buf, 8192);
                if (defined $n && $n > 0) {
                    POSIX::write($pty_master_fd, $buf, $n);
                }
            }
        }

        # Drain remaining output
        while (1) {
            my $buf;
            my $n = POSIX::read($pty_master_fd, $buf, 8192);
            last unless defined $n && $n > 0;
            syswrite(STDOUT, $buf, $n);
        }

        POSIX::close($pty_master_fd);

        # Always reap init — PTY EOF can set $done before SIGCHLD
        # delivers the exit code, so we must collect it here regardless.
        {
            my $w = waitpid($init_pid, WNOHANG);
            if ($w <= 0) {
                # Child still running or not yet reaped — block for it.
                $w = waitpid($init_pid, 0);
            }
            if ($w == $init_pid) {
                if (WIFEXITED($?)) {
                    $exit_code = WEXITSTATUS($?);
                } elsif (WIFSIGNALED($?)) {
                    $exit_code = 128 + WTERMSIG($?);
                }
            }
        }

        # Restore stdin
        fcntl_setfl($stdin_fd, $stdin_fl) if defined $stdin_fl;
    } else {
        # No PTY: just wait for the init process
        $exit_code = 0;
        my $got_init = 0;

        # Try pidfd_open first (kernel 5.3+)
        my $pidfd_nr = SYS_pidfd_open + 0;
        my $pidfd = syscall($pidfd_nr, $init_pid + 0, 0);

        if ($pidfd >= 0) {
            my $waitid_nr = SYS_waitid + 0;
            my $siginfo = "\0" x 128;
            my $P_PIDFD = 3;
            my $WEXITED = 4;
            my $wr = syscall($waitid_nr, $P_PIDFD + 0, $pidfd + 0,
                             $siginfo, $WEXITED + 0, 0);
            if ($wr == 0) {
                my $si_code   = unpack('i', substr($siginfo, 8, 4));
                my $si_status = unpack('i', substr($siginfo, 24, 4));
                if ($si_code == 1) {
                    $exit_code = $si_status;
                } else {
                    $exit_code = 128 + $si_status;
                }
                $got_init = 1;
            }
            POSIX::close($pidfd);
        }

        unless ($got_init) {
            while (1) {
                my $w = waitpid(-1, 0);
                if ($w == $init_pid) {
                    if (WIFEXITED($?)) {
                        $exit_code = WEXITSTATUS($?);
                    } elsif (WIFSIGNALED($?)) {
                        $exit_code = 128 + WTERMSIG($?);
                    }
                    $got_init = 1;
                    last;
                }
                last if $w < 0 && $! != EINTR;
            }
        }

        unless ($got_init) {
            while (kill(0, $init_pid)) {
                while ((my $z = waitpid(-1, WNOHANG)) > 0) {
                    if ($z == $init_pid) {
                        if (WIFEXITED($?)) {
                            $exit_code = WEXITSTATUS($?);
                        } elsif (WIFSIGNALED($?)) {
                            $exit_code = 128 + WTERMSIG($?);
                        }
                        $got_init = 1;
                        last;
                    }
                }
                last if $got_init;
                select(undef, undef, undef, 0.1);
            }
        }
    }

    # Delete
    eval { cmd_delete(id => $id, root => $root, force => 1); };

    exit($exit_code);
}

# ═══════════════════════════════════════════════════════════════════════
# Container: list
# ═══════════════════════════════════════════════════════════════════════

sub cmd_list {
    my (%p) = @_;
    my $root   = $p{root}   // $DEFAULT_ROOT;
    my $format = $p{format} // 'table';
    my $quiet  = $p{quiet}  // 0;

    my @containers;
    if (opendir(my $dh, $root)) {
        while (my $id = readdir($dh)) {
            next if $id =~ /^\./;
            my $st = eval { load_state($root, $id) };
            next unless $st;
            push @containers, $st;
        }
        closedir($dh);
    } elsif ($p{root_explicit}) {
        # Explicit --root with non-existent directory is an error
        fatal("root directory '$root' does not exist");
    }
    # Default root that doesn't exist is fine — just show empty list

    if ($quiet) {
        print "$_->{id}\n" for sort { $a->{id} cmp $b->{id} } @containers;
        return;
    }

    if ($format eq 'json') {
        # JSON list output: compact, field order matches runc
        # (ociVersion, id, pid, status, bundle, rootfs, created)
        my @entries;
        for my $c (sort { $a->{id} cmp $b->{id} } @containers) {
            my $s = oci_state_json($c);
            my @pairs;
            for my $key (qw(ociVersion id pid status bundle rootfs created)) {
                next unless defined $s->{$key};
                push @pairs, $JSON_COMPACT->encode($key) . ':' . $JSON_COMPACT->encode($s->{$key});
            }
            push @entries, '{' . join(',', @pairs) . '}';
        }
        print '[' . join(',', @entries) . "]\n";
        return;
    }

    # Table format (runc column order: ID PID STATUS BUNDLE CREATED OWNER)
    printf "%-20s %-10s %-10s %-40s %-30s %s\n", 'ID', 'PID', 'STATUS', 'BUNDLE', 'CREATED', 'OWNER';
    for my $c (sort { $a->{id} cmp $b->{id} } @containers) {
        printf "%-20s %-10s %-10s %-40s %-30s %s\n",
            $c->{id}, $c->{pid}, $c->{status},
            $c->{bundle} // '',
            $c->{created} // '',
            '';
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container: pause / resume
# ═══════════════════════════════════════════════════════════════════════

sub cmd_pause {
    my (%p) = @_;
    my $id   = $p{id}   // fatal("container id required");
    my $root = $p{root} // $DEFAULT_ROOT;

    my $state = load_state($root, $id);
    fatal("container not running") unless $state->{status} eq 'running';

    cg_write($state->{cgroupPath}, 'cgroup.freeze', '1');
    $state->{status} = 'paused';
    save_state($root, $state);
}

sub cmd_resume {
    my (%p) = @_;
    my $id   = $p{id}   // fatal("container id required");
    my $root = $p{root} // $DEFAULT_ROOT;

    my $state = load_state($root, $id);
    fatal("container '$id' is not paused") unless $state->{status} eq 'paused';

    cg_write($state->{cgroupPath}, 'cgroup.freeze', '0');
    $state->{status} = 'running';
    save_state($root, $state);
}

# ═══════════════════════════════════════════════════════════════════════
# Exec TTY I/O relay
# ═══════════════════════════════════════════════════════════════════════

sub exec_tty_relay {
    my ($child_pid, $master_fd, $err_r_fd) = @_;

    # Relay I/O between PTY master and our stdin/stdout.
    # This runs until the child process exits.

    # Set PTY to raw mode (disable OPOST/ONLCR — \n should not become \r\n)
    pty_set_raw($master_fd);

    # Put PTY master in non-blocking mode
    my $fl = fcntl_getfl($master_fd);
    fcntl_setfl($master_fd, $fl | O_NONBLOCK) if defined $fl;

    # Also set stdin non-blocking for select
    my $stdin_fd = fileno(STDIN);
    my $stdin_fl = fcntl_getfl($stdin_fd);
    fcntl_setfl($stdin_fd, $stdin_fl | O_NONBLOCK) if defined $stdin_fl;

    my $child_exited = 0;
    my $exit_status = 0;
    local $SIG{CHLD} = sub {
        local $?;  # Prevent clobbering caller's $?
        my $ret = waitpid($child_pid, WNOHANG);
        if ($ret > 0) {
            if (WIFEXITED($?)) {
                $exit_status = WEXITSTATUS($?);
            } elsif (WIFSIGNALED($?)) {
                $exit_status = 128 + WTERMSIG($?);
            }
            $child_exited = 1;
        }
    };

    # Check if child already exited before SIGCHLD handler was installed
    # (the signal may have been delivered with the default handler).
    {
        my $ret = waitpid($child_pid, WNOHANG);
        if ($ret > 0) {
            if (WIFEXITED($?)) {
                $exit_status = WEXITSTATUS($?);
            } elsif (WIFSIGNALED($?)) {
                $exit_status = 128 + WTERMSIG($?);
            }
            $child_exited = 1;
        }
    }

    my $pty_eof = 0;
    while (!$child_exited && !$pty_eof) {
        my $rin = '';
        vec($rin, $master_fd, 1) = 1;
        vec($rin, $stdin_fd,  1) = 1;

        my $nfound = select($rin, undef, undef, 0.5);
        next if !$nfound || $nfound < 0;

        # Read from PTY master → write to stdout
        if (vec($rin, $master_fd, 1)) {
            my $buf;
            my $n = POSIX::read($master_fd, $buf, 8192);
            if (defined $n && $n > 0) {
                syswrite(STDOUT, $buf, $n);
            } elsif (!defined $n && $! != EAGAIN && $! != EWOULDBLOCK && $! != EINTR) {
                $pty_eof = 1;
            } elsif (defined $n && $n == 0) {
                $pty_eof = 1;
            }
        }

        # Read from stdin → write to PTY master
        if (vec($rin, $stdin_fd, 1)) {
            my $buf;
            my $n = sysread(STDIN, $buf, 8192);
            if (defined $n && $n > 0) {
                POSIX::write($master_fd, $buf, $n);
            }
        }
    }

    # Drain remaining output
    while (1) {
        my $buf;
        my $n = POSIX::read($master_fd, $buf, 8192);
        last unless defined $n && $n > 0;
        syswrite(STDOUT, $buf, $n);
    }

    # Check for exec errors
    my $err_msg = '';
    while (sysread(*STDIN, my $buf, 4096, 0) // 0) { last; }  # dummy
    if (defined $err_r_fd) {
        # Open err_r_fd for reading
        if (open my $efh, '<&=', $err_r_fd) {
            while (sysread($efh, my $buf, 4096)) { $err_msg .= $buf; }
            close $efh;
        }
    }
    warn "$err_msg\n" if $err_msg ne '';

    # Restore stdin
    fcntl_setfl($stdin_fd, $stdin_fl) if defined $stdin_fl;

    POSIX::close($master_fd);

    # Reap if not yet done
    unless ($child_exited) {
        waitpid($child_pid, 0);
        if (WIFEXITED($?)) {
            $exit_status = WEXITSTATUS($?);
        } elsif (WIFSIGNALED($?)) {
            $exit_status = 128 + WTERMSIG($?);
        }
    }

    exit($exit_status);
}

# Helper: fcntl F_GETFL / F_SETFL
sub fcntl_getfl {
    my ($fd) = @_;
    return undef unless defined $fd;
    # Use +<& (dup) instead of +<&= to avoid closing the original fd
    # when $fh goes out of scope.
    open my $fh, '+<&', $fd or return undef;
    my $fl = fcntl($fh, Fcntl::F_GETFL(), 0);
    return defined $fl ? ($fl + 0) : undef;
}

sub fcntl_setfl {
    my ($fd, $fl) = @_;
    return undef unless defined $fd;
    open my $fh, '+<&', $fd or return undef;
    return fcntl($fh, Fcntl::F_SETFL(), $fl);
}

# ═══════════════════════════════════════════════════════════════════════
# Container: exec
# ═══════════════════════════════════════════════════════════════════════

sub exec_fatal {
    # Like fatal(), but exits 255 for exec internal errors (runc convention)
    warn "nacre: @_\n";
    exit 255;
}

sub cmd_exec {
    my (%p) = @_;
    my $id             = $p{id}             // exec_fatal("container id required");
    my $root           = $p{root}           // $DEFAULT_ROOT;
    my @cmd            = @{$p{command}      // []};
    my $exec_cwd       = $p{cwd};
    my $exec_env       = $p{env};
    my $exec_user      = $p{user};
    my $pid_file       = $p{pid_file};
    my $preserve_fds   = $p{preserve_fds}   // 0;
    my $additional_gids = $p{additional_gids};
    my $ignore_paused  = $p{ignore_paused};
    my $process_file   = $p{process_file};
    my $tty            = $p{tty};
    my $detach         = $p{detach};
    my $console_socket = $p{console_socket};
    my $cap_add        = $p{cap};
    my $pidfd_socket   = $p{pidfd_socket};
    my $exec_cgroup    = $p{exec_cgroup};
    log_debug("exec in container id=$id");

    # Load process from -p file if given
    my $exec_proc;  # process.json data for ioprio/scheduler
    if ($process_file) {
        my $pdata = read_file($process_file);
        exec_fatal("cannot read process file '$process_file'") unless defined $pdata;
        $exec_proc = eval { $JSON->decode($pdata) };
        exec_fatal("invalid process JSON: $@") if $@;
        @cmd = @{$exec_proc->{args} // []} unless @cmd;
        $exec_cwd  //= $exec_proc->{cwd};
        $exec_env  = $exec_proc->{env} if $exec_proc->{env} && !($exec_env && @$exec_env);
        $exec_user //= join(':', $exec_proc->{user}{uid} // 0, $exec_proc->{user}{gid} // 0)
            if $exec_proc->{user};
        $additional_gids //= $exec_proc->{user}{additionalGids}
            if $exec_proc->{user} && $exec_proc->{user}{additionalGids};
        $tty //= $exec_proc->{terminal};
    }
    exec_fatal("command required for exec") unless @cmd;

    my $state = eval { load_state($root, $id) };
    exec_fatal("container '$id' does not exist") unless $state;

    # Refuse paused container (unless --ignore-paused)
    if ($state->{status} eq 'paused') {
        if ($ignore_paused) {
            # Wait for unpause — poll cgroup.freeze until 0
            log_debug("exec: container paused, waiting for resume (--ignore-paused)");
            my $cgpath = $state->{cgroupPath};
            while (1) {
                my $freeze = read_file("$cgpath/cgroup.freeze") if $cgpath;
                if (defined $freeze) {
                    chomp $freeze;
                    last if $freeze eq '0';
                }
                # Also re-check status in case container was killed
                my $s2 = eval { load_state($root, $id) };
                last unless $s2;
                if ($s2->{status} ne 'paused' && $s2->{status} ne 'running') {
                    exec_fatal("container not running");
                }
                last if $s2->{status} eq 'running';
                select(undef, undef, undef, 0.1);
            }
        } else {
            exec_fatal("cannot exec in a paused container, use --ignore-paused to wait");
        }
    } elsif ($state->{status} ne 'running' && $state->{status} ne 'created') {
        exec_fatal("container not running");
    }

    my $init_pid = $state->{pid};
    my $spec = load_cached_spec($root, $id, $state->{bundle});

    # Validate --pid-file directory exists
    if ($pid_file) {
        my $pid_dir = $pid_file;
        $pid_dir =~ s{/[^/]*$}{};
        exec_fatal("open pidfile: open $pid_file: no such file or directory")
            if $pid_dir ne $pid_file && ! -d $pid_dir;
    }

    # Determine which namespaces the container uses from the spec.
    # Only join namespaces that the container is actually configured to
    # use — joining the host user namespace (same as ours) returns EINVAL.
    my %procfs_to_spec = (
        user   => 'user',
        mnt    => 'mount',
        uts    => 'uts',
        ipc    => 'ipc',
        net    => 'network',
        pid    => 'pid',
        cgroup => 'cgroup',
        time   => 'time',
    );
    my %spec_ns_types = map { ($_->{type} // '') => 1 }
                        @{$spec->{linux}{namespaces} // []};

    # Open namespace fds — only for namespaces in the spec
    my @ns_order = qw(user mnt uts ipc net time pid cgroup);
    my @ns_fds;
    for my $ns (@ns_order) {
        my $spec_type = $procfs_to_spec{$ns} // $ns;
        next unless $spec_ns_types{$spec_type};
        my $path = "/proc/$init_pid/ns/$ns";
        if (sysopen(my $fd, $path, O_RDONLY)) {
            push @ns_fds, { name => $ns, fd => $fd, fileno => fileno($fd) };
        }
    }

    # PTY socketpair: used to pass master fd from child to parent when -t
    my ($pty_parent_fh, $pty_child_fh);
    if ($tty) {
        socketpair($pty_parent_fh, $pty_child_fh, AF_UNIX, SOCK_STREAM, 0)
            or fatal("socketpair for pty: $!");
    }

    # Error pipe: child writes exec errors back to parent
    pipe(my $err_r, my $err_w) or fatal("pipe: $!");
    # Set CLOEXEC on the write end so it auto-closes on successful exec
    my $flags = fcntl($err_w, F_GETFD, 0);
    fcntl($err_w, F_SETFD, $flags | FD_CLOEXEC);

    # Sync pipe: parent signals child after cgroup write
    pipe(my $sync_r, my $sync_w) or fatal("pipe: $!");

    # Grandchild PID pipe: when exec double-forks for PID namespace,
    # the intermediate sends the grandchild's host PID to the parent
    # so the PID file and pidfd contain the actual exec'd process.
    pipe(my $gc_pid_r, my $gc_pid_w) or fatal("pipe: $!");
    my $has_pid_ns_in_exec = grep { $_->{name} eq 'pid' } @ns_fds;

    # Deferred cgroup sync pipe: when the cgroup write is deferred (PID
    # namespace case), the grandchild waits on this pipe before exec so
    # the parent can write the grandchild's PID to the cgroup first.
    pipe(my $cg_sync_r, my $cg_sync_w) or fatal("pipe: $!");

    # Seccomp NOTIFY socketpair: when exec uses SCMP_ACT_NOTIFY, the
    # grandchild sends the notify fd to the parent (which is in the host
    # mount namespace and can connect to the seccomp agent socket).
    my $exec_has_seccomp_notify = 0;
    if ($spec->{linux}{seccomp}) {
        for my $rule (@{$spec->{linux}{seccomp}{syscalls} // []}) {
            if (($rule->{action} // '') eq 'SCMP_ACT_NOTIFY') {
                $exec_has_seccomp_notify = 1;
                last;
            }
        }
    }
    my ($seccomp_parent_fh, $seccomp_child_fh);
    if ($exec_has_seccomp_notify) {
        socketpair($seccomp_parent_fh, $seccomp_child_fh, AF_UNIX, SOCK_STREAM, 0)
            or fatal("socketpair for seccomp: $!");
    }

    # Move internal fds above the preserve-fds range so they don't
    # clobber user-inherited fds 3..2+preserve_fds.
    my $min_fd = 3 + $preserve_fds;
    for my $fh ($err_r, $err_w, $sync_r, $sync_w, $gc_pid_r, $gc_pid_w, $cg_sync_r, $cg_sync_w, ($pty_parent_fh ? $pty_parent_fh : ()), ($pty_child_fh ? $pty_child_fh : ()), ($seccomp_parent_fh ? $seccomp_parent_fh : ()), ($seccomp_child_fh ? $seccomp_child_fh : ())) {
        my $cur = fileno($fh);
        if (defined $cur && $cur >= 3 && $cur < $min_fd) {
            my $new = POSIX::dup($cur);
            if (defined $new && $new >= 0) {
                # If new is still below min, try harder with dup2 to a high fd
                if ($new < $min_fd) {
                    POSIX::close($new);
                    # Find an available fd >= min_fd
                    for my $try ($min_fd .. $min_fd + 20) {
                        if (POSIX::dup2($cur, $try) >= 0) {
                            $new = $try;
                            last;
                        }
                    }
                }
                open($fh, "+<&=$new") or next;
                POSIX::close($cur);
                # Preserve CLOEXEC if it was set
                my $f = fcntl($fh, F_GETFD, 0);
                fcntl($fh, F_SETFD, $f | FD_CLOEXEC) if $fh eq $err_w;
            }
        }
    }

    my $child = fork();
    fatal("fork for exec: $!") unless defined $child;

    if ($child == 0) {
        close $err_r;
        close $sync_w;
        close $gc_pid_r;
        close $cg_sync_w;
        close $pty_parent_fh if $pty_parent_fh;
        close $seccomp_parent_fh if $seccomp_parent_fh;

        log_debug("nsexec container setup");
        log_debug("child process in init()");

        # Join namespaces — three-phase approach (matching runc's nsexec):
        # 1. Try non-user namespaces first (while still in init userns, we
        #    have CAP_SYS_ADMIN for namespaces not owned by the container's
        #    userns). Skip EPERM failures — they'll be retried after joining
        #    the user namespace.
        # 2. Join the user namespace.
        # 3. Retry any namespaces that failed with EPERM in phase 1.
        my @deferred;
        for my $ns (@ns_fds) {
            next if $ns->{name} eq 'user';
            my $nr  = SYS_setns + 0;
            my $fd  = $ns->{fileno} + 0;
            my $flg = 0;
            my $r;
            do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
            if ($r != 0) {
                if ($! == EPERM) {
                    push @deferred, $ns;
                } else {
                    my $msg = "setns $ns->{name}: $!";
                    syswrite($err_w, $msg);
                    _exit(255);
                }
            }
        }
        # Phase 2: join user namespace
        for my $ns (@ns_fds) {
            next unless $ns->{name} eq 'user';
            my $nr  = SYS_setns + 0;
            my $fd  = $ns->{fileno} + 0;
            my $flg = 0;
            my $r;
            do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
            if ($r != 0) {
                my $msg = "setns $ns->{name}: $!";
                syswrite($err_w, $msg);
                _exit(255);
            }
        }
        # Phase 3: retry deferred namespaces (now that we're in the userns)
        for my $ns (@deferred) {
            my $nr  = SYS_setns + 0;
            my $fd  = $ns->{fileno} + 0;
            my $flg = 0;
            my $r;
            do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
            if ($r != 0) {
                my $msg = "setns $ns->{name}: $!";
                syswrite($err_w, $msg);
                _exit(255);
            }
        }
        # Close namespace fds
        my $joined_pid_ns = grep { $_->{name} eq 'pid' } @ns_fds;
        for my $ns (@ns_fds) { close $ns->{fd}; }

        # Wait for parent to write us to the cgroup
        sysread($sync_r, my $sync_buf, 1);
        close $sync_r;

        # After setns(CLONE_NEWPID), the calling thread stays in the old
        # PID namespace; only its children enter the new one.  Fork so
        # the exec'd process has a PID visible in the container's /proc.
        if ($joined_pid_ns) {
            my $pid2 = fork();
            if (!defined $pid2) {
                syswrite($err_w, "fork for PID ns: $!");
                _exit(255);
            }
            if ($pid2 > 0) {
                # Intermediate: send grandchild's host PID to parent
                syswrite($gc_pid_w, pack("L", $pid2));
                close $gc_pid_w;
                # Wait for grandchild, propagate exit status
                close $err_w;
                close $cg_sync_r;
                close $pty_child_fh if $pty_child_fh;
                close $seccomp_child_fh if $seccomp_child_fh;
                waitpid($pid2, 0);
                my $rc = $? >> 8;
                $rc = 128 + ($? & 127) if ($? & 127);
                _exit($rc);
            }
            # Grandchild: now in container's PID namespace
            close $gc_pid_w;
        }

        # chdir into container root after joining mount ns
        chdir('/');
        chdir($exec_cwd // $spec->{process}{cwd} // '/');

        # Set up PTY for exec -t (must happen after joining mount namespace
        # so we allocate from the container's devpts)
        if ($tty) {
            setsid();

            # Allocate PTY inside container
            sysopen(my $ptm, '/dev/ptmx', O_RDWR | O_NOCTTY | O_CLOEXEC)
                or do { syswrite($err_w, "open /dev/ptmx: $!"); _exit(255); };
            my $ptn_buf = pack('i', 0);
            ioctl($ptm, TIOCGPTN, $ptn_buf)
                or do { syswrite($err_w, "TIOCGPTN: $!"); _exit(255); };
            my $ptn = unpack('i', $ptn_buf);
            my $unlock = pack('i', 0);
            ioctl($ptm, TIOCSPTLCK, $unlock);

            my $pts_path = "/dev/pts/$ptn";

            # Set console size from process.json if given
            if ($exec_proc && $exec_proc->{consoleSize}) {
                my $h = $exec_proc->{consoleSize}{height} // 0;
                my $w = $exec_proc->{consoleSize}{width}  // 0;
                my $ws = pack('S4', $h + 0, $w + 0, 0, 0);
                ioctl($ptm, TIOCSWINSZ, $ws);
            }

            # Send master fd to parent for I/O relay
            send_fd_over_fd(fileno($pty_child_fh), fileno($ptm));
            close $ptm;
            close $pty_child_fh;

            # Open slave and dup2 to stdio
            sysopen(my $pts, $pts_path, O_RDWR)
                or do { syswrite($err_w, "open PTY slave $pts_path: $!"); _exit(255); };
            my $pts_fd = fileno($pts);
            # chown PTY to container user with gid 5 (tty group), matching runc
            my $exec_uid = $exec_proc->{user}{uid} // $spec->{process}{user}{uid} // 0;
            do_syscall(SYS_fchown, $pts_fd, $exec_uid, 5);
            POSIX::dup2($pts_fd, 0);
            POSIX::dup2($pts_fd, 1);
            POSIX::dup2($pts_fd, 2);
            ioctl(STDIN, TIOCSCTTY, 0);
            close $pts if $pts_fd > 2;
        }

        # Set environment: clear inherited host env, apply only exec env
        my %exec_env_keys;
        %ENV = ();
        if ($exec_env && @$exec_env) {
            for my $e (@$exec_env) {
                my ($k, $v) = split /=/, $e, 2;
                $ENV{$k} = $v;
                $exec_env_keys{$k} = 1;
            }
        }

        # Set HOME from /etc/passwd if --user is given and HOME not
        # explicitly provided in exec_env (runc compat).
        if ($exec_user) {
            my $target_uid;
            if ($exec_user =~ /^(\d+)/) { $target_uid = $1; }
            if (defined $target_uid && !$exec_env_keys{HOME}) {
                my $home = '/';
                if (open my $pw, '<', '/etc/passwd') {
                    while (my $line = <$pw>) {
                        chomp $line;
                        my @f = split /:/, $line;
                        if (@f >= 6 && $f[2] == $target_uid) {
                            $home = $f[5] if $f[5] ne '';
                            last;
                        }
                    }
                    close $pw;
                }
                $ENV{HOME} = $home;
            }
        }

        # Apply umask from container spec (runc compat: exec inherits
        # container's configured umask, not the host's)
        if (defined $spec->{process}{user}{umask}) {
            umask($spec->{process}{user}{umask});
        }

        # Apply seccomp from container spec BEFORE dropping privileges.
        # SECCOMP_FILTER_FLAG_NEW_LISTENER (SCMP_ACT_NOTIFY) requires
        # CAP_SYS_ADMIN, which is lost after setuid/capabilities drop.
        # Non-NOTIFY seccomp also works here because we still have root
        # privileges (either via CAP_SYS_ADMIN or host root UID).
        my $exec_seccomp_notify_fd = apply_seccomp_raw($spec);
        if (defined $exec_seccomp_notify_fd && $exec_seccomp_notify_fd >= 0
            && $seccomp_child_fh) {
            # Send the seccomp notify fd to the PARENT process via
            # the seccomp socketpair.  The exec child is in the container's
            # mount namespace, so it can't access the seccomp agent socket
            # (host path).  The parent is in the host mount namespace and
            # forwards it to the agent.
            send_fd_over_fd(fileno($seccomp_child_fh), $exec_seccomp_notify_fd);
            close $seccomp_child_fh;
            POSIX::close($exec_seccomp_notify_fd);
        } elsif ($seccomp_child_fh) {
            close $seccomp_child_fh;
        }

        # Set supplementary groups
        if ($additional_gids && @$additional_gids) {
            my $packed = pack("i*", map { $_ + 0 } @$additional_gids);
            my $nr = SYS_setgroups + 0;
            my $n  = scalar(@$additional_gids) + 0;
            syscall($nr, $n, $packed);
        }

        # Set user (gid then uid)
        if ($exec_user) {
            if ($exec_user =~ /^(\d+)(?::(\d+))?$/) {
                POSIX::setgid($2 + 0) if defined $2;
                POSIX::setuid($1 + 0);
            }
        }

        # Apply rlimits from container spec (exec inherits init's rlimits,
        # but process.json can override). runc exec always applies the
        # container's rlimits to the exec'd process.
        if ($exec_proc && $exec_proc->{rlimits}) {
            my $fake_spec = { process => $exec_proc };
            apply_rlimits($fake_spec);
        } elsif ($spec->{process}{rlimits}) {
            apply_rlimits($spec);
        }

        # Apply iopriority/scheduler from process.json if given,
        # otherwise apply from config.json (exec doesn't inherit from
        # init — it's a new process joining the container's namespaces).
        if ($exec_proc && ($exec_proc->{scheduler} || $exec_proc->{ioPriority})) {
            my $fake_spec = { process => $exec_proc };
            apply_iopriority($fake_spec);
            apply_scheduler($fake_spec);
        } else {
            apply_iopriority($spec);
            apply_scheduler($spec);
        }

        # Apply memory policy
        apply_memory_policy($spec);

        # Apply capabilities: always apply the container's capability
        # config to exec'd processes, merging in any --cap additions.
        apply_exec_caps($cap_add, $spec);

        # Apply no_new_privs: check both process.json and container spec.
        # The exec process inherits the container's NNP setting; process.json
        # can also set it independently.
        my $nnp = ($exec_proc && $exec_proc->{noNewPrivileges})
               || $spec->{process}{noNewPrivileges};
        if ($nnp) {
            do_syscall(SYS_prctl, PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
        }

        # Apply CPU affinity for exec
        my $exec_affinity = ($exec_proc && $exec_proc->{execCPUAffinity})
                         // $spec->{process}{execCPUAffinity};
        my $dbg_fn = sub { log_debug(@_) };
        my $final_affinity = apply_exec_cpu_affinity($exec_affinity, $dbg_fn);
        if (!$exec_affinity) {
            # No explicit execCPUAffinity — reset to available CPUs
            apply_cpu_affinity_reset($spec);
        }

        log_debug("setns_init: about to exec");

        # Wait for parent to complete deferred cgroup write (PID ns case).
        # The parent writes our PID to the cgroup after reading it from
        # the gc_pid pipe.  We must wait here so the cgroup is correct
        # before exec.  For non-PID-ns case, the pipe is closed immediately.
        sysread($cg_sync_r, my $cg_sync_buf, 1);
        close $cg_sync_r;

        # Close fds above preserve range
        # Keep: 0,1,2 + preserve_fds extra (i.e., fds 3..2+preserve_fds)
        # Close everything else except err_w
        my $max_keep = 2 + $preserve_fds;
        my $err_w_fd = fileno($err_w);
        my $log_fd = defined $LOG_FH ? eval { fileno($LOG_FH) } : undef;
        if (opendir(my $dh, '/proc/self/fd')) {
            for my $ent (readdir $dh) {
                next unless $ent =~ /^\d+$/;
                my $fd = $ent + 0;
                next if $fd <= $max_keep;
                next if $fd == $err_w_fd;
                next if $fd == fileno($dh);
                next if defined $log_fd && $fd == $log_fd;
                POSIX::close($fd);
            }
            closedir $dh;
        }

        # Apply final CPU affinity right before exec
        apply_final_cpu_affinity($final_affinity) if $final_affinity;

        { no warnings 'exec'; exec { $cmd[0] } @cmd };
        my $msg = "exec $cmd[0]: " . lc("$!");
        syswrite($err_w, $msg);
        _exit(255);
    }

    # Parent
    close $err_w;
    close $pty_child_fh if $pty_child_fh;
    close $sync_r;
    close $gc_pid_w;
    close $cg_sync_r;
    close $seccomp_child_fh if $seccomp_child_fh;

    # Move exec process into the container's cgroup (before signalling child)
    my $container_cgpath = $state->{cgroupPath};
    # Resolve the target cgroup path for the exec process
    my $deferred_exec_cg_path;  # set when PID ns (defer to grandchild)
    my $exec_target_cgpath;     # resolved cgroup target

    if ($exec_cgroup) {
        # --cgroup: move to a specific sub-cgroup
        fatal("container has no cgroup path") unless $container_cgpath;

        # Resolve the sub-cgroup path
        if ($exec_cgroup eq '/' || $exec_cgroup eq '') {
            $exec_target_cgpath = $container_cgpath;
        } else {
            # Validate: no ".." components (path traversal)
            my $cleaned = $exec_cgroup;
            $cleaned =~ s{^/+}{};
            $cleaned =~ s{/+$}{};
            if ($cleaned =~ m{(?:^|/)\.\.(?:/|$)}) {
                fatal("bad sub cgroup path: '$exec_cgroup'");
            }
            # Also reject paths that escape the container's cgroup
            # (e.g. "../sibling" even after cleaning)
            my $sub_path = "$container_cgpath/$cleaned";
            # Canonicalize and check it's still under the container cgroup
            my $real = Cwd::abs_path($sub_path);
            if (!$real || index($real, $container_cgpath) != 0) {
                fatal("bad sub cgroup path: '$exec_cgroup'");
            }
            $exec_target_cgpath = $real;
        }
        # Check the cgroup exists
        fatal("exec cgroup '$exec_target_cgpath': no such file or directory")
            unless -d $exec_target_cgpath;
    } elsif ($container_cgpath) {
        # Default: join the container's cgroup (or init's actual cgroup
        # if the container cgroup has domain controllers active).
        $exec_target_cgpath = $container_cgpath if -d $container_cgpath;
    }

    # Resolve init's actual cgroup for fallback when the container's
    # root cgroup becomes an internal node (subtree_control enabled),
    # or when the container's configured cgroup no longer exists.
    my $init_actual_cgpath;
    if ($init_pid) {
        my $init_cg = read_file("/proc/$init_pid/cgroup");
        if (defined $init_cg && $init_cg =~ m{^0::(.+)$}m) {
            my $rel = $1;
            my $init_cghost = "/sys/fs/cgroup$rel";
            $init_actual_cgpath = $init_cghost if -d $init_cghost;
        }
    }

    # If the container cgroup no longer exists (removed by systemd or
    # the container process moved itself), fall back to init's actual
    # cgroup so exec processes are placed correctly.
    if (!$exec_target_cgpath && !$exec_cgroup && $init_actual_cgpath) {
        $exec_target_cgpath = $init_actual_cgpath;
    }

    # When exec joins a PID namespace, defer the cgroup write until
    # after the double-fork so only the grandchild (actual exec'd
    # process) is placed in the cgroup, not the intermediate fork.
    # The intermediate process would linger in the cgroup doing waitpid,
    # preventing operations like subtree_control writes.
    if ($exec_target_cgpath && $has_pid_ns_in_exec) {
        $deferred_exec_cg_path = $exec_target_cgpath;
    } elsif ($exec_target_cgpath) {
        eval { write_file("$exec_target_cgpath/cgroup.procs", "$child\n") };
        if ($@) {
            # The container's cgroup may be an internal node (domain
            # controllers enabled via subtree_control).  Fall back to
            # init's actual cgroup — but ONLY when --cgroup was NOT
            # explicitly set (explicit --cgroup should fail hard).
            if (!$exec_cgroup && $init_actual_cgpath
                && $init_actual_cgpath ne $exec_target_cgpath) {
                eval { write_file("$init_actual_cgpath/cgroup.procs", "$child\n") };
                if ($@) {
                    my $err = $@; chomp $err;
                    fatal("adding pid $child to cgroups: $err");
                }
                $exec_target_cgpath = $init_actual_cgpath;
            } else {
                my $err = $@; chomp $err;
                fatal("adding pid $child to cgroups: $err");
            }
        }
    }

    # Signal child that cgroup write is done
    syswrite($sync_w, "x", 1);
    close $sync_w;

    # When the exec joins a PID namespace, the child double-forks.
    # The intermediate sends the grandchild's host PID so the PID
    # file and pidfd refer to the actual exec'd process.
    my $final_pid = $child;
    if ($has_pid_ns_in_exec) {
        sysread($gc_pid_r, my $gc_pid_buf, 4);
        if (defined $gc_pid_buf && length($gc_pid_buf) == 4) {
            $final_pid = unpack("L", $gc_pid_buf);
        }
    }
    close $gc_pid_r;

    # Deferred cgroup write: move the grandchild (not intermediate) to
    # the target cgroup so only the exec'd process is in the cgroup.
    # Non-fatal: for fast-exiting commands (e.g. cat, ls), the grandchild
    # may have already exited by the time we write, producing ESRCH.
    if ($deferred_exec_cg_path) {
        my $cg_pid = $final_pid;
        eval { write_file("$deferred_exec_cg_path/cgroup.procs", "$cg_pid\n") };
        if ($@) {
            my $err = $@; chomp $err;
            if ($exec_cgroup) {
                # Explicit --cgroup: always fatal on failure (e.g. EBUSY
                # when the cgroup is an internal node).
                fatal("adding pid $cg_pid to cgroups: $err");
            } elsif ($init_actual_cgpath
                && $init_actual_cgpath ne $deferred_exec_cg_path) {
                # Fall back to init's actual cgroup if the target is an
                # internal node (subtree_control enabled).
                eval { write_file("$init_actual_cgpath/cgroup.procs", "$cg_pid\n") };
                # Silently ignore any remaining failure (ESRCH, etc.)
            }
            # else: no explicit --cgroup, no init fallback —
            # silently ignore (ESRCH for fast-exiting commands)
        }
    }

    # Signal grandchild that deferred cgroup write is done (or not needed).
    # The grandchild waits on cg_sync_r before exec to ensure the cgroup
    # is set correctly.
    syswrite($cg_sync_w, "x", 1);
    close $cg_sync_w;

    # Receive seccomp notify fd from grandchild and forward to agent.
    # The grandchild is in the container's mount namespace and can't
    # reach the host-side seccomp agent socket.
    if ($seccomp_parent_fh) {
        my $notify_fd = recv_fd_over_fd(fileno($seccomp_parent_fh));
        close $seccomp_parent_fh;
        if ($notify_fd >= 0) {
            my $listener_path = $spec->{linux}{seccomp}{listenerPath} // '';
            my $listener_meta = $spec->{linux}{seccomp}{listenerMetadata} // '';
            if ($listener_path ne '') {
                my $container_state = {
                    ociVersion => $spec->{ociVersion} // '1.2.0',
                    fds        => ['seccompFd'],
                    pid        => $final_pid + 0,
                    metadata   => $listener_meta,
                    state      => {
                        ociVersion  => $spec->{ociVersion} // '1.2.0',
                        id          => $id // '',
                        status      => 'running',
                        pid         => $init_pid + 0,
                        bundle      => $state->{bundle} // '',
                        annotations => $spec->{annotations} // {},
                    },
                };
                my $payload = encode_json($container_state);
                eval { send_fd_via_socket($listener_path, $notify_fd, $payload) };
                if ($@) {
                    warn "nacre: failed to send seccomp notify fd to $listener_path: $@\n";
                }
            }
            POSIX::close($notify_fd);
        }
    }

    # Write pid file (after sync so we have the grandchild PID)
    if ($pid_file) {
        if (open my $pf, '>', $pid_file) {
            print $pf "$final_pid\n";
            close $pf;
        } else {
            warn "nacre: cannot write pid-file '$pid_file': $!\n";
        }
    }

    # Receive PTY master fd from child (after sync so child is unblocked)
    my $pty_master_fd;
    if ($tty && $pty_parent_fh) {
        $pty_master_fd = recv_fd_over_fd(fileno($pty_parent_fh));
        close $pty_parent_fh;
        if ($pty_master_fd < 0) {
            warn "nacre: failed to receive PTY master fd\n";
            $pty_master_fd = undef;
        }
    }

    # For detached exec with tty and console socket: send master to console socket
    if ($detach && $tty && $console_socket && defined $pty_master_fd) {
        send_fd_via_socket($console_socket, $pty_master_fd);
        POSIX::close($pty_master_fd);
        $pty_master_fd = undef;
    }

    # Send pidfd via socket if requested (use final_pid for actual exec process)
    if ($pidfd_socket) {
        my $pidfd_nr = SYS_pidfd_open + 0;
        my $pid_arg  = $final_pid + 0;
        my $pidfd    = syscall($pidfd_nr, $pid_arg, 0);
        fatal("pidfd_open($final_pid): $!") if $pidfd < 0;
        send_fd_via_socket($pidfd_socket, $pidfd);
        POSIX::close($pidfd);
    }

    # Close namespace fds in parent
    for my $ns (@ns_fds) { close $ns->{fd}; }

    if ($detach) {
        # Detached exec: don't wait, just exit
        # Read any immediate errors from the pipe
        my $err_msg = '';
        # Non-blocking check for exec errors
        my $rin = '';
        vec($rin, fileno($err_r), 1) = 1;
        if (select($rin, undef, undef, 0.1)) {
            sysread($err_r, $err_msg, 4096);
        }
        close $err_r;
        if ($err_msg ne '') {
            warn "$err_msg\n";
            exit(255);
        }
        POSIX::close($pty_master_fd) if defined $pty_master_fd;
        exit(0);
    }

    # For foreground exec with tty: relay I/O between PTY master and stdio
    if ($tty && defined $pty_master_fd) {
        exec_tty_relay($child, $pty_master_fd, fileno($err_r));
        # exec_tty_relay does not return; it calls exit()
    }

    # Wait for exec'd process (non-tty path)
    waitpid($child, 0);

    # Check for exec errors from the child
    my $err_msg = '';
    while (sysread($err_r, my $buf, 4096)) { $err_msg .= $buf; }
    close $err_r;

    if ($err_msg ne '') {
        warn "$err_msg\n";
    }

    if (WIFEXITED($?)) {
        exit(WEXITSTATUS($?));
    } elsif (WIFSIGNALED($?)) {
        exit(128 + WTERMSIG($?));
    }
    exit(1);
}

# ═══════════════════════════════════════════════════════════════════════
# Container: update (resource limits)
# ═══════════════════════════════════════════════════════════════════════

sub cmd_update {
    my (%p) = @_;
    my $id       = $p{id}        // fatal("container id required");
    my $root     = $p{root}      // $DEFAULT_ROOT;
    my $res_file = $p{resources};
    log_debug("update container id=$id");

    my $state = load_state($root, $id);
    fatal("container '$id' is not running or created or paused")
        unless $state->{status} =~ /^(running|created|paused)$/;

    my $cgpath = $state->{cgroupPath}
        // fatal("no cgroup path for container");

    my $resources;
    # runc compat: if no --resources flag and no CLI flags, read from stdin
    # when it is not a terminal (i.e. piped data).
    if (!$res_file && !-t STDIN) {
        my $has_cli_flags = grep { defined $p{$_} }
            qw(pids_limit cpu_period cpu_quota cpu_share cpu_burst
               memory memory_swap memory_reservation cpuset_cpus
               cpuset_mems cpu_idle);
        $res_file = '-' unless $has_cli_flags;
    }
    if ($res_file) {
        # Load resources from file or stdin
        my $res_json;
        if ($res_file ne '-') {
            $res_json = read_file_or_die($res_file);
        } else {
            local $/;
            $res_json = <STDIN>;
        }
        $resources = $JSON->decode($res_json);
    } else {
        # Build resources from CLI flags
        $resources = {};
        if (defined $p{pids_limit}) {
            my $v = $p{pids_limit};
            $resources->{pids} = { limit => ($v == -1) ? 'max' : $v };
        }
        my %cpu;
        $cpu{shares} = $p{cpu_share}   if defined $p{cpu_share};
        $cpu{quota}  = ($p{cpu_quota} == -1 ? 'max' : $p{cpu_quota}) if defined $p{cpu_quota};
        $cpu{period} = $p{cpu_period}  if defined $p{cpu_period};
        $cpu{burst}  = $p{cpu_burst}   if defined $p{cpu_burst};
        if (defined $p{cpu_idle}) {
            fatal("invalid cpu-idle value: $p{cpu_idle} (must be 0 or 1)")
                unless $p{cpu_idle} == 0 || $p{cpu_idle} == 1;
            $cpu{idle} = $p{cpu_idle};
        }
        $cpu{cpus}   = $p{cpuset_cpus} if defined $p{cpuset_cpus};
        $cpu{mems}   = $p{cpuset_mems} if defined $p{cpuset_mems};
        $resources->{cpu} = \%cpu if %cpu;
        my %mem;
        if (defined $p{memory}) {
            my $v = parse_size($p{memory});
            $mem{limit} = ($v == -1) ? 'max' : $v;
        }
        if (defined $p{memory_swap}) {
            my $v = parse_size($p{memory_swap});
            $mem{swap} = ($v == -1) ? 'max' : $v;
        }
        # cgroup v2 compat: when memory is set to unlimited and swap is
        # not explicitly specified, also set swap to unlimited (matching
        # runc's ConvertMemorySwapToCgroupV2Value behaviour).
        if (defined $mem{limit} && $mem{limit} eq 'max' && !defined $mem{swap}) {
            $mem{swap} = 'max';
        }
        if (defined $p{memory_reservation}) {
            my $v = parse_size($p{memory_reservation});
            $mem{reservation} = ($v == -1) ? 'max' : $v;
        }
        $resources->{memory} = \%mem if %mem;
    }

    # checkBeforeUpdate: reject if the new limit is below current usage
    if ($resources->{memory} && $resources->{memory}{checkBeforeUpdate}) {
        my $limit = $resources->{memory}{limit};
        my $swap  = $resources->{memory}{swap};
        if (defined $limit && $limit ne 'max') {
            my $current = eval { cg_read($cgpath, 'memory.current') } // 0;
            chomp $current;
            $current += 0;
            if ($current > 0 && $limit < $current) {
                fatal("rejecting memory limit $limit (too low; current usage is $current)");
            }
        }
        if (defined $swap && $swap ne 'max') {
            my $swap_current = eval { cg_read($cgpath, 'memory.swap.current') } // 0;
            chomp $swap_current;
            $swap_current += 0;
            if ($swap_current > 0 && $swap < $swap_current) {
                fatal("rejecting memory+swap limit $swap (too low; current swap usage is $swap_current)");
            }
        }
        delete $resources->{memory}{checkBeforeUpdate};
    }

    # Build a fake spec with just the resources
    my $fake_spec = { linux => { resources => $resources } };
    cgroup_apply_resources($cgpath, $fake_spec);

    # Update device cgroup rules if present
    if ($resources->{devices}) {
        apply_device_cgroup($cgpath, $fake_spec);
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container: events (stats)
# ═══════════════════════════════════════════════════════════════════════

sub cmd_events {
    my (%p) = @_;
    my $id       = $p{id}       // fatal("container id required");
    my $root     = $p{root}     // $DEFAULT_ROOT;
    # Parse Go-style duration: "100ms", "1s", "5s", or plain number (seconds)
    my $interval_raw = $p{interval} // '5s';
    my $interval;
    if ($interval_raw =~ /^(\d+(?:\.\d+)?)ms$/i) {
        $interval = $1 / 1000.0;
    } elsif ($interval_raw =~ /^(\d+(?:\.\d+)?)s$/i) {
        $interval = $1 + 0;
    } elsif ($interval_raw =~ /^(\d+(?:\.\d+)?)m$/i) {
        $interval = $1 * 60;
    } elsif ($interval_raw =~ /^(\d+(?:\.\d+)?)$/) {
        $interval = $1 + 0;
    } else {
        $interval = 5;
    }
    my $stats    = $p{stats};

    my $state = load_state($root, $id);
    my $cgpath = $state->{cgroupPath} // fatal("no cgroup path");

    my $print_stats = sub {
        my %s;
        $s{pids}{current} = scalar(cgroup_pids($cgpath));
        my $pids_max = read_file("$cgpath/pids.max") // 'max';
        chomp $pids_max;
        $s{pids}{limit} = ($pids_max =~ /^\d+$/) ? int($pids_max) : 0;

        my $mem_current = read_file("$cgpath/memory.current") // '0';
        chomp $mem_current;
        $s{memory}{usage} = ($mem_current =~ /^\d+$/) ? int($mem_current) : 0;
        my $mem_max = read_file("$cgpath/memory.max") // 'max';
        chomp $mem_max;
        $s{memory}{limit} = ($mem_max =~ /^\d+$/) ? int($mem_max) : 0;

        my $cpu_stat = read_file("$cgpath/cpu.stat") // '';
        for my $line (split /\n/, $cpu_stat) {
            my ($k, $v) = split /\s+/, $line;
            $s{cpu}{$k} = int($v) if defined $v;
        }

        # OOM events
        my $events = read_file("$cgpath/memory.events") // '';
        for my $line (split /\n/, $events) {
            my ($k, $v) = split /\s+/, $line;
            $s{memory}{$k} = int($v) if defined $v;
        }

        # PSI (pressure stall information) - io, cpu, memory
        # Nest under each controller as {psi: {some: ..., full: ...}}
        # to match runc's JSON format (e.g. data.cpu.psi.some.avg10)
        for my $psi_type (qw(cpu io memory)) {
            my $psi_data = read_file("$cgpath/$psi_type.pressure");
            if (defined $psi_data) {
                my %psi;
                for my $line (split /\n/, $psi_data) {
                    # Format: some avg10=0.00 avg60=0.00 avg300=0.00 total=0
                    #         full avg10=0.00 avg60=0.00 avg300=0.00 total=0
                    if ($line =~ /^(some|full)\s+(.*)/) {
                        my ($level, $rest) = ($1, $2);
                        my %vals;
                        while ($rest =~ /(\w+)=([0-9.]+)/g) {
                            my ($k, $v) = ($1, $2);
                            $vals{$k} = ($k eq 'total') ? int($v) : $v + 0.0;
                        }
                        $psi{$level} = \%vals;
                    }
                }
                $s{$psi_type}{psi} = \%psi if %psi;
            }
        }

        # Build JSON with runc-compatible field order (type, id, data)
        printf qq({"type":"stats","id":%s,"data":%s}\n),
            $JSON_COMPACT->encode($id),
            $JSON_COMPACT->encode(\%s);
    };

    if ($stats) {
        $print_stats->();
        return;
    }

    # Track OOM events — check memory.events for oom counter changes
    my $last_oom_count = 0;
    my $mem_events = read_file("$cgpath/memory.events");
    if (defined $mem_events && $mem_events =~ /^oom\s+(\d+)/m) {
        $last_oom_count = $1;
    }

    while (1) {
        $print_stats->();

        # Check for OOM events
        $mem_events = read_file("$cgpath/memory.events");
        if (defined $mem_events && $mem_events =~ /^oom\s+(\d+)/m) {
            my $oom_count = $1;
            if ($oom_count > $last_oom_count) {
                # Emit OOM event (runc-compatible format)
                printf qq({"type":"oom","id":%s}\n), $JSON_COMPACT->encode($id);
                $last_oom_count = $oom_count;
            }
        }

        # Use select for sub-second sleep
        if ($interval < 1) {
            select(undef, undef, undef, $interval);
        } else {
            sleep int($interval);
        }
        # Refresh state to check if still alive
        $state = eval { load_state($root, $id) };
        last unless $state;
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container: ps
# ═══════════════════════════════════════════════════════════════════════

sub cmd_ps {
    my (%p) = @_;
    my $id       = $p{id}      // fatal("container id required");
    my $root     = $p{root}    // $DEFAULT_ROOT;
    my $format   = $p{format}  // 'table';
    my @ps_args  = @{$p{ps_args} // []};
    @ps_args = ('-ef') unless @ps_args;

    my $state = load_state($root, $id);
    my $cgpath = $state->{cgroupPath} // fatal("no cgroup path");

    my @pids = cgroup_pids($cgpath);

    if ($format eq 'json') {
        print $JSON->encode(\@pids);
        return;
    }

    # Run ps and filter to only our PIDs
    my %our_pids = map { $_ => 1 } @pids;
    open my $ps, '-|', 'ps', @ps_args or fatal("ps: $!");
    my $header = <$ps>;
    print $header if $header;
    while (<$ps>) {
        # Find PID in the line
        if (/^\s*\S+\s+(\d+)/ || /^\s*(\d+)/) {
            print if $our_pids{$1};
        }
    }
    close $ps;
}

# ═══════════════════════════════════════════════════════════════════════
# Container: spec (generate default config.json)
# ═══════════════════════════════════════════════════════════════════════

sub cmd_spec {
    my (%p) = @_;
    my $bundle = $p{bundle} // '.';
    my $path = "$bundle/config.json";

    if (-e $path && !$p{force}) {
        fatal("$path already exists. Use --force to overwrite.");
    }

    write_file($path, $JSON->encode(default_spec()));
    print "Generated $path\n" unless $p{quiet};
}

# ═══════════════════════════════════════════════════════════════════════
# Container: features
# ═══════════════════════════════════════════════════════════════════════

sub cmd_features {
    my $features = {
        ociVersionMin => '1.0.0',
        ociVersionMax => '1.2.0',
        hooks => [qw(prestart createRuntime createContainer startContainer poststart poststop)],
        mountOptions => [sort (keys %MOUNT_FLAGS, 'idmap', 'ridmap')],
        linux => {
            namespaces => [sort keys %NS_MAP],
            capabilities => [@CAP_NAMES],
            cgroup => {
                v2 => JSON::PP::true,
            },
            seccomp => {
                enabled => JSON::PP::true,
                actions => [qw(SCMP_ACT_KILL SCMP_ACT_KILL_PROCESS SCMP_ACT_TRAP
                              SCMP_ACT_ERRNO SCMP_ACT_NOTIFY SCMP_ACT_LOG SCMP_ACT_ALLOW)],
                operators => [qw(SCMP_CMP_NE SCMP_CMP_LT SCMP_CMP_LE
                                SCMP_CMP_EQ SCMP_CMP_GE SCMP_CMP_GT
                                SCMP_CMP_MASKED_EQ)],
                supportedFlags => [qw(SECCOMP_FILTER_FLAG_TSYNC
                                      SECCOMP_FILTER_FLAG_LOG
                                      SECCOMP_FILTER_FLAG_SPEC_ALLOW)],
            },
            apparmor => { enabled => JSON::PP::false },
            selinux  => { enabled => JSON::PP::false },
        },
        annotations => {
            'org.opencontainers.runtime.nacre' => 'Perl OCI runtime',
        },
    };
    print $JSON->encode($features);
}

# ═══════════════════════════════════════════════════════════════════════
# CLI Argument Parsing and Dispatch
# ═══════════════════════════════════════════════════════════════════════

sub main {
    my $root = $DEFAULT_ROOT;
    my $root_explicit = 0;
    my $log_level = 'warn';
    my $log_format = 'text';
    my $debug = 0;
    my $systemd_cgroup = 0;

    # Parse global options (before command)
    Getopt::Long::Configure('pass_through', 'no_auto_abbrev');
    GetOptions(
        'root=s'           => sub { $root = $_[1]; $root_explicit = 1; },
        'log=s'            => \my $log_file,
        'log-format=s'     => \$log_format,
        'debug'            => \$debug,
        'systemd-cgroup'   => \$systemd_cgroup,
    );

    # Initialize logging subsystem
    setup_logging(
        debug    => $debug,
        log_file => $log_file,
        format   => $log_format,
    );

    my $command = shift @ARGV // usage();

    log_debug("nacre starting, command=$command root=$root");

    # Handle `<command> -h` / `<command> --help` for known subcommands (runc compat)
    my %_known_cmds = map { $_ => 1 } qw(
        create run start delete kill state list ps events pause resume
        update exec spec version checkpoint restore features
    );
    if ($command !~ /^-/ && $command ne 'help'
        && grep { $_ eq '-h' || $_ eq '--help' } @ARGV) {
        if ($_known_cmds{$command}) {
            print "NAME:\n   runc $command\n\nUSAGE:\n   runc $command [options]\n";
            exit(0);
        } else {
            print STDERR "No help topic for '$command'\n";
            exit(1);
        }
    }

    if ($command eq 'create') {
        my ($bundle, $pid_file, $console_socket, $no_pivot, $pidfd_socket);
        GetOptions(
            'bundle|b=s'         => \$bundle,
            'pid-file=s'         => \$pid_file,
            'console-socket=s'   => \$console_socket,
            'pidfd-socket=s'     => \$pidfd_socket,
            'no-pivot'           => \$no_pivot,
        );
        my $id = shift @ARGV // fatal("container id required");
        cmd_create(id => $id, bundle => $bundle, root => $root,
                   pid_file => $pid_file, console_socket => $console_socket,
                   pidfd_socket => $pidfd_socket, no_pivot => $no_pivot);
    }
    elsif ($command eq 'start') {
        my $id = shift @ARGV // fatal("container id required");
        cmd_start(id => $id, root => $root);
    }
    elsif ($command eq 'state') {
        my $id = shift @ARGV // fatal("container id required");
        cmd_state(id => $id, root => $root);
    }
    elsif ($command eq 'kill') {
        my $all = 0;
        GetOptions('all|a' => \$all);
        my $id = shift @ARGV // fatal("container id required");
        my $signal = shift @ARGV // 'TERM';
        cmd_kill(id => $id, root => $root, signal => $signal, all => $all);
    }
    elsif ($command eq 'delete') {
        my $force = 0;
        GetOptions('force|f' => \$force);
        my $id = shift @ARGV // fatal("container id required");
        cmd_delete(id => $id, root => $root, force => $force);
    }
    elsif ($command eq 'run') {
        my ($bundle, $pid_file, $console_socket, $pidfd_socket, $no_pivot, $detach);
        GetOptions(
            'bundle|b=s'         => \$bundle,
            'pid-file=s'         => \$pid_file,
            'console-socket=s'   => \$console_socket,
            'pidfd-socket=s'     => \$pidfd_socket,
            'no-pivot'           => \$no_pivot,
            'detach|d'           => \$detach,
        );
        my $id = shift @ARGV // fatal("container id required");
        cmd_run(id => $id, bundle => $bundle, root => $root,
                pid_file => $pid_file, console_socket => $console_socket,
                pidfd_socket => $pidfd_socket,
                detach => $detach, no_pivot => $no_pivot);
    }
    elsif ($command eq 'list') {
        my ($format, $quiet);
        GetOptions(
            'format|f=s' => \$format,
            'quiet|q'    => \$quiet,
        );
        cmd_list(root => $root, format => $format, quiet => $quiet,
                 root_explicit => $root_explicit);
    }
    elsif ($command eq 'pause') {
        my $id = shift @ARGV // fatal("container id required");
        cmd_pause(id => $id, root => $root);
    }
    elsif ($command eq 'resume') {
        my $id = shift @ARGV // fatal("container id required");
        cmd_resume(id => $id, root => $root);
    }
    elsif ($command eq 'exec') {
        my ($exec_cwd, @exec_env, $exec_user, $detach, $pid_file,
            $console_socket, $pidfd_socket, $tty, $process_file, $ignore_paused,
            $preserve_fds, @additional_gids, @cap_add, $exec_cgroup);
        # Separate exec args: everything after "--" or after container id
        my @before;
        my @exec_cmd;
        my $found_sep = 0;
        for my $arg (@ARGV) {
            if ($arg eq '--' && !$found_sep) {
                $found_sep = 1;
                next;
            }
            if ($found_sep) {
                push @exec_cmd, $arg;
            } else {
                push @before, $arg;
            }
        }
        @ARGV = @before;
        # Stop option parsing at the first non-option (the container id)
        # so that command flags (e.g. chrt -p 1) are not consumed as
        # nacre exec flags.
        Getopt::Long::Configure('require_order');
        GetOptions(
            'cwd=s'             => \$exec_cwd,
            'env|e=s'           => \@exec_env,
            'user|u=s'          => \$exec_user,
            'detach|d'          => \$detach,
            'pid-file=s'        => \$pid_file,
            'console-socket=s'  => \$console_socket,
            'pidfd-socket=s'    => \$pidfd_socket,
            'tty|t'             => \$tty,
            'process|p=s'       => \$process_file,
            'ignore-paused'     => \$ignore_paused,
            'preserve-fds=i'    => \$preserve_fds,
            'additional-gids=i' => \@additional_gids,
            'cap=s'             => \@cap_add,
            'cgroup=s'          => \$exec_cgroup,
        );
        Getopt::Long::Configure('permute');
        my $id = shift @ARGV // fatal("container id required");
        @exec_cmd = @ARGV unless @exec_cmd;
        cmd_exec(id => $id, root => $root, command => \@exec_cmd,
                 cwd => $exec_cwd, env => (@exec_env ? \@exec_env : undef),
                 user => $exec_user, pid_file => $pid_file,
                 preserve_fds => ($preserve_fds // 0),
                 additional_gids => (@additional_gids ? \@additional_gids : undef),
                 ignore_paused => $ignore_paused,
                 process_file => $process_file,
                 tty => $tty, detach => $detach,
                 console_socket => $console_socket,
                 pidfd_socket => $pidfd_socket,
                 exec_cgroup => $exec_cgroup,
                 cap => (@cap_add ? \@cap_add : undef));
    }
    elsif ($command eq 'update') {
        my ($resources, $pids_limit, $cpu_period, $cpu_quota, $cpu_share,
            $cpu_burst, $memory, $memory_swap, $memory_reservation,
            $cpuset_cpus, $cpuset_mems, $cpu_idle);
        GetOptions(
            'resources|r=s'       => \$resources,
            'pids-limit=i'        => \$pids_limit,
            'cpu-period=i'        => \$cpu_period,
            'cpu-quota=i'         => \$cpu_quota,
            'cpu-share=i'         => \$cpu_share,
            'cpu-burst=i'         => \$cpu_burst,
            'memory=s'            => \$memory,
            'memory-swap=s'       => \$memory_swap,
            'memory-reservation=s' => \$memory_reservation,
            'cpuset-cpus=s'       => \$cpuset_cpus,
            'cpuset-mems=s'       => \$cpuset_mems,
            'cpu-idle=i'          => \$cpu_idle,
        );
        my $id = shift @ARGV // fatal("container id required");
        cmd_update(id => $id, root => $root, resources => $resources,
                   pids_limit => $pids_limit, cpu_period => $cpu_period,
                   cpu_quota => $cpu_quota, cpu_share => $cpu_share,
                   cpu_burst => $cpu_burst, memory => $memory,
                   memory_swap => $memory_swap,
                   memory_reservation => $memory_reservation,
                   cpuset_cpus => $cpuset_cpus, cpuset_mems => $cpuset_mems,
                   cpu_idle => $cpu_idle);
    }
    elsif ($command eq 'events') {
        my ($interval, $stats);
        GetOptions(
            'interval|i=s' => \$interval,
            'stats'        => \$stats,
        );
        my $id = shift @ARGV // fatal("container id required");
        cmd_events(id => $id, root => $root, interval => $interval, stats => $stats);
    }
    elsif ($command eq 'ps') {
        my $format;
        GetOptions('format|f=s' => \$format);
        my $id = shift @ARGV // fatal("container id required");
        cmd_ps(id => $id, root => $root, format => $format, ps_args => \@ARGV);
    }
    elsif ($command eq 'spec') {
        my ($bundle, $force);
        GetOptions(
            'bundle|b=s' => \$bundle,
            'force'      => \$force,
        );
        cmd_spec(bundle => $bundle, force => $force);
    }
    elsif ($command eq 'features') {
        cmd_features();
    }
    elsif ($command eq '--help' || $command eq '-h' || $command eq 'help') {
        usage();
    }
    elsif ($command eq '--version' || $command eq '-v' || $command eq 'version') {
        use Config;
        # runc-compatible format for interoperability
        print "runc version 1.2.0-nacre\n";
        print "commit: nacre-0.5.1\n";
        print "spec: 1.2.0\n";
        print "go: n/a (perl $Config{archname})\n";
    }
    else {
        # runc compat: unknown command with -h prints "No help topic"
        if (@ARGV && ($ARGV[0] eq '-h' || $ARGV[0] eq '--help')) {
            print STDERR "No help topic for '$command'\n";
            exit(1);
        }
        fatal("unknown command: $command");
    }
}

sub usage {
    print <<'USAGE';
NAME:
   runc - Open Container Initiative runtime (nacre)

USAGE:
   runc [global options] command [command options] [arguments...]

COMMANDS:
     checkpoint  checkpoint a running container (not supported)
     create      create a container
     delete      delete any resources held by the container
     events      display container events such as OOM notifications, cpu, memory, and IO usage statistics
     exec        execute new process inside the container
     kill        kill sends the specified signal to the container's init process
     list        lists containers started by runc with the given root
     pause       pause suspends all processes inside the container
     ps          ps displays the processes running inside a container
     restore     restore a container from a previous checkpoint (not supported)
     resume      resumes all processes that have been previously paused
     run         create and run a container
     spec        create a new specification file
     start       executes the user defined process in a created container
     state       output the state of a container
     update      update container resource constraints
     features    show the enabled features

GLOBAL OPTIONS:
   --debug             enable debug output for logging
   --log value         set the log file path where internal debug information is written
   --log-format value  set the format used by logs ('text' (default), or 'json') (default: "text")
   --root value        root directory for storage of container state (default: "/run/nacre")
   --help, -h          show help
   --version, -v       print the version
USAGE
    exit(0);
}

# Run
eval { main() };
if ($@) {
    my $msg = $@;
    chomp $msg;
    # Print error to stderr (fatal() already formatted it)
    print STDERR "$msg\n" unless $msg eq '';
    exit 1;
}
