# ═══════════════════════════════════════════════════════════════════════
# Container State
# ═══════════════════════════════════════════════════════════════════════

sub state_dir {
    my ($root, $id) = @_;
    return "$root/$id";
}

sub load_state {
    my ($root, $id) = @_;
    my $path = state_dir($root, $id) . '/state.json';
    my $raw = read_file($path);
    fatal("container '$id' does not exist") unless defined $raw;
    my $state = $JSON->decode($raw);
    refresh_state($state);
    return $state;
}

sub save_state {
    my ($root, $state) = @_;
    my $dir = state_dir($root, $state->{id});
    ensure_dir($dir);
    write_file_atomic("$dir/state.json", $JSON->encode($state));
}

sub delete_state {
    my ($root, $id) = @_;
    my $dir = state_dir($root, $id);
    remove_tree($dir) if -d $dir;
}

sub refresh_state {
    my ($state) = @_;
    my $pid = $state->{pid};
    return unless $pid && $pid > 0;
    my $status = $state->{status};
    return if $status eq 'stopped';

    # Check if process is alive
    my $stat = read_file("/proc/$pid/stat");
    if (!defined $stat) {
        $state->{status} = 'stopped';
        $state->{pid} = 0;
        return;
    }

    # PID reuse detection via starttime
    if ($state->{pidStartTime}) {
        my $current_start = parse_proc_starttime($stat);
        if (defined $current_start && $current_start ne $state->{pidStartTime}) {
            $state->{status} = 'stopped';
            $state->{pid} = 0;
            return;
        }
    }

    # Check zombie/dead
    if ($stat =~ /\)\s+([RSDZTW])/) {
        my $proc_state = $1;
        if ($proc_state eq 'Z' || $proc_state eq 'X') {
            $state->{status} = 'stopped';
        }
    }
}

sub parse_proc_starttime {
    my ($stat_line) = @_;
    # /proc/pid/stat: pid (comm) state ppid pgrp session tty_nr tpgid flags
    #   minflt cminflt majflt cmajflt utime stime cutime cstime priority nice
    #   num_threads itrealvalue starttime ...
    # comm can contain spaces and parens, so find the last ')'
    if ($stat_line =~ /\)\s+\S+\s+          # state
                        \S+\s+\S+\s+\S+\s+  # ppid pgrp session
                        \S+\s+\S+\s+\S+\s+  # tty tpgid flags
                        \S+\s+\S+\s+\S+\s+  # minflt cminflt majflt
                        \S+\s+\S+\s+\S+\s+  # cmajflt utime stime
                        \S+\s+\S+\s+\S+\s+  # cutime cstime priority
                        \S+\s+\S+\s+\S+\s+  # nice threads itrealvalue
                        (\S+)/x) {
        return $1;
    }
    return undef;
}

sub get_pid_starttime {
    my ($pid) = @_;
    my $stat = read_file("/proc/$pid/stat");
    return undef unless $stat;
    return parse_proc_starttime($stat);
}

sub oci_state_json {
    my ($state) = @_;
    my $out = {
        ociVersion  => $state->{ociVersion} // '1.2.0',
        id          => $state->{id},
        status      => $state->{status},
        bundle      => $state->{bundle},
        annotations => $state->{annotations} // {},
        created     => $state->{created} // '',
    };
    # OCI spec: pid MUST NOT be present when the container is stopped
    if ($state->{status} ne 'stopped') {
        $out->{pid} = $state->{pid} + 0;
    }
    return $out;
}

# ═══════════════════════════════════════════════════════════════════════
# Cgroup v2
# ═══════════════════════════════════════════════════════════════════════

my $CGROUP_ROOT = '/sys/fs/cgroup';

sub cgroup_path {
    my ($spec, $id) = @_;
    my $rel = $spec->{linux}{cgroupsPath};
    if ($rel && $rel =~ m{^/}) {
        return "$CGROUP_ROOT$rel";
    } elsif ($rel) {
        return "$CGROUP_ROOT/nacre/$rel";
    } else {
        return "$CGROUP_ROOT/nacre/$id";
    }
}

sub cgroup_setup {
    my ($cgpath, $spec) = @_;

    # Check if cgroup already exists and has processes (non-empty cgroup)
    if (-d $cgpath) {
        my $procs = read_file("$cgpath/cgroup.procs");
        if (defined $procs && $procs =~ /\d/) {
            fatal("container's cgroup is not empty: $cgpath");
        }
        # Check if cgroup is frozen
        my $freeze = read_file("$cgpath/cgroup.freeze");
        if (defined $freeze) {
            chomp $freeze;
            if ($freeze eq '1') {
                fatal("container's cgroup is frozen: $cgpath");
            }
        }
    }

    ensure_dir($cgpath);

    # Enable controllers up the tree
    my @parts = split m{/}, $cgpath;
    my $root_parts = scalar(split m{/}, $CGROUP_ROOT);
    for my $depth ($root_parts .. $#parts - 1) {
        my $ancestor = join('/', @parts[0..$depth]);
        my $sc_file = "$ancestor/cgroup.subtree_control";
        next unless -f $sc_file;
        my $current = read_file($sc_file) // '';
        for my $ctrl (qw(cpu memory pids io cpuset hugetlb)) {
            if ($current !~ /\b$ctrl\b/) {
                eval { write_file($sc_file, "+$ctrl\n"); };
            }
        }
    }

    # Apply resources
    cgroup_apply_resources($cgpath, $spec);
}

sub cgroup_apply_resources {
    log_debug("applying cgroup resources");
    my ($cgpath, $spec, %opts) = @_;
    my $res = $spec->{linux}{resources} // {};

    # Memory
    if (my $mem = $res->{memory}) {
        cg_write($cgpath, 'memory.max',      $mem->{limit})       if defined $mem->{limit};
        cg_write($cgpath, 'memory.low',      $mem->{reservation}) if defined $mem->{reservation};
        cg_write($cgpath, 'memory.swap.max', $mem->{swap})        if defined $mem->{swap};
    }

    # CPU
    if (my $cpu = $res->{cpu}) {
        if (defined $cpu->{shares}) {
            my $weight = convert_cpu_shares($cpu->{shares});
            cg_write($cgpath, 'cpu.weight', $weight);
        }
        if (defined $cpu->{quota} || defined $cpu->{period}) {
            my $quota  = $cpu->{quota}  // 'max';
            my $period = $cpu->{period} // 100000;
            cg_write($cgpath, 'cpu.max', "$quota $period");
        }
        if (defined $cpu->{burst}) {
            cg_write($cgpath, 'cpu.max.burst', $cpu->{burst});
        }
        if (defined $cpu->{idle}) {
            cg_write($cgpath, 'cpu.idle', $cpu->{idle});
        }
        cg_write($cgpath, 'cpuset.cpus', $cpu->{cpus}) if defined $cpu->{cpus};
        cg_write($cgpath, 'cpuset.mems', $cpu->{mems}) if defined $cpu->{mems};
    }

    # PIDs
    if (my $pids = $res->{pids}) {
        unless ($opts{defer_pids}) {
            my $max = $pids->{limit} // 'max';
            if ($max eq 'max' || $max < 0) {
                $max = 'max';
            } elsif ($max == 0) {
                # pids.limit=0 means 1 (minimum useful value)
                $max = 1;
            }
            cg_write($cgpath, 'pids.max', $max);
        }
    }

    # Hugepages
    if (my $hp = $res->{hugepageLimits}) {
        for my $entry (@$hp) {
            my $size = $entry->{pageSize} // next;
            my $limit = $entry->{limit} // next;
            cg_write($cgpath, "hugetlb.${size}.max", $limit);
        }
    }

    # Block IO
    if (my $bio = $res->{blockIO}) {
        if (defined $bio->{weight}) {
            my $weight = $bio->{weight};
            cg_write($cgpath, 'io.weight', "default $weight");
        }
        if (my $tbd = $bio->{throttleReadBpsDevice}) {
            for my $d (@$tbd) {
                cg_write($cgpath, 'io.max', "$d->{major}:$d->{minor} rbps=$d->{rate}");
            }
        }
        if (my $tbd = $bio->{throttleWriteBpsDevice}) {
            for my $d (@$tbd) {
                cg_write($cgpath, 'io.max', "$d->{major}:$d->{minor} wbps=$d->{rate}");
            }
        }
    }

    # Unified (raw cgroup file writes)
    if (my $u = $res->{unified}) {
        for my $key (keys %$u) {
            cg_write($cgpath, $key, $u->{$key});
        }
    }
}

sub cgroup_add_process {
    my ($cgpath, $pid) = @_;
    cg_write($cgpath, 'cgroup.procs', $pid);
}

sub cgroup_cleanup {
    my ($cgpath) = @_;
    return unless -d $cgpath;

    # Kill all processes in the cgroup
    my $procs = read_file("$cgpath/cgroup.procs") // '';
    for my $pid (split /\n/, $procs) {
        next unless $pid =~ /^\d+$/;
        kill 9, $pid;
    }

    # Wait a bit for processes to die
    my $deadline = time + 2;
    while (time < $deadline) {
        $procs = read_file("$cgpath/cgroup.procs") // '';
        last unless $procs =~ /\d/;
        select(undef, undef, undef, 0.05);
    }

    # Remove cgroup directory with retry (EBUSY)
    for my $attempt (1..10) {
        last if rmdir($cgpath);
        last unless $! == EBUSY;
        select(undef, undef, undef, 0.05 * $attempt);
    }
}

sub cgroup_pids {
    my ($cgpath) = @_;
    my $data = read_file("$cgpath/cgroup.procs") // '';
    return grep { /^\d+$/ } split /\n/, $data;
}

sub cg_write {
    my ($cgpath, $file, $value) = @_;
    my $path = "$cgpath/$file";
    eval { write_file($path, "$value\n"); };
    # Non-fatal: some cgroup files may not exist
}

sub convert_cpu_shares {
    my ($shares) = @_;
    return 100 if !$shares || $shares < 2;
    return 1 if $shares == 2;
    return int(1 + (($shares - 2) * 9999 / 262142));
}

# ═══════════════════════════════════════════════════════════════════════
# Mount / Rootfs
# ═══════════════════════════════════════════════════════════════════════

my %MOUNT_FLAGS = (
    bind        => MS_BIND,
    rbind       => MS_BIND | MS_REC,
    ro          => MS_RDONLY,
    rw          => 0,
    nosuid      => MS_NOSUID,
    suid        => 0,
    nodev       => MS_NODEV,
    dev         => 0,
    noexec      => MS_NOEXEC,
    exec        => 0,
    noatime     => MS_NOATIME,
    atime       => 0,
    nodiratime  => MS_NODIRATIME,
    diratime    => 0,
    relatime    => MS_RELATIME,
    norelatime  => 0,
    strictatime => MS_STRICTATIME,
    nostrictatime => 0,
    remount     => MS_REMOUNT,
    sync        => 16,     # MS_SYNCHRONOUS
    async       => 0,
    dirsync     => 128,    # MS_DIRSYNC
    silent      => MS_SILENT,
    loud        => 0,
    slave       => MS_SLAVE,
    rslave      => MS_SLAVE | MS_REC,
    private     => MS_PRIVATE,
    rprivate    => MS_PRIVATE | MS_REC,
    shared      => MS_SHARED,
    rshared     => MS_SHARED | MS_REC,
    unbindable  => MS_UNBINDABLE,
    runbindable => MS_UNBINDABLE | MS_REC,
    readonly    => MS_RDONLY,
);

sub parse_mount_options {
    my ($opts_ref) = @_;
    my $flags = 0;
    my @data;
    for my $opt (@{$opts_ref // []}) {
        if (exists $MOUNT_FLAGS{$opt}) {
            $flags |= $MOUNT_FLAGS{$opt};
        } else {
            push @data, $opt;
        }
    }
    return ($flags, join(',', @data));
}

sub do_mount {
    my ($src, $target, $fstype, $flags, $data) = @_;
    # Perl's syscall() passes strings as pointers, integers as values.
    # The kernel's mount(2) expects NULL pointers for unused args, not
    # pointers to empty strings (which it tries to resolve as paths → ENOENT).
    #
    # IMPORTANT: we call syscall() directly here instead of going through
    # do_syscall(), because Perl's @_ aliasing chain corrupts the argument
    # types when mixing integer 0 (NULL pointer) and string arguments.
    # Fresh lexical scalars with + 0 coercion guarantee clean IOK-only SVs.
    my $nr       = SYS_mount + 0;
    my $src_arg  = (defined $src    && $src    ne '') ? ($src    . "\0") : 0;
    my $tgt_arg  = $target . "\0";
    my $fs_arg   = (defined $fstype && $fstype ne '') ? ($fstype . "\0") : 0;
    my $fl       = $flags + 0;
    my $data_arg = (defined $data   && $data   ne '') ? ($data   . "\0") : 0;
    my $ret;
    do {
        $ret = syscall($nr, $src_arg, $tgt_arg, $fs_arg, $fl, $data_arg);
    } while ($ret == -1 && $! == EINTR);
    return $ret == 0;
}

sub do_umount {
    my ($target, $flags) = @_;
    $flags //= 0;
    my $nr  = SYS_umount2 + 0;
    my $tgt = $target . "\0";
    my $fl  = $flags + 0;
    my $ret;
    do { $ret = syscall($nr, $tgt, $fl) } while ($ret == -1 && $! == EINTR);
    return $ret == 0;
}

sub do_pivot_root {
    my ($new_root, $put_old) = @_;
    my $nr  = SYS_pivot_root + 0;
    my $nrt = $new_root . "\0";
    my $pot = $put_old . "\0";
    my $ret;
    do { $ret = syscall($nr, $nrt, $pot) } while ($ret == -1 && $! == EINTR);
    return $ret == 0;
}

# Default devices to create
my @DEFAULT_DEVICES = (
    { path => '/dev/null',    type => 'c', major => 1, minor => 3, mode => 0o666 },
    { path => '/dev/zero',    type => 'c', major => 1, minor => 5, mode => 0o666 },
    { path => '/dev/full',    type => 'c', major => 1, minor => 7, mode => 0o666 },
    { path => '/dev/random',  type => 'c', major => 1, minor => 8, mode => 0o666 },
    { path => '/dev/urandom', type => 'c', major => 1, minor => 9, mode => 0o666 },
    { path => '/dev/tty',     type => 'c', major => 5, minor => 0, mode => 0o666 },
);

# Default symlinks for /dev
my @DEFAULT_SYMLINKS = (
    { path => '/dev/fd',     target => '/proc/self/fd'     },
    { path => '/dev/stdin',  target => '/proc/self/fd/0'   },
    { path => '/dev/stdout', target => '/proc/self/fd/1'   },
    { path => '/dev/stderr', target => '/proc/self/fd/2'   },
    { path => '/dev/ptmx',   target => 'pts/ptmx'          },
);

my %PROPAGATION_FLAGS = (
    slave    => MS_SLAVE    | MS_REC,
    rslave   => MS_SLAVE    | MS_REC,
    private  => MS_PRIVATE  | MS_REC,
    rprivate => MS_PRIVATE  | MS_REC,
    shared   => MS_SHARED   | MS_REC,
    rshared  => MS_SHARED   | MS_REC,
    unbindable  => MS_UNBINDABLE | MS_REC,
    runbindable => MS_UNBINDABLE | MS_REC,
);

sub prepare_rootfs {
    my ($spec, $rootfs) = @_;

    # During setup, use slave propagation to prevent mount events from
    # leaking to the parent mount namespace.  The spec's requested
    # propagation is applied AFTER pivot_root (see apply_rootfs_propagation).
    do_mount('', '/', '', MS_SLAVE | MS_REC, '')
        or fatal("mount propagation (setup) /: $!");

    # Bind mount rootfs on itself
    do_mount($rootfs, $rootfs, '', MS_BIND | MS_REC, '')
        or fatal("bind mount rootfs: $!");

    # Apply spec mounts
    apply_mounts($spec, $rootfs);

    # Create default devices via bind mount
    create_devices($rootfs, $spec);

    # Create default symlinks
    create_symlinks($rootfs);
}

sub apply_mounts {
    my ($spec, $rootfs) = @_;
    log_debug("applying mounts, rootfs=$rootfs");
    for my $m (@{$spec->{mounts} // []}) {
        my $dest = "$rootfs$m->{destination}";
        my $mount_src = $m->{source} // '';
        # For bind mounts of files, create a file mount point instead of dir
        if ($mount_src ne '' && -f $mount_src && grep { $_ eq 'bind' || $_ eq 'rbind' } @{$m->{options} // []}) {
            my $parent = dirname($dest);
            ensure_dir($parent);
            if (!-e $dest) {
                open my $fh, '>', $dest;
                close $fh if $fh;
            }
        } else {
            ensure_dir($dest);
        }

        my ($flags, $data) = parse_mount_options($m->{options});
        my $type = $m->{type} // '';
        my $src  = $m->{source} // $type;

        if ($flags & MS_BIND) {
            # Bind mount
            do_mount($src, $dest, '', $flags, '')
                or do { warn "nacre: mount bind $dest: $!\n"; next; };
            # Apply remaining flags via remount
            if ($flags & ~(MS_BIND | MS_REC)) {
                do_mount('', $dest, '', MS_REMOUNT | MS_BIND | ($flags & ~MS_REC), '')
                    or warn "nacre: remount $dest: $!\n";
            }
        } else {
            do_mount($src, $dest, $type, $flags, $data)
                or do { warn "nacre: mount $type on $dest: $!\n"; next; };
        }
    }
}

sub create_devices {
    my ($rootfs, $spec) = @_;

    my @devices = @DEFAULT_DEVICES;

    # Spec devices override defaults by path
    for my $d (@{$spec->{linux}{devices} // []}) {
        my $spec_dev = {
            path  => $d->{path},
            type  => $d->{type} // 'c',
            major => $d->{major} // 0,
            minor => $d->{minor} // 0,
            mode  => $d->{fileMode} // 0o666,
            uid   => $d->{uid},
            gid   => $d->{gid},
        };
        my $found = 0;
        for my $i (0..$#devices) {
            if ($devices[$i]{path} eq $spec_dev->{path}) {
                $devices[$i] = $spec_dev;
                $found = 1;
                last;
            }
        }
        push @devices, $spec_dev unless $found;
    }

    for my $dev (@devices) {
        my $dest = "$rootfs$dev->{path}";
        my $dir = dirname($dest);
        ensure_dir($dir);

        # Try bind mount from host first (works in user namespaces)
        my $host_dev = $dev->{path};
        if (-e $host_dev) {
            # Create empty file as mount point
            if (!-e $dest) {
                open my $fh, '>', $dest;
                close $fh if $fh;
            }
            if (do_mount($host_dev, $dest, '', MS_BIND, '')) {
                next;  # success
            }
        }

        # Fallback: mknod (requires privileges)
        unlink $dest;
        my $dev_num = (($dev->{major} << 8) | $dev->{minor}) + 0;
        my $ftype = $dev->{type} eq 'b' ? S_IFBLK : S_IFCHR;
        my $mode  = ($ftype | ($dev->{mode} & 0o7777)) + 0;
        my $path  = $dest . "\0";
        my $ret;
        if (SYS_mknod > 0) {
            my $nr = SYS_mknod + 0;
            do { $ret = syscall($nr, $path, $mode, $dev_num) }
                while ($ret == -1 && $! == EINTR);
        } else {
            # aarch64: use mknodat with AT_FDCWD (-100)
            my $nr    = SYS_mknodat + 0;
            my $dirfd = -100 + 0;
            do { $ret = syscall($nr, $dirfd, $path, $mode, $dev_num) }
                while ($ret == -1 && $! == EINTR);
        }
        if ($ret != 0) {
            # Non-fatal in user namespaces
            next;
        }
        if (defined $dev->{uid} || defined $dev->{gid}) {
            chown($dev->{uid} // -1, $dev->{gid} // -1, $dest);
        }
    }
}

sub create_symlinks {
    my ($rootfs) = @_;
    for my $s (@DEFAULT_SYMLINKS) {
        my $dest = "$rootfs$s->{path}";
        next if -e $dest || -l $dest;
        symlink($s->{target}, $dest);
    }
}

sub apply_pivot_root {
    log_debug("applying pivot_root");
    my ($rootfs) = @_;
    chdir($rootfs) or fatal("chdir to rootfs: $!");

    # pivot_root(".", ".") — old root ends up mounted atop new root
    do_pivot_root('.', '.') or fatal("pivot_root: $!");

    # Unmount old root (lazy)
    do_umount('.', MNT_DETACH) or fatal("umount old root: $!");

    chdir('/') or fatal("chdir /: $!");
}

sub apply_rootfs_propagation {
    # Apply the spec's rootfsPropagation AFTER pivot_root, so setup
    # operations (bind mounts, device creation) run under safe slave
    # propagation and the final container root gets the requested type.
    my ($spec) = @_;
    my $propagation = $spec->{linux}{rootfsPropagation} // 'rslave';
    my $prop_flags = $PROPAGATION_FLAGS{$propagation} // (MS_SLAVE | MS_REC);
    do_mount('', '/', '', $prop_flags, '')
        or fatal("mount propagation ($propagation) /: $!");
}

sub apply_masked_paths {
    my ($paths) = @_;
    for my $p (@{$paths // []}) {
        # Security: refuse to mask through symlinks — a symlink at /proc
        # or /sys could redirect the mask to an attacker-controlled path.
        if (-l $p) {
            warn "nacre: maskedPaths: refusing to mask symlink $p\n";
            next;
        }
        # Check for symlink components in the path (resolve and compare)
        my $resolved = eval { Cwd::abs_path($p) };
        if (defined $resolved && $resolved ne $p) {
            # Path contains symlink components — skip silently for safety
            # (runc also skips these)
            next;
        }
        if (-d $p) {
            do_mount('tmpfs', $p, 'tmpfs', MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC, 'size=0');
        } elsif (-e $p) {
            do_mount('/dev/null', $p, '', MS_BIND, '');
        }
    }
}

sub apply_readonly_paths {
    my ($paths) = @_;
    for my $p (@{$paths // []}) {
        next unless -e $p;
        do_mount($p, $p, '', MS_BIND | MS_REC, '');
        do_mount('', $p, '', MS_REMOUNT | MS_BIND | MS_RDONLY | MS_REC, '');
    }
}

sub set_rootfs_readonly {
    my ($rootfs_readonly) = @_;
    return unless $rootfs_readonly;
    do_mount('', '/', '', MS_REMOUNT | MS_BIND | MS_RDONLY, '')
        or fatal("remount / readonly: $!");
}

# ═══════════════════════════════════════════════════════════════════════
# Capabilities
# ═══════════════════════════════════════════════════════════════════════

sub validate_capabilities {
    # OCI spec: "Any value which cannot be mapped to a relevant kernel
    # interface MUST cause an error."
    my ($spec) = @_;
    return unless $spec->{process};  # avoid auto-vivifying {process}
    my $caps = $spec->{process}{capabilities} // return;
    for my $set (qw(bounding effective permitted inheritable ambient)) {
        for my $name (@{$caps->{$set} // []}) {
            exists $CAP_NUM{$name}
                or fatal("unknown capability '$name' in $set set");
        }
    }
}

sub apply_capabilities_bounding {
    # Phase 1: Drop bounding caps and set KEEPCAPS.
    # Must be called BEFORE setuid/setgid so that KEEPCAPS preserves the
    # permitted set across the UID transition.
    my ($spec) = @_;
    my $caps = $spec->{process}{capabilities} // return;

    # Drop bounding set
    if (my $bounding = $caps->{bounding}) {
        my %keep = map { $_ => 1 } @$bounding;
        for my $name (@CAP_NAMES) {
            next if $keep{$name};
            my $num = $CAP_NUM{$name} // next;
            do_syscall(SYS_prctl, PR_CAPBSET_DROP, $num, 0, 0, 0);
        }
    }

    # Keep caps across setuid (cleared in phase 2)
    do_syscall(SYS_prctl, PR_SET_KEEPCAPS, 1, 0, 0, 0);
}

sub apply_capabilities_final {
    # Phase 2: Set effective/permitted/inheritable/ambient caps.
    # Must be called AFTER setuid/setgid — the kernel cleared the effective
    # set during setuid but preserved permitted (KEEPCAPS was on).
    my ($spec) = @_;
    my $caps = $spec->{process}{capabilities} // return;

    my ($eff_lo, $eff_hi) = (0, 0);
    my ($prm_lo, $prm_hi) = (0, 0);
    my ($inh_lo, $inh_hi) = (0, 0);

    for my $name (@{$caps->{effective} // []}) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $eff_lo |= (1 << $n); } else { $eff_hi |= (1 << ($n - 32)); }
    }
    for my $name (@{$caps->{permitted} // []}) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $prm_lo |= (1 << $n); } else { $prm_hi |= (1 << ($n - 32)); }
    }
    for my $name (@{$caps->{inheritable} // []}) {
        my $n = $CAP_NUM{$name} // next;
        if ($n < 32) { $inh_lo |= (1 << $n); } else { $inh_hi |= (1 << ($n - 32)); }
    }

    # capset: header (version, pid) + data[2] (effective, permitted, inheritable)
    my $hdr = pack('Ii', _LINUX_CAPABILITY_VERSION_3, 0);
    my $data = pack('III III',
        $eff_lo, $prm_lo, $inh_lo,
        $eff_hi, $prm_hi, $inh_hi);
    my $nr_capset = SYS_capset + 0;
    syscall($nr_capset, $hdr, $data);

    # Clear keepcaps
    do_syscall(SYS_prctl, PR_SET_KEEPCAPS, 0, 0, 0, 0);

    # Raise ambient capabilities
    for my $name (@{$caps->{ambient} // []}) {
        my $n = $CAP_NUM{$name} // next;
        do_syscall(SYS_prctl, PR_CAP_AMBIENT, PR_CAP_AMBIENT_RAISE, $n, 0, 0);
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Seccomp (via dlopen/dlsym of libseccomp)
# ═══════════════════════════════════════════════════════════════════════

# We'll use Perl's DynaLoader to call libseccomp functions
# This avoids the FFI::Platypus dependency

my $SECCOMP_AVAILABLE = 0;
my $LIBSECCOMP;

sub init_libseccomp {
    eval {
        require DynaLoader;
        $LIBSECCOMP = DynaLoader::dl_load_file('/usr/lib/x86_64-linux-gnu/libseccomp.so.2', 0);
        $SECCOMP_AVAILABLE = 1 if $LIBSECCOMP;
    };
}

# Seccomp actions
use constant {
    SCMP_ACT_KILL         => 0x00000000,
    SCMP_ACT_KILL_PROCESS => 0x80000000,
    SCMP_ACT_TRAP         => 0x00030000,
    SCMP_ACT_NOTIFY       => 0x7fc00000,
    SCMP_ACT_LOG          => 0x7ffc0000,
    SCMP_ACT_ALLOW        => 0x7fff0000,
    SCMP_ACT_ERRNO_BASE   => 0x00050000,
};

# For now, seccomp via raw BPF when libseccomp isn't available via FFI
# The full libseccomp integration requires FFI::Platypus
sub apply_seccomp_raw {
    my ($spec) = @_;
    my $seccomp = $spec->{linux}{seccomp} // return;

    # If FFI::Platypus is available, use it
    if (eval { require FFI::Platypus; 1 }) {
        return apply_seccomp_ffi($spec);
    }

    # Fallback: build and load BPF program directly via seccomp(2)
    apply_seccomp_minimal($seccomp);
}

sub apply_seccomp_ffi {
    my ($spec) = @_;
    my $seccomp = $spec->{linux}{seccomp} // return;

    require FFI::Platypus;
    my $ffi = FFI::Platypus->new(api => 2);
    $ffi->lib('/usr/lib/x86_64-linux-gnu/libseccomp.so.2');

    # Attach libseccomp functions
    $ffi->attach('seccomp_init'           => ['uint32'] => 'opaque');
    $ffi->attach('seccomp_arch_add'       => ['opaque', 'uint32'] => 'int');
    $ffi->attach('seccomp_rule_add'       => ['opaque', 'uint32', 'int', 'uint'] => 'int', sub {
        my ($xsub, @args) = @_;
        return $xsub->(@args);
    });
    $ffi->attach('seccomp_syscall_resolve_name' => ['string'] => 'int');
    $ffi->attach('seccomp_load'           => ['opaque'] => 'int');
    $ffi->attach('seccomp_release'        => ['opaque'] => 'void');
    $ffi->attach('seccomp_export_bpf'     => ['opaque', 'int'] => 'int');
    $ffi->attach('seccomp_attr_set'       => ['opaque', 'uint32', 'uint32'] => 'int');

    # Map OCI action to libseccomp action
    my %action_map = (
        SCMP_ACT_KILL         => SCMP_ACT_KILL,
        SCMP_ACT_KILL_PROCESS => SCMP_ACT_KILL_PROCESS,
        SCMP_ACT_TRAP         => SCMP_ACT_TRAP,
        SCMP_ACT_NOTIFY       => SCMP_ACT_NOTIFY,
        SCMP_ACT_LOG          => SCMP_ACT_LOG,
        SCMP_ACT_ALLOW        => SCMP_ACT_ALLOW,
    );

    my $default_action_str = $seccomp->{defaultAction} // 'SCMP_ACT_ALLOW';
    my $default_action;
    if ($default_action_str =~ /^SCMP_ACT_ERRNO\((\d+)\)$/) {
        $default_action = SCMP_ACT_ERRNO_BASE | ($1 & 0xffff);
    } else {
        $default_action = $action_map{$default_action_str}
            // fatal("unknown seccomp action: $default_action_str");
    }

    my $ctx = seccomp_init($default_action)
        or fatal("seccomp_init failed");

    # Disable NNP control (we handle it ourselves)
    seccomp_attr_set($ctx, 2, 0);  # SCMP_FLTATR_CTL_NNP = 2

    # Add architectures
    my %arch_map = (
        SCMP_ARCH_X86_64  => 0xc000003e,
        SCMP_ARCH_X86     => 0x40000003,
        SCMP_ARCH_AARCH64 => 0xc00000b7,
        SCMP_ARCH_ARM     => 0x40000028,
    );

    for my $arch (@{$seccomp->{architectures} // []}) {
        my $arch_val = $arch_map{$arch} // next;
        seccomp_arch_add($ctx, $arch_val);
    }

    # defaultErrnoRet: if set, SCMP_ACT_ERRNO without explicit errno uses this value
    my $ffi_default_errno_ret = $seccomp->{defaultErrnoRet};

    # Add syscall rules
    for my $rule (@{$seccomp->{syscalls} // []}) {
        my $action_str = $rule->{action} // $default_action_str;
        my $action;
        if ($action_str eq 'SCMP_ACT_ERRNO' && defined $ffi_default_errno_ret) {
            $action = SCMP_ACT_ERRNO_BASE | ($ffi_default_errno_ret & 0xffff);
        } elsif ($action_str =~ /^SCMP_ACT_ERRNO\((\d+)\)$/) {
            $action = SCMP_ACT_ERRNO_BASE | ($1 & 0xffff);
        } else {
            $action = $action_map{$action_str} // next;
        }

        for my $name (@{$rule->{names} // []}) {
            my $nr = seccomp_syscall_resolve_name($name);
            next if $nr < 0;
            seccomp_rule_add($ctx, $action, $nr, 0);
        }
    }

    # Export BPF and load via raw seccomp syscall (bypasses NNP)
    # Create a pipe to capture the BPF program
    pipe(my $rd, my $wr) or fatal("pipe for seccomp export: $!");
    my $fd = fileno($wr);
    my $ret = seccomp_export_bpf($ctx, $fd);
    close $wr;

    if ($ret == 0) {
        # Read the BPF program
        local $/;
        my $bpf_prog = <$rd>;
        close $rd;

        if (defined $bpf_prog && length $bpf_prog >= 8) {
            # BPF program format: struct sock_fprog { unsigned short len; struct sock_filter *filter; }
            # But seccomp_export_bpf writes raw sock_filter array
            my $filter_count = length($bpf_prog) / 8;  # each sock_filter is 8 bytes
            my $sock_fprog = pack('S x![P] P', $filter_count, unpack('Q', pack('P', $bpf_prog)));

            my $nr_sec = SYS_seccomp + 0;
            my $op     = SECCOMP_SET_MODE_FILTER + 0;
            # Map OCI seccomp.flags to kernel flag bits
            my %ffi_flag_map = (
                SECCOMP_FILTER_FLAG_TSYNC     => SECCOMP_FILTER_FLAG_TSYNC,
                SECCOMP_FILTER_FLAG_LOG       => SECCOMP_FILTER_FLAG_LOG,
                SECCOMP_FILTER_FLAG_SPEC_ALLOW => (1 << 2),
                SECCOMP_FILTER_FLAG_NEW_LISTENER => SECCOMP_FILTER_FLAG_NEW_LISTENER,
                SECCOMP_FILTER_FLAG_WAIT_KILLABLE_RECV => SECCOMP_FILTER_FLAG_WAIT_KILLABLE_RECV,
            );
            my $fl = 0;
            for my $fn (@{$seccomp->{flags} // []}) {
                $fl |= ($ffi_flag_map{$fn} // 0);
            }
            $fl += 0;
            syscall($nr_sec, $op, $fl, $sock_fprog);
        }
    } else {
        close $rd;
        # Fallback to seccomp_load (sets NNP)
        seccomp_load($ctx);
    }

    seccomp_release($ctx);
}

my %_SYSCALL_NR;   # lazily populated from system headers

sub _init_syscall_table {
    return if %_SYSCALL_NR;
    require Config;
    my $arch = $Config::Config{archname} // '';

    my @hdrs;
    if ($arch =~ /x86_64|amd64/i) {
        @hdrs = (
            '/usr/include/x86_64-linux-gnu/asm/unistd_64.h',
            '/usr/include/asm/unistd_64.h',
        );
    } elsif ($arch =~ /aarch64|arm64/i) {
        @hdrs = (
            '/usr/include/aarch64-linux-gnu/asm/unistd.h',
            '/usr/include/asm-generic/unistd.h',
        );
    } else {
        @hdrs = ('/usr/include/asm/unistd.h');
    }

    for my $hdr (@hdrs) {
        open my $fh, '<', $hdr or next;
        while (<$fh>) {
            $_SYSCALL_NR{$1} = $2 + 0
                if /^\s*#\s*define\s+__NR(?:3264)?_(\w+)\s+(\d+)/;
        }
        close $fh;
        last if %_SYSCALL_NR;
    }
}

sub _resolve_seccomp_syscall {
    my ($name) = @_;
    _init_syscall_table();
    return $_SYSCALL_NR{$name};
}

# Map OCI seccomp action strings to kernel SECCOMP_RET values
my %_SECCOMP_RET = (
    SCMP_ACT_KILL         => 0x00000000,
    SCMP_ACT_KILL_PROCESS => 0x80000000,
    SCMP_ACT_TRAP         => 0x00030000,
    SCMP_ACT_LOG          => 0x7ffc0000,
    SCMP_ACT_ALLOW        => 0x7fff0000,
);

sub _seccomp_action_val {
    my ($str) = @_;
    return $_SECCOMP_RET{$str} if exists $_SECCOMP_RET{$str};
    if ($str =~ /^SCMP_ACT_ERRNO\((\d+)\)$/) {
        return 0x00050000 | ($1 & 0xffff);
    }
    if ($str =~ /^SCMP_ACT_TRACE\((\d+)\)$/) {
        return 0x7ff00000 | ($1 & 0xffff);
    }
    return undef;
}

# BPF opcodes
use constant {
    _BPF_LD_W_ABS  => 0x20,   # BPF_LD  | BPF_W | BPF_ABS
    _BPF_JMP_JEQ_K => 0x15,   # BPF_JMP | BPF_JEQ | BPF_K
    _BPF_JMP_JGE_K => 0x35,   # BPF_JMP | BPF_JGE | BPF_K
    _BPF_JMP_JA    => 0x05,   # BPF_JMP | BPF_JA
    _BPF_RET_K     => 0x06,   # BPF_RET | BPF_K
};

# AUDIT_ARCH values
use constant {
    _AUDIT_ARCH_X86_64  => 0xc000003e,
    _AUDIT_ARCH_AARCH64 => 0xc00000b7,
};

sub apply_seccomp_minimal {
    my ($seccomp) = @_;

    my $default_str = $seccomp->{defaultAction} // 'SCMP_ACT_ALLOW';

    # Handle defaultErrnoRet: if set, SCMP_ACT_ERRNO without explicit errno
    # should use this value instead of the default EPERM(1).
    my $default_errno_ret = $seccomp->{defaultErrnoRet};

    my $default_ret = _seccomp_action_val($default_str)
        // do { warn "nacre: seccomp: unknown default action $default_str\n"; return };

    # Collect (syscall_nr → ret_val) pairs whose action differs from default
    my @rules;
    for my $rule (@{$seccomp->{syscalls} // []}) {
        my $act = $rule->{action} // $default_str;
        my $ret;

        # Apply defaultErrnoRet when action is SCMP_ACT_ERRNO without explicit value
        if ($act eq 'SCMP_ACT_ERRNO' && defined $default_errno_ret) {
            $ret = 0x00050000 | ($default_errno_ret & 0xffff);
        } else {
            $ret = _seccomp_action_val($act);
        }
        next unless defined $ret;
        next if $ret == $default_ret;   # same as default — skip
        for my $name (@{$rule->{names} // []}) {
            my $nr = _resolve_seccomp_syscall($name);
            unless (defined $nr) {
                warn "nacre: seccomp: unknown syscall '$name', skipping\n";
                next;
            }
            push @rules, [$nr, $ret];
        }
    }

    # ---- build BPF program (array of packed sock_filter, 8 bytes each) ----
    # struct sock_filter { __u16 code; __u8 jt; __u8 jf; __u32 k; }
    my @insns;

    # 1. Validate architecture
    require Config;
    my $arch_val = ($Config::Config{archname} // '') =~ /aarch64|arm64/i
        ? _AUDIT_ARCH_AARCH64 : _AUDIT_ARCH_X86_64;
    push @insns, pack('SCCL', _BPF_LD_W_ABS,  0, 0, 4);            # load arch
    push @insns, pack('SCCL', _BPF_JMP_JEQ_K, 1, 0, $arch_val);    # if arch==native skip 1
    push @insns, pack('SCCL', _BPF_RET_K,     0, 0, 0x00000000);    # KILL (bad arch)

    # 2. Load syscall number
    push @insns, pack('SCCL', _BPF_LD_W_ABS, 0, 0, 0);             # load nr

    # 3. Per-rule checks — each rule is two instructions (JEQ + RET)
    for my $r (@rules) {
        my ($nr, $ret) = @$r;
        push @insns, pack('SCCL', _BPF_JMP_JEQ_K, 0, 1, $nr);      # if nr==X fall-through, else skip
        push @insns, pack('SCCL', _BPF_RET_K,     0, 0, $ret);      # return action
    }

    # 4. Default action
    push @insns, pack('SCCL', _BPF_RET_K, 0, 0, $default_ret);

    # ---- assemble sock_fprog and call seccomp(2) ----
    my $filter = join('', @insns);
    my $ninsns = scalar @insns;

    # struct sock_fprog { unsigned short len; <pad>; struct sock_filter *filter; }
    # We need to pass a *pointer* to the filter buffer.  Perl's syscall() passes
    # string args by reference, so we embed the pointer in sock_fprog and pass
    # sock_fprog as a string.  'P' in pack produces a raw pointer to the scalar.
    my $fprog = pack('S x![Q] P', $ninsns, $filter);

    # Map OCI seccomp.flags to kernel SECCOMP_FILTER_FLAG_* values
    my %flag_map = (
        SECCOMP_FILTER_FLAG_TSYNC     => SECCOMP_FILTER_FLAG_TSYNC,
        SECCOMP_FILTER_FLAG_LOG       => SECCOMP_FILTER_FLAG_LOG,
        SECCOMP_FILTER_FLAG_SPEC_ALLOW => (1 << 2),
        SECCOMP_FILTER_FLAG_NEW_LISTENER => SECCOMP_FILTER_FLAG_NEW_LISTENER,
        SECCOMP_FILTER_FLAG_WAIT_KILLABLE_RECV => SECCOMP_FILTER_FLAG_WAIT_KILLABLE_RECV,
    );
    my $fl = 0;
    for my $flag_name (@{$seccomp->{flags} // []}) {
        my $fv = $flag_map{$flag_name};
        if (defined $fv) {
            $fl |= $fv;
        } else {
            warn "nacre: seccomp: unknown flag '$flag_name'\n";
        }
    }

    my $nr = SYS_seccomp + 0;
    my $op = SECCOMP_SET_MODE_FILTER + 0;
    $fl += 0;
    my $ret = syscall($nr, $op, $fl, $fprog);
    if ($ret != 0) {
        warn "nacre: seccomp: BPF load failed (errno=$!), filter has $ninsns insns\n";
    }
}

# ═══════════════════════════════════════════════════════════════════════
# eBPF Device Cgroup
# ═══════════════════════════════════════════════════════════════════════

sub apply_device_cgroup {
    my ($cgpath, $spec) = @_;
    my $rules = $spec->{linux}{resources}{devices} // return;

    # Emulate device rules (runc's devices_emulator)
    my ($default_allow, $exceptions) = emulate_device_rules($rules);

    # Build BPF program
    my $prog = build_device_bpf($default_allow, $exceptions);
    return unless @$prog;

    # Load BPF program
    my $insns = join('', map { pack_bpf_insn(@$_) } @$prog);
    my $license = "GPL\0";
    my $log_buf = "\0" x 4096;

    # bpf_attr for BPF_PROG_LOAD
    my $attr = pack('L      L      Q      Q      L      L      Q      a*',
        BPF_PROG_TYPE_CGROUP_DEVICE,  # prog_type
        scalar(@$prog),                # insn_cnt
        unpack('Q', pack('P', $insns)),   # insns ptr
        unpack('Q', pack('P', $license)), # license ptr
        4,                              # log_level
        4096,                           # log_size
        unpack('Q', pack('P', $log_buf)), # log_buf ptr
    );
    # Pad to expected size
    $attr .= "\0" x (256 - length($attr)) if length($attr) < 256;

    my $nr_bpf = SYS_bpf + 0;
    my $bpf_cmd = BPF_PROG_LOAD + 0;
    my $attr_len = length($attr) + 0;
    my $prog_fd;
    do { $prog_fd = syscall($nr_bpf, $bpf_cmd, $attr, $attr_len) }
        while ($prog_fd == -1 && $! == EINTR);
    if ($prog_fd < 0) {
        warn "nacre: BPF_PROG_LOAD failed: $!\n";
        return;
    }

    # Open cgroup dir fd
    sysopen(my $cgdir_fh, $cgpath, O_RDONLY | O_DIRECTORY)
        or do { warn "nacre: open cgroup dir: $!\n"; return; };
    my $cgdir_fd = fileno($cgdir_fh);

    # bpf_attr for BPF_PROG_ATTACH
    my $attach_attr = pack('L L L L',
        BPF_CGROUP_DEVICE,  # attach_type at offset 0
        $cgdir_fd,          # target_fd at offset 4
        $prog_fd,           # attach_bpf_fd at offset 8
        BPF_F_ALLOW_MULTI,  # attach_flags at offset 12
    );
    $attach_attr .= "\0" x (256 - length($attach_attr)) if length($attach_attr) < 256;

    my $bpf_attach = BPF_PROG_ATTACH + 0;
    my $attach_len = length($attach_attr) + 0;
    my $ret;
    do { $ret = syscall($nr_bpf, $bpf_attach, $attach_attr, $attach_len) }
        while ($ret == -1 && $! == EINTR);
    warn "nacre: BPF_PROG_ATTACH failed: $!\n" if $ret < 0;

    close $cgdir_fh;
    POSIX::close($prog_fd);
}

sub emulate_device_rules {
    my ($rules) = @_;
    my $default_allow = 0;
    my @exceptions;

    for my $r (@$rules) {
        my $type = $r->{type} // 'a';
        my $allow = $r->{allow} ? 1 : 0;
        my $access = $r->{access} // 'rwm';
        my $major = $r->{major};
        my $minor = $r->{minor};

        if ($type eq 'a') {
            $default_allow = $allow;
            @exceptions = ();
            next;
        }

        my $exc = {
            type   => $type,
            major  => $major // -1,
            minor  => $minor // -1,
            access => $access,
        };

        if ($allow != $default_allow) {
            push @exceptions, $exc;
        } else {
            @exceptions = grep {
                !($_->{type} eq $exc->{type} &&
                  $_->{major} == $exc->{major} &&
                  $_->{minor} == $exc->{minor})
            } @exceptions;
        }
    }

    return ($default_allow, \@exceptions);
}

sub build_device_bpf {
    my ($default_allow, $exceptions) = @_;
    my @prog;

    return \@prog unless @$exceptions;

    # BPF instructions for cgroup device filter
    # R1 = pointer to bpf_cgroup_dev_ctx:
    #   u32 access_type: (access << 16) | type  (type: 1=block, 2=char)
    #   u32 major
    #   u32 minor

    # Load access_type
    push @prog, bpf_ld_abs(0);    # R0 = *(u32*)(ctx + 0) = access_type
    push @prog, bpf_st(0);        # M[0] = R0 (save access_type)

    # For each exception, generate check-and-jump
    my $num_exc = scalar @$exceptions;
    for my $i (0..$num_exc-1) {
        my $exc = $exceptions->[$i];
        my $remaining = $num_exc - $i - 1;

        # Calculate jump target for "not matching" = skip to next exception
        my $jumps_in_this_exc = 0;
        $jumps_in_this_exc++ if $exc->{type};           # type check
        $jumps_in_this_exc++ if $exc->{major} != -1;    # major check
        $jumps_in_this_exc++ if $exc->{minor} != -1;    # minor check
        $jumps_in_this_exc++;                            # access check
        $jumps_in_this_exc++;                            # return action

        # Type check
        my $type_val = $exc->{type} eq 'b' ? 1 : 2;
        my $skip = $jumps_in_this_exc - 1;

        push @prog, bpf_ld_mem(0);     # R0 = M[0] (access_type)
        push @prog, bpf_alu_and(0xffff);  # R0 &= 0xffff (type field)
        push @prog, bpf_jne($type_val, $skip - 2, 0);

        # Major check
        if ($exc->{major} != -1) {
            push @prog, bpf_ld_abs(4);  # R0 = major
            $skip -= 3;
            push @prog, bpf_jne($exc->{major}, $skip > 0 ? $skip : 0, 0);
        }

        # Minor check
        if ($exc->{minor} != -1) {
            push @prog, bpf_ld_abs(8);  # R0 = minor
            $skip -= 2;
            push @prog, bpf_jne($exc->{minor}, $skip > 0 ? $skip : 0, 0);
        }

        # Access check
        push @prog, bpf_ld_mem(0);      # R0 = M[0] (access_type)
        my $access_mask = 0;
        $access_mask |= 1 if $exc->{access} =~ /m/;
        $access_mask |= 2 if $exc->{access} =~ /r/;
        $access_mask |= 4 if $exc->{access} =~ /w/;
        push @prog, bpf_alu_rsh(16);    # R0 >>= 16 (access field)
        push @prog, bpf_alu_and($access_mask);
        push @prog, bpf_jeq(0, 1, 0);   # if no matching access bits, skip return

        # Return opposite of default
        push @prog, bpf_ret($default_allow ? 0 : 1);
    }

    # Default return
    push @prog, bpf_ret($default_allow ? 1 : 0);

    return \@prog;
}

# BPF instruction helpers (eBPF format: 8 bytes each)
# struct bpf_insn { __u8 code; __u8 dst_reg:4, src_reg:4; __s16 off; __s32 imm; }

sub pack_bpf_insn {
    my ($code, $dst_src, $off, $imm) = @_;
    return pack('CCsl', $code, $dst_src // 0, $off // 0, $imm // 0);
}

# eBPF opcodes
use constant {
    BPF_LD_IMM64   => 0x18,
    BPF_LDX_MEM_W  => 0x61,
    BPF_STX_MEM_W  => 0x63,
    BPF_ALU_AND_K  => 0x54,
    BPF_ALU_RSH_K  => 0x74,
    BPF_JNE_K      => 0x55,
    BPF_JEQ_K      => 0x15,
    BPF_MOV_K      => 0xb4,
    BPF_EXIT       => 0x95,
};

sub bpf_ld_abs {
    my ($off) = @_;
    # ldx r0, [r1 + off]  (BPF_LDX | BPF_MEM | BPF_W, dst=r0, src=r1)
    return [BPF_LDX_MEM_W, 0x10, $off, 0];  # dst=0, src=1
}

sub bpf_st {
    my ($off) = @_;
    # stx [r10 + off], r0  (store to stack)
    return [BPF_STX_MEM_W, 0xa0, -4 - $off * 4, 0];  # dst=r10(fp), src=r0
}

sub bpf_ld_mem {
    my ($off) = @_;
    # ldx r0, [r10 + off]  (load from stack)
    return [BPF_LDX_MEM_W, 0x0a, -4 - $off * 4, 0];  # dst=r0, src=r10(fp)
}

sub bpf_alu_and {
    my ($imm) = @_;
    return [BPF_ALU_AND_K, 0x00, 0, $imm];
}

sub bpf_alu_rsh {
    my ($imm) = @_;
    return [BPF_ALU_RSH_K, 0x00, 0, $imm];
}

sub bpf_jne {
    my ($imm, $jt, $jf) = @_;
    return [BPF_JNE_K, 0x00, $jt, $imm];
}

sub bpf_jeq {
    my ($imm, $jt, $jf) = @_;
    return [BPF_JEQ_K, 0x00, $jt, $imm];
}

sub bpf_ret {
    my ($val) = @_;
    # mov r0, val; exit
    return [BPF_MOV_K, 0x00, 0, $val], [BPF_EXIT, 0x00, 0, 0];
}

# ═══════════════════════════════════════════════════════════════════════
# IPC Channel (socketpair-based)
# ═══════════════════════════════════════════════════════════════════════

sub create_channel {
    socketpair(my $a, my $b, PF_UNIX, SOCK_SEQPACKET, 0)
        or fatal("socketpair: $!");
    return (fileno($a), fileno($b), $a, $b);
}

sub channel_send {
    my ($fd, $msg) = @_;
    my $data = $JSON_COMPACT->encode($msg);
    my $ret = POSIX::write($fd, $data, length($data));
    fatal("channel_send: $!") unless defined $ret && $ret > 0;
}

sub channel_recv {
    my ($fd) = @_;
    my $buf;
    my $ret = POSIX::read($fd, $buf, 65536);
    return undef unless defined $ret && $ret > 0;
    return $JSON_COMPACT->decode($buf);
}

# ═══════════════════════════════════════════════════════════════════════
# Notify Socket (for start command)
# ═══════════════════════════════════════════════════════════════════════

sub create_notify_listener {
    my ($sock_path) = @_;
    unlink $sock_path;
    socket(my $srv, AF_UNIX, SOCK_STREAM, 0) or fatal("socket: $!");
    bind($srv, pack_sockaddr_un($sock_path))  or fatal("bind $sock_path: $!");
    listen($srv, 1)                           or fatal("listen: $!");
    return $srv;
}

sub wait_for_start {
    my ($srv_fh) = @_;
    accept(my $cli, $srv_fh) or fatal("accept on notify socket: $!");
    # Read "start container" message
    my $buf;
    sysread($cli, $buf, 4096);
    close $cli;
    return 1;
}

sub notify_container_start {
    my ($sock_path) = @_;
    socket(my $s, AF_UNIX, SOCK_STREAM, 0) or fatal("socket: $!");
    connect($s, pack_sockaddr_un($sock_path)) or fatal("connect $sock_path: $!");
    syswrite($s, "start container");
    close $s;
}

# ═══════════════════════════════════════════════════════════════════════
# PTY / Console Socket
# ═══════════════════════════════════════════════════════════════════════

# Send a file descriptor over a Unix domain socket using SCM_RIGHTS.
sub send_fd_via_socket {
    my ($socket_path, $fd) = @_;

    socket(my $sock, AF_UNIX, SOCK_STREAM, 0) or fatal("socket: $!");
    connect($sock, pack_sockaddr_un($socket_path))
        or fatal("connect to console socket '$socket_path': $!");

    my $sock_fd = fileno($sock) + 0;

    # iovec: one byte of data (required for SCM_RIGHTS)
    my $data = "\x00";
    my $iov = pack('P L!', $data, 1);

    # cmsg: SOL_SOCKET / SCM_RIGHTS / fd
    my $cmsg_data = pack('i', $fd);
    my $cmsg_len  = 8 + 4 + 4 + length($cmsg_data);   # cmsghdr + data
    my $cmsg = pack('L! i i', $cmsg_len, SOL_SOCKET, SCM_RIGHTS)
             . $cmsg_data;
    my $pad = (8 - (length($cmsg) % 8)) % 8;
    $cmsg .= "\0" x $pad;

    # msghdr (x86_64 / aarch64 LP64 layout — both are 56 bytes)
    my $msghdr = pack('Q',    0)              # msg_name      (NULL)
               . pack('I x4', 0)              # msg_namelen   (0 + pad)
               . pack('P',    $iov)           # msg_iov
               . pack('Q',    1)              # msg_iovlen
               . pack('P',    $cmsg)          # msg_control
               . pack('Q',    length($cmsg))  # msg_controllen
               . pack('I x4', 0);             # msg_flags     (0 + pad)

    my $nr  = SYS_sendmsg + 0;
    my $ret = syscall($nr, $sock_fd, $msghdr, 0);
    $ret >= 0 or fatal("sendmsg (console socket): $!");

    close($sock);
}

# Create a PTY pair, send the master to the console socket, return the
# slave file descriptor (as an integer fd number).  Must be called before
# pivot_root so that both /dev/ptmx and the console-socket path are
# reachable on the host filesystem.
sub setup_pty_console {
    my ($console_socket_path) = @_;

    # Open PTY master
    sysopen(my $ptm, '/dev/ptmx', O_RDWR | O_NOCTTY | O_CLOEXEC)
        or fatal("open /dev/ptmx: $!");

    # Get slave number
    my $ptn_buf = pack('i', 0);
    ioctl($ptm, TIOCGPTN, $ptn_buf) or fatal("TIOCGPTN: $!");
    my $ptn = unpack('i', $ptn_buf);

    # Unlock slave
    my $unlock = pack('i', 0);
    ioctl($ptm, TIOCSPTLCK, $unlock) or fatal("TIOCSPTLCK: $!");

    # Open slave (keep it open across pivot_root; we dup2 it to 0/1/2 later)
    my $pts_path = "/dev/pts/$ptn";
    sysopen(my $pts, $pts_path, O_RDWR | O_NOCTTY)
        or fatal("open PTY slave $pts_path: $!");

    # Deliver master to whoever is listening on the console socket
    send_fd_via_socket($console_socket_path, fileno($ptm));

    # Master stays open in the receiver; close our copy
    close($ptm);

    # Dup the slave fd so it survives the $pts filehandle going out of scope.
    # POSIX::dup returns a raw fd number not tied to any Perl handle, so it
    # won't be auto-closed when this sub returns.
    my $dup_fd = POSIX::dup(fileno($pts));
    fatal("dup PTY slave: $!") unless defined $dup_fd && $dup_fd >= 0;
    close($pts);

    return $dup_fd;
}

# ═══════════════════════════════════════════════════════════════════════
# Process Security
# ═══════════════════════════════════════════════════════════════════════

sub apply_process_security {
    my ($spec) = @_;
    my $proc = $spec->{process} // {};

    # 1. OOM score adj
    if (defined $proc->{oomScoreAdj}) {
        eval { write_file('/proc/self/oom_score_adj', $proc->{oomScoreAdj}); };
    }

    # 2. Umask
    if (defined $proc->{user}{umask}) {
        umask($proc->{user}{umask});
    }

    # 3. No new privileges
    if ($proc->{noNewPrivileges}) {
        do_syscall(SYS_prctl, PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
    }

    # 4. Seccomp (must be applied before dropping caps)
    apply_seccomp_raw($spec);

    # 5. Capabilities phase 1: drop bounding set + set KEEPCAPS.
    #    KEEPCAPS must be on BEFORE setuid so the kernel preserves the
    #    permitted set across the uid-0 → uid-N transition.
    apply_capabilities_bounding($spec);

    # 6. Set supplementary groups, then gid, then uid.
    #    Must happen AFTER KEEPCAPS is set and BEFORE the final capset.
    if (my $groups = $proc->{user}{additionalGids}) {
        my $nr = SYS_setgroups + 0;
        my $n  = scalar(@$groups) + 0;
        my $pk = pack('L*', @$groups);
        syscall($nr, $n, $pk);
    } else {
        my $nr = SYS_setgroups + 0;
        my $pk = '';
        syscall($nr, 0, $pk);
    }

    my $gid = $proc->{user}{gid} // 0;
    my $uid = $proc->{user}{uid} // 0;
    POSIX::setgid($gid + 0);
    POSIX::setuid($uid + 0);

    # 7. Capabilities phase 2: capset + clear KEEPCAPS + ambient caps.
    #    Now running as the target uid/gid, restore the desired capability
    #    sets.  The kernel cleared effective on setuid but kept permitted
    #    (KEEPCAPS was on); capset re-establishes the spec's desired sets.
    apply_capabilities_final($spec);
}

# ═══════════════════════════════════════════════════════════════════════
# rlimits
# ═══════════════════════════════════════════════════════════════════════

my %RLIMIT_MAP = (
    RLIMIT_AS         => 9,
    RLIMIT_CORE       => 4,
    RLIMIT_CPU        => 0,
    RLIMIT_DATA       => 2,
    RLIMIT_FSIZE      => 1,
    RLIMIT_LOCKS      => 10,
    RLIMIT_MEMLOCK    => 8,
    RLIMIT_MSGQUEUE   => 12,
    RLIMIT_NICE       => 13,
    RLIMIT_NOFILE     => 7,
    RLIMIT_NPROC      => 6,
    RLIMIT_RSS        => 5,
    RLIMIT_RTPRIO     => 14,
    RLIMIT_RTTIME     => 15,
    RLIMIT_SIGPENDING => 11,
    RLIMIT_STACK      => 3,
);

sub validate_rlimits {
    # OCI spec: "The runtime MUST generate an error for any values
    # which cannot be mapped to a relevant kernel interface."
    my ($spec) = @_;
    return unless $spec->{process};  # avoid auto-vivifying {process}
    my $rlimits = $spec->{process}{rlimits} // return;
    for my $rl (@$rlimits) {
        exists $RLIMIT_MAP{$rl->{type}}
            or fatal("unknown rlimit type '$rl->{type}'");
    }
}

sub apply_rlimits {
    my ($spec) = @_;
    my $rlimits = $spec->{process}{rlimits} // return;
    for my $rl (@$rlimits) {
        my $type = $RLIMIT_MAP{$rl->{type}} // next;
        my $soft = $rl->{soft} // 0;
        my $hard = $rl->{hard} // 0;
        # prlimit64(pid=0, resource, new_rlim, old_rlim=NULL)
        my $nr = SYS_prlimit64 + 0;
        my $t  = $type + 0;
        my $new_rlim = pack('QQ', $soft, $hard);
        syscall($nr, 0, $t, $new_rlim, 0);
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Sysctls
# ═══════════════════════════════════════════════════════════════════════

my %SYSCTL_ALLOWED_PREFIXES = map { $_ => 1 } qw(
    net. fs.mqueue.
    kernel.msgmax kernel.msgmnb kernel.msgmni
    kernel.sem kernel.shmall kernel.shmmax kernel.shmmni
    kernel.domainname
);

sub validate_sysctl {
    my ($key) = @_;
    for my $prefix (keys %SYSCTL_ALLOWED_PREFIXES) {
        return 1 if index($key, $prefix) == 0;
    }
    return 0;
}

sub apply_sysctls {
    my ($spec) = @_;
    my $sysctls = $spec->{linux}{sysctl} // return;
    for my $key (keys %$sysctls) {
        fatal("sysctl '$key' not allowed") unless validate_sysctl($key);
        my $path = '/proc/sys/' . ($key =~ s/\./\//gr);
        eval { write_file($path, $sysctls->{$key}); };
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Hooks
# ═══════════════════════════════════════════════════════════════════════

sub run_hooks {
    my ($hooks, $state, %opts) = @_;
    return unless $hooks;
    my $must_succeed = $opts{must_succeed} // 0;
    for my $hook (@$hooks) {
        # Prepare state JSON and pipe BEFORE forking so the child inherits
        # a real file descriptor that survives exec().
        my $state_json = $JSON_COMPACT->encode(oci_state_json($state));
        pipe(my $rd, my $wr) or fatal("pipe for hook stdin: $!");

        my $pid = fork();
        fatal("fork for hook: $!") unless defined $pid;
        if ($pid == 0) {
            close $wr;  # Child doesn't write
            # Set env
            if ($hook->{env}) {
                for my $e (@{$hook->{env}}) {
                    my ($k, $v) = split /=/, $e, 2;
                    $ENV{$k} = $v;
                }
            }
            # Redirect the pipe read-end to STDIN (real fd survives exec)
            open STDIN, '<&', $rd or _exit(1);
            close $rd;
            my @args = @{$hook->{args} // [$hook->{path}]};
            { exec { $hook->{path} } @args };
            _exit(1);
        }
        # Parent: write state JSON into the pipe, then close
        close $rd;
        print $wr $state_json;
        close $wr;

        my $timeout = $hook->{timeout} // 30;
        my $elapsed = 0;
        while ($elapsed < $timeout) {
            my $w = waitpid($pid, WNOHANG);
            last if $w > 0;
            select(undef, undef, undef, 0.1);
            $elapsed += 0.1;
        }
        if ($elapsed >= $timeout) {
            kill 9, $pid;
            waitpid($pid, 0);
            if ($must_succeed) {
                fatal("hook $hook->{path} timed out after ${timeout}s");
            }
            warn "nacre: hook $hook->{path} timed out\n";
        } elsif ($?) {
            # Hook exited non-zero
            my $exit_code = $? >> 8;
            if ($must_succeed) {
                fatal("hook $hook->{path} failed with exit code $exit_code");
            }
            warn "nacre: hook $hook->{path} exited with code $exit_code\n";
        }
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Init Process (runs inside the container)
# ═══════════════════════════════════════════════════════════════════════

sub run_init_process {
    my ($spec, $rootfs, $notify_fd, $main_chan_w, $main_chan_r, $cgpath, $id, $bundle, $pts_fd, $debug_fd) = @_;

    my $dbg = sub {
        return unless defined $debug_fd && $debug_fd >= 0;
        my $msg = join('', @_) . "\n";
        POSIX::write($debug_fd, $msg, length($msg));
    };

    $dbg->("init_process: start, pts_fd=" . (defined $pts_fd ? $pts_fd : 'undef'));

    # Setup rootfs (mounts, devices, symlinks)
    prepare_rootfs($spec, $rootfs);

    # pivot_root
    apply_pivot_root($rootfs);

    # Apply the spec's rootfs propagation now that we're inside the new root
    apply_rootfs_propagation($spec);

    # Hostname — call syscall() directly (mixed string/integer args)
    if (my $hostname = $spec->{hostname}) {
        my $nr = SYS_sethostname + 0;
        my $h  = $hostname . "\0";
        my $l  = length($hostname) + 0;
        syscall($nr, $h, $l);
    }
    if (my $domainname = $spec->{domainname}) {
        my $nr = SYS_setdomainname + 0;
        my $d  = $domainname . "\0";
        my $l  = length($domainname) + 0;
        syscall($nr, $d, $l);
    }

    # Sysctls (after pivot_root, /proc/sys is the container's)
    apply_sysctls($spec);

    # Masked paths
    apply_masked_paths($spec->{linux}{maskedPaths});

    # Readonly paths
    apply_readonly_paths($spec->{linux}{readonlyPaths});

    # Set rootfs readonly if requested
    set_rootfs_readonly($spec->{root}{readonly});

    # chdir to cwd (OCI spec: MUST fail if cwd doesn't exist)
    my $cwd = $spec->{process}{cwd} // '/';
    chdir($cwd) or fatal("chdir to cwd '$cwd': $!");

    # Signal main process: init ready
    channel_send($main_chan_w, { type => 'init_ready' });

    # Wait for start signal
    wait_for_start($notify_fd);

    # Run startContainer hooks (run inside the container namespace)
    if (my $hooks = $spec->{hooks}) {
        if ($hooks->{startContainer}) {
            my $hook_state = {
                ociVersion => $spec->{ociVersion} // '1.2.0',
                id         => $id // '',
                status     => 'running',
                pid        => $$,
                bundle     => $bundle // '',
                annotations => $spec->{annotations} // {},
            };
            run_hooks($hooks->{startContainer}, $hook_state, must_succeed => 1);
        }
    }

    # Apply process security (NNP, seccomp, caps, setuid/setgid)
    $dbg->("apply_process_security");
    apply_process_security($spec);

    # Apply rlimits
    apply_rlimits($spec);

    # Set environment
    %ENV = ();
    for my $e (@{$spec->{process}{env} // []}) {
        my ($k, $v) = split /=/, $e, 2;
        $ENV{$k} = $v if defined $k;
    }

    # Set up container stdio from PTY slave BEFORE close_range fallback
    # can destroy it (close_range with CLOEXEC only marks, but the POSIX
    # fallback actually closes fds immediately).
    if (defined $pts_fd) {
        my $r0 = POSIX::dup2($pts_fd, 0);
        my $r1 = POSIX::dup2($pts_fd, 1);
        my $r2 = POSIX::dup2($pts_fd, 2);
        $dbg->("dup2 pts_fd=$pts_fd → 0=$r0 1=$r1 2=$r2");
        $r0 >= 0 or fatal("dup2 pts→stdin: $!");
        $r1 >= 0 or fatal("dup2 pts→stdout: $!");
        $r2 >= 0 or fatal("dup2 pts→stderr: $!");
        # Set the PTY as the controlling terminal for this session.
        # Pass integer 0 (not pack('i',0) which Perl treats as a pointer).
        my $tio = ioctl(STDIN, TIOCSCTTY, 0);
        $dbg->("TIOCSCTTY=$tio err=$!");
        # pts_fd itself (>= 3) will be closed below
    }

    # Close extra fds (marks CLOEXEC — actually closed at exec).
    # Save the return value explicitly; $! can hold a stale errno from
    # earlier calls and must not be tested after a *successful* syscall.
    my $cr_ret = do_syscall(SYS_close_range, 3, ~0, CLOSE_RANGE_CLOEXEC);
    $dbg->("close_range=$cr_ret err=$!");
    if ($cr_ret == -1) {
        # Fallback: close individually (needed on kernels < 5.11)
        for my $fd (3..1023) {
            next if defined $debug_fd && $fd == $debug_fd;
            POSIX::close($fd);
        }
        $dbg->("close_range fallback done");
    }

    # Exec
    my @args = @{$spec->{process}{args} // ['sh']};
    $dbg->("exec: " . join(' ', @args) . " (PATH=$ENV{PATH})");
    # The debug fd is marked CLOEXEC (or closed by fallback); exec closes it.
    { exec { $args[0] } @args };
    $dbg->("exec FAILED: $!");
    fatal("exec $args[0]: $!");
}

# ═══════════════════════════════════════════════════════════════════════
# Main Process (runs on the host, coordinates init setup)
# ═══════════════════════════════════════════════════════════════════════

sub run_main_process {
    my (%p) = @_;
    my $spec       = $p{spec};
    my $id         = $p{id};
    my $bundle     = $p{bundle};
    my $root       = $p{root};
    my $cgpath     = $p{cgpath};
    my $init_pid   = $p{init_pid};
    my $chan_r_fd   = $p{chan_r};

    # Setup cgroup
    eval { cgroup_setup($cgpath, $spec); };
    warn "nacre: cgroup setup: $@" if $@;

    # Add init process to cgroup
    eval { cgroup_add_process($cgpath, $init_pid); };

    # Apply device cgroup (eBPF)
    eval { apply_device_cgroup($cgpath, $spec); };

    # Write UID/GID mappings for user namespace
    write_id_mappings($init_pid, $spec);

    # Wait for init_ready message
    my $msg = channel_recv($chan_r_fd);
    if (!$msg || $msg->{type} ne 'init_ready') {
        fatal("init process failed to become ready");
    }

    # Save state
    my $start_time = get_pid_starttime($init_pid);
    my $state = {
        ociVersion   => $spec->{ociVersion} // '1.2.0',
        id           => $id,
        status       => 'created',
        pid          => $init_pid,
        pidStartTime => $start_time,
        bundle       => $bundle,
        annotations  => $spec->{annotations} // {},
        created      => iso8601_now(),
        cgroupPath   => $cgpath,
    };
    save_state($root, $state);

    # Write pid file if requested
    if ($p{pid_file}) {
        write_file($p{pid_file}, "$init_pid\n");
    }

    # Run createRuntime hooks
    if (my $hooks = $spec->{hooks}) {
        run_hooks($hooks->{createRuntime}, $state);
        run_hooks($hooks->{prestart}, $state);      # deprecated but still supported
    }

    return $state;
}

# ═══════════════════════════════════════════════════════════════════════
# User namespace UID/GID mapping
# ═══════════════════════════════════════════════════════════════════════

sub write_id_mappings {
    my ($pid, $spec) = @_;
    my $linux = $spec->{linux} // return;

    my $uid_maps = $linux->{uidMappings};
    my $gid_maps = $linux->{gidMappings};
    return unless $uid_maps || $gid_maps;

    # Write "deny" to setgroups before gid_map
    eval { write_file("/proc/$pid/setgroups", "deny"); };

    if ($uid_maps) {
        my $content = join("\n", map {
            "$_->{containerID} $_->{hostID} $_->{size}"
        } @$uid_maps) . "\n";
        write_file("/proc/$pid/uid_map", $content);
    }

    if ($gid_maps) {
        my $content = join("\n", map {
            "$_->{containerID} $_->{hostID} $_->{size}"
        } @$gid_maps) . "\n";
        write_file("/proc/$pid/gid_map", $content);
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: create
# ═══════════════════════════════════════════════════════════════════════

sub cmd_create {
    my (%p) = @_;
    my $id     = $p{id}     // fatal("container id required");
    my $bundle = $p{bundle} // getcwd();
    my $root   = $p{root}   // $DEFAULT_ROOT;

    $bundle = abs_path($bundle);
    log_debug("create container id=$id bundle=$bundle root=$root");

    # Check container doesn't already exist (OCI spec: MUST error if ID not unique)
    if (-d state_dir($root, $id)) {
        my $s = eval { load_state($root, $id) };
        fatal("container '$id' already exists") if $s;
        # Directory exists but no valid state — clean up stale state
        delete_state($root, $id);
    }

    my $spec = load_spec($bundle);

    # Validate early — OCI spec requires errors for values that cannot
    # be mapped to kernel interfaces.
    validate_capabilities($spec);
    validate_rlimits($spec);

    # Snapshot config.json — OCI spec: "Any updates to config.json
    # after this step MUST NOT affect the container."
    cache_spec($root, $id, $spec);

    my $rootfs = $spec->{root}{path} // 'rootfs';
    $rootfs = "$bundle/$rootfs" unless $rootfs =~ m{^/};
    fatal("rootfs '$rootfs' does not exist") unless -d $rootfs;

    my $cgpath = cgroup_path($spec, $id);

    # Determine which namespaces to create vs join
    my $namespaces = $spec->{linux}{namespaces} // [];
    my $clone_flags = 0;
    my @join_ns;
    my $has_userns = 0;
    my $has_pidns = 0;

    for my $ns (@$namespaces) {
        my $info = $NS_MAP{$ns->{type}} // next;
        if ($ns->{path}) {
            push @join_ns, { type => $ns->{type}, path => $ns->{path}, info => $info };
        } else {
            $clone_flags |= $info->{flag};
        }
        $has_userns = 1 if $ns->{type} eq 'user';
        $has_pidns  = 1 if $ns->{type} eq 'pid';
    }

    # Ensure a mount namespace exists — pivot_root and rootfs setup
    # modify the mount tree and would corrupt the caller's filesystem
    # without one.  Only add CLONE_NEWNS if the spec doesn't already
    # configure a mount namespace (either by creation or join-by-path).
    unless (grep { $_->{type} eq 'mount' } @$namespaces) {
        $clone_flags |= CLONE_NEWNS;
    }

    # Create IPC channels
    my ($main_r_fd, $main_w_fd, $main_r_fh, $main_w_fh) = create_channel();
    my ($init_r_fd, $init_w_fd, $init_r_fh, $init_w_fh) = create_channel();

    # Create notify socket directory
    my $notify_dir = state_dir($root, $id);
    ensure_dir($notify_dir);
    my $notify_path = "$notify_dir/notify.sock";

    # Fork: child will become the init process
    my $child_pid = fork();
    fatal("fork: $!") unless defined $child_pid;

    if ($child_pid == 0) {
        # === Child process (will become container init) ===
        close $main_r_fh;  # Close parent's read end
        close $init_w_fh;  # Close parent's write end

        # Set death signal
        do_syscall(SYS_prctl, PR_SET_PDEATHSIG, 9, 0, 0, 0);

        # Join specified namespaces
        for my $ns (@join_ns) {
            my $ns_fd;
            sysopen($ns_fd, $ns->{path}, O_RDONLY) or fatal("open ns $ns->{path}: $!");
            my $nr  = SYS_setns + 0;
            my $fd  = fileno($ns_fd) + 0;
            my $flg = $ns->{info}{flag} + 0;
            my $r;
            do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
            $r == 0 or fatal("setns $ns->{type}: $!");
            close $ns_fd;
        }

        # Unshare namespaces (except PID — that's handled by fork below)
        my $unshare_flags = $clone_flags & ~CLONE_NEWPID & ~CLONE_NEWCGROUP;
        if ($has_userns) {
            # Unshare user namespace first
            my $nr  = SYS_unshare + 0;
            my $flg = CLONE_NEWUSER + 0;
            my $r;
            do { $r = syscall($nr, $flg) } while ($r == -1 && $! == EINTR);
            $r == 0 or fatal("unshare NEWUSER: $!");
            $unshare_flags &= ~CLONE_NEWUSER;

            # Signal parent to write UID/GID mappings
            channel_send($main_w_fd, { type => 'write_mapping', pid => $$ });

            # Wait for mapping done
            my $resp = channel_recv($init_r_fd);
            fatal("mapping failed") unless $resp && $resp->{type} eq 'mapping_done';
        }

        # Unshare remaining namespaces (not PID, not cgroup).
        # Use inline scalar variables for syscall() args — Perl's syscall()
        # inspects SV type flags; constants and @_ aliases from map can carry
        # stale POK flags that cause the kernel arg to be misinterpreted.
        # Fresh lexical scalars (with $x + 0 coercion) ensure clean IOK SVs.
        if ($unshare_flags) {
            my $nr  = SYS_unshare + 0;
            my $flg = $unshare_flags + 0;
            my $ret;
            do { $ret = syscall($nr, $flg) } while ($ret == -1 && $! == EINTR);
            $ret == 0 or fatal(sprintf("unshare(0x%x): $!", $unshare_flags));
        }

        # Fork again for PID namespace (child becomes PID 1 in new PID ns).
        # Only unshare when creating a NEW PID namespace ($clone_flags has
        # the flag set).  If the spec joins an existing PID namespace via
        # path, setns() already handled it above — calling unshare here
        # would fail with EINVAL.
        if ($clone_flags & CLONE_NEWPID) {
            my $nr  = SYS_unshare + 0;
            my $flg = CLONE_NEWPID + 0;
            my $ret;
            do { $ret = syscall($nr, $flg) } while ($ret == -1 && $! == EINTR);
            $ret == 0 or fatal("unshare NEWPID: $!");
        }

        my $init_pid = fork();
        fatal("fork for PID ns: $!") unless defined $init_pid;

        if ($init_pid > 0) {
            # Intermediate child: report init PID and exit
            channel_send($main_w_fd, { type => 'init_pid', pid => $init_pid });
            _exit(0);
        }

        # === Init process (PID 1 in new PID namespace) ===
        setsid();

        # Set up PTY console if terminal is requested and a console socket
        # was provided.  Must happen before pivot_root (host paths needed).
        my $pts_fd;
        my $terminal = $spec->{process}{terminal};
        if ($terminal && $p{console_socket}) {
            $pts_fd = setup_pty_console($p{console_socket});
        }

        # Open a debug log in the state directory (host filesystem, before
        # pivot_root).  The fd survives pivot_root and close_range(CLOEXEC),
        # so we can write to it right up until exec.
        my $init_debug_fd;
        eval {
            sysopen(my $dfh, "$notify_dir/init.log",
                    O_WRONLY | O_CREAT | O_TRUNC, 0644) or die "open: $!";
            $init_debug_fd = POSIX::dup(fileno($dfh));
            close $dfh;
        };

        # For detached containers (create, not run), redirect stdio to
        # /dev/null.  This prevents shell callers like output=$(...)
        # from hanging (the init holds the pipe otherwise), and avoids
        # polluting RuntimeInsideValidate tests with runtimetest output
        # that contains "not ok" lines for unimplemented features.
        # When a PTY is set up the slave will replace stdio before exec;
        # for 'run' (foreground), keep the parent's stdio so the user
        # sees container output.
        if (!$p{foreground}) {
            open STDIN,  '<', '/dev/null';
            open STDOUT, '>', '/dev/null';
            open STDERR, '>', '/dev/null';
        }

        # Unshare cgroup namespace
        if ($clone_flags & CLONE_NEWCGROUP) {
            # Wait until parent has set up cgroups
            my $msg = channel_recv($init_r_fd);
            # Then unshare
            my $nr  = SYS_unshare + 0;
            my $flg = CLONE_NEWCGROUP + 0;
            my $r;
            do { $r = syscall($nr, $flg) } while ($r == -1 && $! == EINTR);
            # cgroup unshare failure is non-fatal (best-effort)
        }

        # Create notify listener
        my $notify_srv = create_notify_listener($notify_path);

        # Run the init process (eval captures die from fatal so we can
        # report the actual error to the parent through the channel).
        eval {
            run_init_process($spec, $rootfs, $notify_srv, $main_w_fd, $init_r_fd, $cgpath, $id, $bundle, $pts_fd, $init_debug_fd);
        };
        if ($@) {
            my $err = "$@";
            chomp $err;
            # Write error to debug log
            if (defined $init_debug_fd && $init_debug_fd >= 0) {
                my $msg = "init_process FATAL: $err\n";
                POSIX::write($init_debug_fd, $msg, length($msg));
            }
            # Send error to parent through channel so it appears in the
            # error message that the runtime prints to stderr.
            eval { channel_send($main_w_fd, { type => 'init_error', error => $err }); };
        }
        _exit(1);
    }

    # === Parent process ===
    close $main_w_fh;  # Close child's write end
    close $init_r_fh;  # Close child's read end

    # Handle messages from child
    my $init_pid;
    my $init_error;
    my $mapping_written = 0;
    my $init_ready = 0;

    while (1) {
        my $msg = channel_recv($main_r_fd);
        last unless $msg;

        if ($msg->{type} eq 'write_mapping') {
            # Child created user namespace, write mappings
            write_id_mappings($msg->{pid}, $spec);
            $mapping_written = 1;
            channel_send($init_w_fd, { type => 'mapping_done' });
        }
        elsif ($msg->{type} eq 'init_pid') {
            $init_pid = $msg->{pid};
            # Tell init that cgroup is ready (for CLONE_NEWCGROUP)
            if ($clone_flags & CLONE_NEWCGROUP) {
                eval { cgroup_setup($cgpath, $spec); };
                eval { cgroup_add_process($cgpath, $init_pid); };
                eval { apply_device_cgroup($cgpath, $spec); };
                channel_send($init_w_fd, { type => 'cgroup_done' });
            }
        }
        elsif ($msg->{type} eq 'init_ready') {
            $init_ready = 1;
            last;
        }
        elsif ($msg->{type} eq 'init_error') {
            # Init process reported a fatal error — store it for the
            # error message we'll emit below.
            $init_error = $msg->{error} // 'unknown';
        }
    }

    # Reap intermediate child
    waitpid($child_pid, 0);

    fatal("init process failed to start") unless $init_pid;

    # Check init process is actually alive and init_ready was received
    unless ($init_ready) {
        # Init process died during setup — try to get exit status
        my $w = waitpid($init_pid, WNOHANG);
        my $exit_msg = ($w > 0) ? " (exit status " . ($? >> 8) . ")" : "";
        my $err_detail = $init_error ? ": $init_error" : "";
        fatal("init process died during container setup${exit_msg}${err_detail}");
    }

    # If cgroup wasn't set up yet (no CLONE_NEWCGROUP path)
    unless ($clone_flags & CLONE_NEWCGROUP) {
        eval { cgroup_setup($cgpath, $spec); };
        eval { cgroup_add_process($cgpath, $init_pid); };
        eval { apply_device_cgroup($cgpath, $spec); };
    }

    # If no user namespace, write mappings now (for non-userns case they're not needed)
    # (uid/gid mappings are only for user namespaces)

    # Save state
    my $start_time = get_pid_starttime($init_pid);
    my $state = {
        ociVersion   => $spec->{ociVersion} // '1.2.0',
        id           => $id,
        status       => 'created',
        pid          => $init_pid,
        pidStartTime => $start_time,
        bundle       => $bundle,
        annotations  => $spec->{annotations} // {},
        created      => iso8601_now(),
        cgroupPath   => $cgpath,
    };
    save_state($root, $state);

    # Write pid file
    if ($p{pid_file}) {
        write_file($p{pid_file}, "$init_pid\n");
    }

    # Run createRuntime hooks (OCI spec: MUST error if these fail)
    if (my $hooks = $spec->{hooks}) {
        run_hooks($hooks->{createRuntime}, $state, must_succeed => 1);
        run_hooks($hooks->{createContainer}, $state, must_succeed => 1);
        run_hooks($hooks->{prestart}, $state, must_succeed => 1);
    }

    return $state;
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: start
# ═══════════════════════════════════════════════════════════════════════

sub cmd_start {
    my (%p) = @_;
    my $id   = $p{id}   // fatal("container id required");
    my $root = $p{root} // $DEFAULT_ROOT;
    log_debug("start container id=$id");

    my $state = load_state($root, $id);
    fatal("container '$id' is not in 'created' state (is '$state->{status}')")
        unless $state->{status} eq 'created';

    # Load the cached spec snapshot from create time (config.json
    # modifications after create MUST NOT affect the container).
    my $spec = eval { load_cached_spec($root, $id, $state->{bundle}) };
    fatal("cannot load config: $@") unless $spec;

    # process.args may be empty or process may be nil — the OCI spec
    # allows omitting spec.process entirely.  In that case, create/start
    # still succeeds and the init process exits cleanly without exec'ing
    # a user program (matches kontainer-runtime / runc behaviour).

    # Connect to notify socket
    my $notify_path = state_dir($root, $id) . '/notify.sock';
    notify_container_start($notify_path);

    # Update state to running
    $state->{status} = 'running';
    save_state($root, $state);

    # Run poststart hooks ($spec already loaded above)
    if ($spec->{hooks}) {
        run_hooks($spec->{hooks}{poststart}, $state);
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: state
# ═══════════════════════════════════════════════════════════════════════

sub cmd_state {
    my (%p) = @_;
    my $id   = $p{id}   // fatal("container id required");
    my $root = $p{root} // $DEFAULT_ROOT;

    my $state = load_state($root, $id);
    print $JSON->encode(oci_state_json($state));
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: kill
# ═══════════════════════════════════════════════════════════════════════

sub cmd_kill {
    my (%p) = @_;
    my $id     = $p{id}     // fatal("container id required");
    my $root   = $p{root}   // $DEFAULT_ROOT;
    my $signal = $p{signal} // 'TERM';
    my $all    = $p{all}    // 0;

    my $state = load_state($root, $id);

    # When --all/-a is used, silently succeed even if the container is not
    # running (runc compat: -a is the obsoleted "all processes" flag).
    if ($state->{status} ne 'running' && $state->{status} ne 'created') {
        return if $all;
        fatal("container not running");
    }

    # Parse signal
    my $signum;
    if ($signal =~ /^\d+$/) {
        $signum = $signal;
    } else {
        $signal =~ s/^SIG//i;
        $signum = $SIG_NUM{uc($signal)} // fatal("unknown signal: $signal");
    }

    if ($all && $state->{cgroupPath}) {
        # Kill all processes in cgroup
        my @pids = cgroup_pids($state->{cgroupPath});
        for my $pid (@pids) {
            kill $signum, $pid;
        }
    } else {
        kill $signum, $state->{pid} or fatal("kill $state->{pid}: $!");
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: delete
# ═══════════════════════════════════════════════════════════════════════

sub cmd_delete {
    my (%p) = @_;
    my $id    = $p{id}    // fatal("container id required");
    my $root  = $p{root}  // $DEFAULT_ROOT;
    my $force = $p{force} // 0;
    log_debug("delete container id=$id force=$force");

    my $state = load_state($root, $id);

    if ($state->{status} eq 'running' || $state->{status} eq 'created'
        || $state->{status} eq 'paused') {
        if ($force) {
            # Unfreeze first for paused containers so SIGKILL can be delivered
            if ($state->{status} eq 'paused' && $state->{cgroupPath}) {
                eval { write_file("$state->{cgroupPath}/cgroup.freeze", "0\n") };
                select(undef, undef, undef, 0.1);
            }
            # Force kill
            if ($state->{pid} > 0) {
                kill 9, $state->{pid};
                # Wait a bit
                select(undef, undef, undef, 0.1);
            }
            if ($state->{cgroupPath}) {
                cgroup_cleanup($state->{cgroupPath});
            }
        } else {
            fatal("container '$id' is not stopped (is '$state->{status}'). Use --force to force delete.");
        }
    }

    # Cleanup cgroup
    if ($state->{cgroupPath} && -d $state->{cgroupPath}) {
        cgroup_cleanup($state->{cgroupPath});
    }

    # Run poststop hooks (use cached spec from create time)
    my $spec = eval { load_cached_spec($root, $id, $state->{bundle}) };
    if ($spec && $spec->{hooks}) {
        run_hooks($spec->{hooks}{poststop}, $state);
    }

    # Remove state
    delete_state($root, $id);
}

# ═══════════════════════════════════════════════════════════════════════
# Container Lifecycle: run (create + start + wait + delete)
# ═══════════════════════════════════════════════════════════════════════

sub cmd_run {
    my (%p) = @_;
    my $id     = $p{id}     // fatal("container id required");
    my $root   = $p{root}   // $DEFAULT_ROOT;
    my $bundle = $p{bundle} // getcwd();
    log_debug("run container id=$id bundle=$bundle detach=" . ($p{detach}//0));
    my $detach = $p{detach};

    if ($detach) {
        # Detached mode: create + start, then return immediately.
        # Equivalent to `runc create` + `runc start`.
        my $state = cmd_create(%p);
        cmd_start(id => $id, root => $root);

        # Write pid file if requested
        if ($p{pid_file} && $state->{pid}) {
            write_file($p{pid_file}, $state->{pid});
        }
        return;
    }

    # Foreground mode: create + start + wait
    # Set as subreaper so we can wait for the init process (grandchild
    # reparented to us when the intermediate child exits).
    my $pr_nr  = SYS_prctl + 0;
    my $pr_opt = PR_SET_CHILD_SUBREAPER + 0;
    my $sr_ret = syscall($pr_nr, $pr_opt, 1, 0, 0, 0);

    # Create (foreground: keep stdio so user sees container output)
    my $state = cmd_create(%p, foreground => 1);

    # Start
    cmd_start(id => $id, root => $root);

    # Forward signals to init
    my $init_pid = $state->{pid};
    for my $sig (qw(TERM INT HUP QUIT USR1 USR2)) {
        $SIG{$sig} = sub { kill $SIG_NUM{$sig}, $init_pid; };
    }

    # Wait for init process to exit.
    # Primary: pidfd_open + waitid(P_PIDFD) — stable handle, no PID
    # recycling race, works even if the init exits immediately.
    # Fallback: waitpid with subreaper (if pidfd_open unavailable).
    # Last resort: poll with kill(0, pid).
    my $exit_code = 0;
    my $got_init = 0;

    # Try pidfd_open first (kernel 5.3+)
    my $pidfd_nr = SYS_pidfd_open + 0;
    my $pidfd = syscall($pidfd_nr, $init_pid + 0, 0);

    if ($pidfd >= 0) {
        # waitid(P_PIDFD, pidfd, ...) — kernel 5.4+
        my $waitid_nr = SYS_waitid + 0;
        my $siginfo = "\0" x 128;       # siginfo_t
        my $P_PIDFD = 3;               # <linux/wait.h>
        my $WEXITED = 4;               # <sys/wait.h>
        my $wr = syscall($waitid_nr, $P_PIDFD + 0, $pidfd + 0,
                         $siginfo, $WEXITED + 0, 0);
        if ($wr == 0) {
            # siginfo_t layout (x86_64/aarch64 LP64):
            # +0  si_signo  (int)
            # +4  si_errno  (int)
            # +8  si_code   (int)
            # +12 padding   (4 bytes — union alignment)
            # +16 si_pid    (pid_t)
            # +20 si_uid    (uid_t)
            # +24 si_status (int)
            my $si_code   = unpack('i', substr($siginfo, 8, 4));
            my $si_status = unpack('i', substr($siginfo, 24, 4));
            if ($si_code == 1) {    # CLD_EXITED
                $exit_code = $si_status;
            } else {
                $exit_code = 128 + $si_status;
            }
            $got_init = 1;
        } else {
            warn "nacre-dbg: waitid failed wr=$wr errno=$!\n"
                if $ENV{NACRE_RUN_DEBUG};
        }
        POSIX::close($pidfd);
    } else {
        warn "nacre-dbg: pidfd_open failed pidfd=$pidfd errno=$!\n"
            if $ENV{NACRE_RUN_DEBUG};
    }

    # Fallback: waitpid with subreaper
    unless ($got_init) {
        while (1) {
            my $w = waitpid(-1, 0);
            if ($w == $init_pid) {
                if (WIFEXITED($?)) {
                    $exit_code = WEXITSTATUS($?);
                } elsif (WIFSIGNALED($?)) {
                    $exit_code = 128 + WTERMSIG($?);
                }
                $got_init = 1;
                last;
            }
            last if $w < 0 && $! != EINTR;
        }
    }

    # Last resort: poll with kill(0, pid)
    unless ($got_init) {
        while (kill(0, $init_pid)) {
            while ((my $z = waitpid(-1, WNOHANG)) > 0) {
                if ($z == $init_pid) {
                    if (WIFEXITED($?)) {
                        $exit_code = WEXITSTATUS($?);
                    } elsif (WIFSIGNALED($?)) {
                        $exit_code = 128 + WTERMSIG($?);
                    }
                    $got_init = 1;
                    last;
                }
            }
            last if $got_init;
            select(undef, undef, undef, 0.1);
        }
    }

    # Delete
    eval { cmd_delete(id => $id, root => $root, force => 1); };

    exit($exit_code);
}

# ═══════════════════════════════════════════════════════════════════════
# Container: list
# ═══════════════════════════════════════════════════════════════════════

sub cmd_list {
    my (%p) = @_;
    my $root   = $p{root}   // $DEFAULT_ROOT;
    my $format = $p{format} // 'table';
    my $quiet  = $p{quiet}  // 0;

    my @containers;
    if (opendir(my $dh, $root)) {
        while (my $id = readdir($dh)) {
            next if $id =~ /^\./;
            my $st = eval { load_state($root, $id) };
            next unless $st;
            push @containers, $st;
        }
        closedir($dh);
    } elsif ($p{root_explicit}) {
        # Explicit --root with non-existent directory is an error
        fatal("root directory '$root' does not exist");
    }
    # Default root that doesn't exist is fine — just show empty list

    if ($quiet) {
        print "$_->{id}\n" for @containers;
        return;
    }

    if ($format eq 'json') {
        print $JSON->encode([map { oci_state_json($_) } @containers]);
        return;
    }

    # Table format
    printf "%-20s %-10s %-10s %-10s %s\n", 'ID', 'PID', 'STATUS', 'CREATED', 'BUNDLE';
    for my $c (sort { $a->{id} cmp $b->{id} } @containers) {
        printf "%-20s %-10s %-10s %-10s %s\n",
            $c->{id}, $c->{pid}, $c->{status},
            substr($c->{created} // '', 0, 10),
            $c->{bundle} // '';
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container: pause / resume
# ═══════════════════════════════════════════════════════════════════════

sub cmd_pause {
    my (%p) = @_;
    my $id   = $p{id}   // fatal("container id required");
    my $root = $p{root} // $DEFAULT_ROOT;

    my $state = load_state($root, $id);
    fatal("container '$id' is not running") unless $state->{status} eq 'running';

    cg_write($state->{cgroupPath}, 'cgroup.freeze', '1');
    $state->{status} = 'paused';
    save_state($root, $state);
}

sub cmd_resume {
    my (%p) = @_;
    my $id   = $p{id}   // fatal("container id required");
    my $root = $p{root} // $DEFAULT_ROOT;

    my $state = load_state($root, $id);
    fatal("container '$id' is not paused") unless $state->{status} eq 'paused';

    cg_write($state->{cgroupPath}, 'cgroup.freeze', '0');
    $state->{status} = 'running';
    save_state($root, $state);
}

# ═══════════════════════════════════════════════════════════════════════
# Container: exec
# ═══════════════════════════════════════════════════════════════════════

sub cmd_exec {
    my (%p) = @_;
    my $id         = $p{id}         // fatal("container id required");
    my $root       = $p{root}       // $DEFAULT_ROOT;
    my @cmd        = @{$p{command}  // fatal("command required")};
    my $exec_cwd   = $p{cwd};
    my $exec_env   = $p{env};
    my $exec_user  = $p{user};
    log_debug("exec in container id=$id");

    my $state = load_state($root, $id);
    fatal("container '$id' is not running")
        unless $state->{status} eq 'running';

    my $init_pid = $state->{pid};
    my $spec = load_cached_spec($root, $id, $state->{bundle});

    # Open namespace fds
    my @ns_order = qw(user mnt uts ipc net pid cgroup);
    my @ns_fds;
    for my $ns (@ns_order) {
        my $path = "/proc/$init_pid/ns/$ns";
        if (sysopen(my $fd, $path, O_RDONLY)) {
            push @ns_fds, { name => $ns, fd => $fd, fileno => fileno($fd) };
        }
    }

    my $child = fork();
    fatal("fork for exec: $!") unless defined $child;

    if ($child == 0) {
        # Join namespaces
        for my $ns (@ns_fds) {
            my $nr  = SYS_setns + 0;
            my $fd  = $ns->{fileno} + 0;
            my $flg = 0;
            my $r;
            do { $r = syscall($nr, $fd, $flg) } while ($r == -1 && $! == EINTR);
            $r == 0 or warn "nacre: setns $ns->{name}: $!\n";
        }

        # chdir
        chdir($exec_cwd // $spec->{process}{cwd} // '/');

        # Set environment
        if ($exec_env) {
            for my $e (@$exec_env) {
                my ($k, $v) = split /=/, $e, 2;
                $ENV{$k} = $v;
            }
        }

        # Set user
        if ($exec_user) {
            if ($exec_user =~ /^(\d+)(?::(\d+))?$/) {
                POSIX::setgid($2) if defined $2;
                POSIX::setuid($1);
            }
        }

        { exec { $cmd[0] } @cmd };
        _exit(1);
    }

    # Close namespace fds in parent
    for my $ns (@ns_fds) { close $ns->{fd}; }

    # Wait for exec'd process
    waitpid($child, 0);
    if (WIFEXITED($?)) {
        exit(WEXITSTATUS($?));
    } elsif (WIFSIGNALED($?)) {
        exit(128 + WTERMSIG($?));
    }
    exit(1);
}

# ═══════════════════════════════════════════════════════════════════════
# Container: update (resource limits)
# ═══════════════════════════════════════════════════════════════════════

sub cmd_update {
    my (%p) = @_;
    my $id       = $p{id}        // fatal("container id required");
    my $root     = $p{root}      // $DEFAULT_ROOT;
    my $res_file = $p{resources};
    log_debug("update container id=$id");

    my $state = load_state($root, $id);
    fatal("container '$id' is not running or created or paused")
        unless $state->{status} =~ /^(running|created|paused)$/;

    my $cgpath = $state->{cgroupPath}
        // fatal("no cgroup path for container");

    my $resources;
    if ($res_file) {
        # Load resources from file or stdin
        my $res_json;
        if ($res_file ne '-') {
            $res_json = read_file_or_die($res_file);
        } else {
            local $/;
            $res_json = <STDIN>;
        }
        $resources = $JSON->decode($res_json);
    } else {
        # Build resources from CLI flags
        $resources = {};
        if (defined $p{pids_limit}) {
            $resources->{pids} = { limit => $p{pids_limit} };
        }
        my %cpu;
        $cpu{shares} = $p{cpu_share}   if defined $p{cpu_share};
        $cpu{quota}  = $p{cpu_quota}   if defined $p{cpu_quota};
        $cpu{period} = $p{cpu_period}  if defined $p{cpu_period};
        $cpu{burst}  = $p{cpu_burst}   if defined $p{cpu_burst};
        $cpu{idle}   = $p{cpu_idle}    if defined $p{cpu_idle};
        $cpu{cpus}   = $p{cpuset_cpus} if defined $p{cpuset_cpus};
        $cpu{mems}   = $p{cpuset_mems} if defined $p{cpuset_mems};
        $resources->{cpu} = \%cpu if %cpu;
        my %mem;
        $mem{limit}       = $p{memory}             if defined $p{memory};
        $mem{swap}        = $p{memory_swap}        if defined $p{memory_swap};
        $mem{reservation} = $p{memory_reservation} if defined $p{memory_reservation};
        $resources->{memory} = \%mem if %mem;
    }

    # Build a fake spec with just the resources
    my $fake_spec = { linux => { resources => $resources } };
    cgroup_apply_resources($cgpath, $fake_spec);

    # Update device cgroup rules if present
    if ($resources->{devices}) {
        apply_device_cgroup($cgpath, $fake_spec);
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container: events (stats)
# ═══════════════════════════════════════════════════════════════════════

sub cmd_events {
    my (%p) = @_;
    my $id       = $p{id}       // fatal("container id required");
    my $root     = $p{root}     // $DEFAULT_ROOT;
    # Parse Go-style duration: "100ms", "1s", "5s", or plain number (seconds)
    my $interval_raw = $p{interval} // '5s';
    my $interval;
    if ($interval_raw =~ /^(\d+(?:\.\d+)?)ms$/i) {
        $interval = $1 / 1000.0;
    } elsif ($interval_raw =~ /^(\d+(?:\.\d+)?)s$/i) {
        $interval = $1 + 0;
    } elsif ($interval_raw =~ /^(\d+(?:\.\d+)?)m$/i) {
        $interval = $1 * 60;
    } elsif ($interval_raw =~ /^(\d+(?:\.\d+)?)$/) {
        $interval = $1 + 0;
    } else {
        $interval = 5;
    }
    my $stats    = $p{stats};

    my $state = load_state($root, $id);
    my $cgpath = $state->{cgroupPath} // fatal("no cgroup path");

    my $print_stats = sub {
        my %s;
        $s{pids}{current} = scalar(cgroup_pids($cgpath));
        my $pids_max = read_file("$cgpath/pids.max") // 'max';
        chomp $pids_max;
        $s{pids}{limit} = ($pids_max =~ /^\d+$/) ? int($pids_max) : 0;

        my $mem_current = read_file("$cgpath/memory.current") // '0';
        chomp $mem_current;
        $s{memory}{usage} = ($mem_current =~ /^\d+$/) ? int($mem_current) : 0;
        my $mem_max = read_file("$cgpath/memory.max") // 'max';
        chomp $mem_max;
        $s{memory}{limit} = ($mem_max =~ /^\d+$/) ? int($mem_max) : 0;

        my $cpu_stat = read_file("$cgpath/cpu.stat") // '';
        for my $line (split /\n/, $cpu_stat) {
            my ($k, $v) = split /\s+/, $line;
            $s{cpu}{$k} = int($v) if defined $v;
        }

        # OOM events
        my $events = read_file("$cgpath/memory.events") // '';
        for my $line (split /\n/, $events) {
            my ($k, $v) = split /\s+/, $line;
            $s{memory}{$k} = int($v) if defined $v;
        }

        # PSI (pressure stall information) - io, cpu, memory
        for my $psi_type (qw(cpu io memory)) {
            my $psi_data = read_file("$cgpath/$psi_type.pressure");
            if (defined $psi_data) {
                for my $line (split /\n/, $psi_data) {
                    # Format: some avg10=0.00 avg60=0.00 avg300=0.00 total=0
                    #         full avg10=0.00 avg60=0.00 avg300=0.00 total=0
                    if ($line =~ /^(some|full)\s+(.*)/) {
                        my ($level, $rest) = ($1, $2);
                        my %vals;
                        while ($rest =~ /(\w+)=([0-9.]+)/g) {
                            my ($k, $v) = ($1, $2);
                            $vals{$k} = ($k eq 'total') ? int($v) : $v + 0.0;
                        }
                        $s{$psi_type . '_pressure'}{$level} = \%vals;
                    }
                }
            }
        }

        # Build JSON with runc-compatible field order (type, id, data)
        printf qq({"type":"stats","id":%s,"data":%s}\n),
            $JSON_COMPACT->encode($id),
            $JSON_COMPACT->encode(\%s);
    };

    if ($stats) {
        $print_stats->();
        return;
    }

    while (1) {
        $print_stats->();
        # Use select for sub-second sleep
        if ($interval < 1) {
            select(undef, undef, undef, $interval);
        } else {
            sleep int($interval);
        }
        # Refresh state to check if still alive
        $state = eval { load_state($root, $id) };
        last unless $state;
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Container: ps
# ═══════════════════════════════════════════════════════════════════════

sub cmd_ps {
    my (%p) = @_;
    my $id       = $p{id}      // fatal("container id required");
    my $root     = $p{root}    // $DEFAULT_ROOT;
    my $format   = $p{format}  // 'table';
    my @ps_args  = @{$p{ps_args} // ['-ef']};

    my $state = load_state($root, $id);
    my $cgpath = $state->{cgroupPath} // fatal("no cgroup path");

    my @pids = cgroup_pids($cgpath);

    if ($format eq 'json') {
        print $JSON->encode(\@pids);
        return;
    }

    # Run ps and filter to only our PIDs
    my %our_pids = map { $_ => 1 } @pids;
    open my $ps, '-|', 'ps', @ps_args or fatal("ps: $!");
    my $header = <$ps>;
    print $header if $header;
    while (<$ps>) {
        # Find PID in the line
        if (/^\s*\S+\s+(\d+)/ || /^\s*(\d+)/) {
            print if $our_pids{$1};
        }
    }
    close $ps;
}

# ═══════════════════════════════════════════════════════════════════════
# Container: spec (generate default config.json)
# ═══════════════════════════════════════════════════════════════════════

sub cmd_spec {
    my (%p) = @_;
    my $bundle = $p{bundle} // '.';
    my $path = "$bundle/config.json";

    if (-e $path && !$p{force}) {
        fatal("$path already exists. Use --force to overwrite.");
    }

    write_file($path, $JSON->encode(default_spec()));
    print "Generated $path\n" unless $p{quiet};
}

# ═══════════════════════════════════════════════════════════════════════
# Container: features
# ═══════════════════════════════════════════════════════════════════════

sub cmd_features {
    my $features = {
        ociVersionMin => '1.0.0',
        ociVersionMax => '1.2.0',
        hooks => [qw(prestart createRuntime createContainer startContainer poststart poststop)],
        mountOptions => [sort keys %MOUNT_FLAGS],
        linux => {
            namespaces => [sort keys %NS_MAP],
            capabilities => [@CAP_NAMES],
            cgroup => {
                v2 => JSON::PP::true,
            },
            seccomp => {
                enabled => JSON::PP::true,
                actions => [qw(SCMP_ACT_KILL SCMP_ACT_KILL_PROCESS SCMP_ACT_TRAP
                              SCMP_ACT_ERRNO SCMP_ACT_LOG SCMP_ACT_ALLOW)],
                operators => [qw(SCMP_CMP_NE SCMP_CMP_LT SCMP_CMP_LE
                                SCMP_CMP_EQ SCMP_CMP_GE SCMP_CMP_GT
                                SCMP_CMP_MASKED_EQ)],
            },
            apparmor => { enabled => JSON::PP::false },
            selinux  => { enabled => JSON::PP::false },
        },
        annotations => {
            'org.opencontainers.runtime.nacre' => 'Perl OCI runtime',
        },
    };
    print $JSON->encode($features);
}

# ═══════════════════════════════════════════════════════════════════════
# CLI Argument Parsing and Dispatch
# ═══════════════════════════════════════════════════════════════════════

sub main {
    my $root = $DEFAULT_ROOT;
    my $root_explicit = 0;
    my $log_level = 'warn';
    my $log_format = 'text';
    my $debug = 0;
    my $systemd_cgroup = 0;

    # Parse global options (before command)
    Getopt::Long::Configure('pass_through', 'no_auto_abbrev');
    GetOptions(
        'root=s'           => sub { $root = $_[1]; $root_explicit = 1; },
        'log=s'            => \my $log_file,
        'log-format=s'     => \$log_format,
        'debug'            => \$debug,
        'systemd-cgroup'   => \$systemd_cgroup,
    );

    # Initialize logging subsystem
    setup_logging(
        debug    => $debug,
        log_file => $log_file,
        format   => $log_format,
    );

    my $command = shift @ARGV // usage();

    log_debug("nacre starting, command=$command root=$root");

    # Handle `<command> -h` / `<command> --help` for any subcommand (runc compat)
    if ($command !~ /^-/ && $command ne 'help'
        && grep { $_ eq '-h' || $_ eq '--help' } @ARGV) {
        print "NAME:\n   runc $command\n\nUSAGE:\n   runc $command [options]\n";
        exit(0);
    }

    if ($command eq 'create') {
        my ($bundle, $pid_file, $console_socket, $no_pivot);
        GetOptions(
            'bundle|b=s'         => \$bundle,
            'pid-file=s'         => \$pid_file,
            'console-socket=s'   => \$console_socket,
            'no-pivot'           => \$no_pivot,
        );
        my $id = shift @ARGV // fatal("container id required");
        cmd_create(id => $id, bundle => $bundle, root => $root,
                   pid_file => $pid_file, console_socket => $console_socket,
                   no_pivot => $no_pivot);
    }
    elsif ($command eq 'start') {
        my $id = shift @ARGV // fatal("container id required");
        cmd_start(id => $id, root => $root);
    }
    elsif ($command eq 'state') {
        my $id = shift @ARGV // fatal("container id required");
        cmd_state(id => $id, root => $root);
    }
    elsif ($command eq 'kill') {
        my $all = 0;
        GetOptions('all|a' => \$all);
        my $id = shift @ARGV // fatal("container id required");
        my $signal = shift @ARGV // 'TERM';
        cmd_kill(id => $id, root => $root, signal => $signal, all => $all);
    }
    elsif ($command eq 'delete') {
        my $force = 0;
        GetOptions('force|f' => \$force);
        my $id = shift @ARGV // fatal("container id required");
        cmd_delete(id => $id, root => $root, force => $force);
    }
    elsif ($command eq 'run') {
        my ($bundle, $pid_file, $console_socket, $no_pivot, $detach);
        GetOptions(
            'bundle|b=s'         => \$bundle,
            'pid-file=s'         => \$pid_file,
            'console-socket=s'   => \$console_socket,
            'no-pivot'           => \$no_pivot,
            'detach|d'           => \$detach,
        );
        my $id = shift @ARGV // fatal("container id required");
        cmd_run(id => $id, bundle => $bundle, root => $root,
                pid_file => $pid_file, console_socket => $console_socket,
                detach => $detach, no_pivot => $no_pivot);
    }
    elsif ($command eq 'list') {
        my ($format, $quiet);
        GetOptions(
            'format|f=s' => \$format,
            'quiet|q'    => \$quiet,
        );
        cmd_list(root => $root, format => $format, quiet => $quiet,
                 root_explicit => $root_explicit);
    }
    elsif ($command eq 'pause') {
        my $id = shift @ARGV // fatal("container id required");
        cmd_pause(id => $id, root => $root);
    }
    elsif ($command eq 'resume') {
        my $id = shift @ARGV // fatal("container id required");
        cmd_resume(id => $id, root => $root);
    }
    elsif ($command eq 'exec') {
        my ($exec_cwd, @exec_env, $exec_user, $detach, $pid_file,
            $console_socket, $tty, $process_file);
        # Separate exec args: everything after "--" or after container id
        my @before;
        my @exec_cmd;
        my $found_sep = 0;
        for my $arg (@ARGV) {
            if ($arg eq '--' && !$found_sep) {
                $found_sep = 1;
                next;
            }
            if ($found_sep) {
                push @exec_cmd, $arg;
            } else {
                push @before, $arg;
            }
        }
        @ARGV = @before;
        GetOptions(
            'cwd=s'             => \$exec_cwd,
            'env|e=s'           => \@exec_env,
            'user|u=s'          => \$exec_user,
            'detach|d'          => \$detach,
            'pid-file=s'        => \$pid_file,
            'console-socket=s'  => \$console_socket,
            'tty|t'             => \$tty,
            'process|p=s'       => \$process_file,
        );
        my $id = shift @ARGV // fatal("container id required");
        @exec_cmd = @ARGV unless @exec_cmd;
        fatal("command required for exec") unless @exec_cmd;
        cmd_exec(id => $id, root => $root, command => \@exec_cmd,
                 cwd => $exec_cwd, env => \@exec_env, user => $exec_user);
    }
    elsif ($command eq 'update') {
        my ($resources, $pids_limit, $cpu_period, $cpu_quota, $cpu_share,
            $cpu_burst, $memory, $memory_swap, $memory_reservation,
            $cpuset_cpus, $cpuset_mems, $cpu_idle);
        GetOptions(
            'resources|r=s'       => \$resources,
            'pids-limit=i'        => \$pids_limit,
            'cpu-period=i'        => \$cpu_period,
            'cpu-quota=i'         => \$cpu_quota,
            'cpu-share=i'         => \$cpu_share,
            'cpu-burst=i'         => \$cpu_burst,
            'memory=i'            => \$memory,
            'memory-swap=i'       => \$memory_swap,
            'memory-reservation=i' => \$memory_reservation,
            'cpuset-cpus=s'       => \$cpuset_cpus,
            'cpuset-mems=s'       => \$cpuset_mems,
            'cpu-idle=i'          => \$cpu_idle,
        );
        my $id = shift @ARGV // fatal("container id required");
        cmd_update(id => $id, root => $root, resources => $resources,
                   pids_limit => $pids_limit, cpu_period => $cpu_period,
                   cpu_quota => $cpu_quota, cpu_share => $cpu_share,
                   cpu_burst => $cpu_burst, memory => $memory,
                   memory_swap => $memory_swap,
                   memory_reservation => $memory_reservation,
                   cpuset_cpus => $cpuset_cpus, cpuset_mems => $cpuset_mems,
                   cpu_idle => $cpu_idle);
    }
    elsif ($command eq 'events') {
        my ($interval, $stats);
        GetOptions(
            'interval|i=s' => \$interval,
            'stats'        => \$stats,
        );
        my $id = shift @ARGV // fatal("container id required");
        cmd_events(id => $id, root => $root, interval => $interval, stats => $stats);
    }
    elsif ($command eq 'ps') {
        my $format;
        GetOptions('format|f=s' => \$format);
        my $id = shift @ARGV // fatal("container id required");
        cmd_ps(id => $id, root => $root, format => $format, ps_args => \@ARGV);
    }
    elsif ($command eq 'spec') {
        my ($bundle, $force);
        GetOptions(
            'bundle|b=s' => \$bundle,
            'force'      => \$force,
        );
        cmd_spec(bundle => $bundle, force => $force);
    }
    elsif ($command eq 'features') {
        cmd_features();
    }
    elsif ($command eq '--help' || $command eq '-h' || $command eq 'help') {
        usage();
    }
    elsif ($command eq '--version' || $command eq '-v' || $command eq 'version') {
        use Config;
        # runc-compatible format for interoperability
        print "runc version 1.2.0-nacre\n";
        print "commit: nacre-0.5.1\n";
        print "spec: 1.2.0\n";
        print "go: n/a (perl $Config{archname})\n";
    }
    else {
        # Handle `<command> -h` for any command (runc compat)
        if (@ARGV && ($ARGV[0] eq '-h' || $ARGV[0] eq '--help')) {
            print "NAME:\n   runc $command\n\nUSAGE:\n   runc $command [options]\n";
            exit(0);
        }
        fatal("unknown command: $command");
    }
}

sub usage {
    print <<'USAGE';
NAME:
   runc - Open Container Initiative runtime (nacre)

USAGE:
   runc [global options] command [command options] [arguments...]

COMMANDS:
     checkpoint  checkpoint a running container (not supported)
     create      create a container
     delete      delete any resources held by the container
     events      display container events such as OOM notifications, cpu, memory, and IO usage statistics
     exec        execute new process inside the container
     kill        kill sends the specified signal to the container's init process
     list        lists containers started by runc with the given root
     pause       pause suspends all processes inside the container
     ps          ps displays the processes running inside a container
     restore     restore a container from a previous checkpoint (not supported)
     resume      resumes all processes that have been previously paused
     run         create and run a container
     spec        create a new specification file
     start       executes the user defined process in a created container
     state       output the state of a container
     update      update container resource constraints
     features    show the enabled features

GLOBAL OPTIONS:
   --debug             enable debug output for logging
   --log value         set the log file path where internal debug information is written
   --log-format value  set the format used by logs ('text' (default), or 'json') (default: "text")
   --root value        root directory for storage of container state (default: "/run/nacre")
   --help, -h          show help
   --version, -v       print the version
USAGE
    exit(0);
}

# Run
main();
